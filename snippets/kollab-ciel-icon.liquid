{%- liquid
assign k = name | downcase
assign pick = 'generic'
if k contains 'pixalia'
  assign pick = 'plant'
elsif k contains 'niacinamide'
  assign pick = 'b3'
elsif k contains 'centella'
  assign pick = 'leaf'
elsif k contains 'houttuynia'
  assign pick = 'heart'
elsif k contains 'panthenol'
  assign pick = 'b5'
elsif k contains 'polyglutamic'
  assign pick = 'chain'
elsif k contains 'oil' or k contains 'squalane'
  assign pick = 'drop'
elsif k contains 'powder' or k contains 'seed'
  assign pick = 'seed'
elsif k contains 'ceramide' or k contains 'peptide'
  assign pick = 'wall'
elsif k contains 'pha' or k contains 'acid' or k contains 'gluconolactone'
  assign pick = 'ring'
elsif k contains 'ubiquinone' or k contains 'coq10' or k contains 'jelly'
  assign pick = 'spark'
elsif k contains 'rice' or k contains 'mugwort' or k contains 'balm' or k contains 'moringa' or k contains 'extract'
  assign pick = 'leaf'
elsif k contains 'amino'
  assign pick = 'chain'
endif
-%}
{%- case pick -%}
