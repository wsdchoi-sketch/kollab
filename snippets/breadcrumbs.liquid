{% comment %}
	{% assign template_base = template | split: '.' | first %}

	{% unless template_base == 'index'
		or template_base == 'article'
		or template_base == 'page.contact'
		or template_base == 'product'
		or template_base == 'customers/login'
	%}
		{% assign curent_url = request.path | lstrip | truncate: 12 %}
		{% if curent_url == '/policies...' %}
			{% assign container = 'shopify-policy__container' %}
		{% else %}
			{% assign container = 'container' %}
		{% endif %}

		<div class="{{ container }}">
			<nav
				class="breadcrumb breadcrumb_margin"
				role="navigation"
				aria-label="breadcrumbs"
			>
				<a
					href="{{ routes.root_url }}"
					title="{{ 'general.breadcrumbs.home' | t }}"
					class="breadcrumb__link"
				>
					<span>{{ 'general.breadcrumbs.home' | t }} </span>
				</a>
				{% if template contains 'page' %}
					<div class="breadcrumb__delimiter"></div>
					<div>{{ page.title }}</div>
				{% elsif template contains 'product' %}
					<div class="breadcrumb__delimiter"></div>
					{% if product.collections[0] %}
						<span
							><a href="{{ product.collections[0].url }}">
								{{- product.collections[0].title }}
							</a></span
						>
						<div class="breadcrumb__delimiter"></div>
					{% endif %}
					<div>{{ product.title }}</div>
				{% elsif template contains 'collection' and collection.handle %}
					<div class="breadcrumb__delimiter"></div>
					{% if current_tags %}
						{% capture url %}/collections/{{ collection.handle }}
	          {% endcapture %}
						{{ collection.title | link_to: url }}
						<div class="breadcrumb__delimiter"></div>
						<span>{{ current_tags | join: ' + ' }} </span>
					{% endif %}
					<div>{{ collection.title }}</div>
				{% elsif template == 'blog' %}
					<div class="breadcrumb__delimiter"></div>
					{% if current_tags %}
						<span>{{ blog.title | link_to: blog.url }}</span>
						<div class="breadcrumb__delimiter"></div>
						<div>{{ current_tags | join: ' + ' }}</div>
					{% else %}
						<div>{{ blog.title }}</div>
					{% endif %}
				{% elsif template == 'customers/order' %}
					<div class="breadcrumb__delimiter"></div>
					<span
						><a href="{{ routes.account_url }}">
							{{- 'customer.account.title' | t }}
						</a></span
					>
					<div class="breadcrumb__delimiter"></div>
					<div>{{ order.name }}</div>
				{% elsif template == 'customers/addresses' %}
					<div class="breadcrumb__delimiter"></div>
					<span
						><a href="{{ routes.account_url }}">
							{{- 'customer.account.title' | t }}
						</a></span
					>
					<div class="breadcrumb__delimiter"></div>
					<div>{{ 'customer.addresses.title' | t }}</div>
				{% else %}
					<div class="breadcrumb__delimiter"></div>
					<div>{{ page_title }}</div>
				{% endif %}
			</nav>
		</div>
	{% endunless %}
{% endcomment %}
{% assign template_base = template | split: '.' | first %}

{% unless template_base == 'index'
	or template_base == 'article'
	or template_base == 'customers/login'
	or template_base == 'customers/register'
	or template_base == 'product'
	or template_base == 'page.contact'
%}
	{% assign curent_url = request.path | lstrip | truncate: 12 %}
	{% if curent_url == '/policies...' %}
		{% assign container = 'container' %}
	{% elsif container == false %}
		{% assign container = '' %}
	{% else %}
		{% assign container = 'container' %}
	{% endif %}

	{%- comment -%} Build BreadcrumbList structured data alongside the visual nav {%- endcomment -%}
	{%- liquid
		assign crumb_names = ''
		assign crumb_urls = ''
		assign crumb_names = crumb_names | append: 'Home' | append: '||'
		assign crumb_urls = crumb_urls | append: shop.url | append: routes.root_url | append: '||'

		if template contains 'page'
			assign crumb_names = crumb_names | append: page.title | append: '||'
			assign crumb_urls = crumb_urls | append: shop.url | append: page.url | append: '||'
		elsif template contains 'collection' and collection.handle
			if current_tags
				assign crumb_names = crumb_names | append: collection.title | append: '||'
				assign crumb_urls = crumb_urls | append: shop.url | append: collection.url | append: '||'
				assign crumb_names = crumb_names | append: current_tags | join: ' + ' | append: '||'
				assign crumb_urls = crumb_urls | append: shop.url | append: request.path | append: '||'
			else
				assign crumb_names = crumb_names | append: collection.title | append: '||'
				assign crumb_urls = crumb_urls | append: shop.url | append: collection.url | append: '||'
			endif
		elsif template == 'blog'
			if current_tags
				assign crumb_names = crumb_names | append: blog.title | append: '||'
				assign crumb_urls = crumb_urls | append: shop.url | append: blog.url | append: '||'
				assign crumb_names = crumb_names | append: current_tags | join: ' + ' | append: '||'
				assign crumb_urls = crumb_urls | append: shop.url | append: request.path | append: '||'
			else
				assign crumb_names = crumb_names | append: blog.title | append: '||'
				assign crumb_urls = crumb_urls | append: shop.url | append: blog.url | append: '||'
			endif
		elsif template == 'customers/order'
			assign crumb_names = crumb_names | append: 'Account' | append: '||'
			assign crumb_urls = crumb_urls | append: shop.url | append: routes.account_url | append: '||'
			assign crumb_names = crumb_names | append: order.name | append: '||'
			assign crumb_urls = crumb_urls | append: shop.url | append: request.path | append: '||'
		elsif template == 'customers/addresses'
			assign crumb_names = crumb_names | append: 'Account' | append: '||'
			assign crumb_urls = crumb_urls | append: shop.url | append: routes.account_url | append: '||'
		else
			assign crumb_names = crumb_names | append: page_title | append: '||'
			assign crumb_urls = crumb_urls | append: shop.url | append: request.path | append: '||'
		endif

		assign crumb_name_list = crumb_names | split: '||'
		assign crumb_url_list = crumb_urls | split: '||'
	-%}

	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		"itemListElement": [
			{%- for crumb_name in crumb_name_list -%}
				{
					"@type": "ListItem",
					"position": {{ forloop.index }},
					"name": {{ crumb_name | strip | json }},
					"item": {{ crumb_url_list[forloop.index0] | strip | json }}
				}{%- unless forloop.last -%},{%- endunless -%}
			{%- endfor -%}
		]
	}
	</script>

	<div class="breadcrumb_margin">
		<div class="{{ container }}">
			<nav
				class="breadcrumb small-font"
				role="navigation"
				aria-label="breadcrumbs"
			>
				<a
					href="{{ routes.root_url }}"
					title="{{ 'general.breadcrumbs.home' | t }}"
					class="breadcrumb__link"
				>
					<span>{{ 'general.breadcrumbs.home' | t }} </span>
				</a>
				{% if template contains 'page' %}
					{% comment %}<div class="breadcrumb__delimiter"></div>{% endcomment %}
					<div>{{ page.title }}</div>
				{% elsif template contains 'product' %}
					{% comment %}<div class="breadcrumb__delimiter"></div>{% endcomment %}
					{% if product.collections[0] %}
						<span
							><a href="{{ product.collections[0].url }}">
								{{- product.collections[0].title }}
							</a></span
						>
						{% comment %}<div class="breadcrumb__delimiter"></div>{% endcomment %}
					{% endif %}
					<div>{{ product.title }}</div>
				{% elsif template contains 'collection' and collection.handle %}
					{% comment %}<div class="breadcrumb__delimiter"></div>{% endcomment %}
					{% if current_tags %}
						{% capture url %}/collections/{{ collection.handle }}
						{% endcapture %}
						{{ collection.title | link_to: url }}
						{% comment %}<div class="breadcrumb__delimiter"></div>{% endcomment %}
						<span>{{ current_tags | join: ' + ' }} </span>
					{% endif %}
					<div>{{ collection.title }}</div>
				{% elsif template == 'blog' %}
					{% comment %}<div class="breadcrumb__delimiter"></div>{% endcomment %}
					{% if current_tags %}
						<span>{{ blog.title | link_to: blog.url }}</span>
						{% comment %}<div class="breadcrumb__delimiter"></div>{% endcomment %}
						<div>{{ current_tags | join: ' + ' }}</div>
					{% else %}
						<div>{{ blog.title }}</div>
					{% endif %}
				{% elsif template == 'customers/order' %}
					{% comment %}<div class="breadcrumb__delimiter"></div>{% endcomment %}
					<span
						><a href="{{ routes.account_url }}">
							{{- 'customer.account.title' | t }}
						</a></span
					>
					{% comment %}<div class="breadcrumb__delimiter"></div>{% endcomment %}
					<div>{{ order.name }}</div>
				{% elsif template == 'customers/addresses' %}
					{% comment %}<div class="breadcrumb__delimiter"></div>{% endcomment %}
					<span
						><a href="{{ routes.account_url }}">
							{{- 'customer.account.title' | t }}
						</a></span
					>
					{% comment %}<div class="breadcrumb__delimiter"></div>{% endcomment %}
					<div>{{ 'customer.addresses.title' | t }}</div>
				{% else %}
					{% comment %}<div class="breadcrumb__delimiter"></div>{% endcomment %}
					<div>{{ page_title }}</div>
				{% endif %}
			</nav>
		</div>
	</div>
{% endunless %}
