<style>
.kmz .news{background:var(--red);color:#fff;padding:80px 0;position:relative}
.kmz .news .grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
@media(max-width:860px){.kmz .news .grid{grid-template-columns:1fr;gap:32px}.kmz .news{padding:60px 0}}
.kmz .news h2{font-size:clamp(34px,4.4vw,56px);line-height:1;margin:0;color:#fff}
.kmz .news .nsub{margin:16px 0 0;font-size:17px;color:rgba(255,255,255,.9)}
.kmz .news form{display:grid;grid-template-columns:1fr auto;border-bottom:1px solid #fff;gap:10px}
.kmz .news input[type=email]{background:none;border:0;color:#fff;font-family:inherit;font-size:15px;padding:16px 0;outline:none;box-shadow:none;border-radius:0;width:100%;min-width:0}
.kmz .news input[type=email]::placeholder{color:rgba(255,255,255,.75)}
.kmz .news button{background:none;border:0;color:#fff;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;padding:0 4px;cursor:pointer}
.kmz .news button:hover{color:var(--black)}
.kmz .news .fine{font-size:12px;color:rgba(255,255,255,.85);margin:12px 0 0}
.kmz .news .hand{font-weight:700;font-size:clamp(21px,1.7vw,25px);line-height:1.1;color:#fff;margin:18px 0 0}
.kmz .news .hand span{display:block}
.kmz .news .ok{font-size:26px;color:#fff;margin:12px 0 0}
.kmz .news .err{font-size:13px;color:#fff;font-weight:700;margin:12px 0 0}
.kmz .news .stk-news{position:absolute;width:170px;left:50%;transform:translateX(-50%);top:-54px;pointer-events:none;filter:drop-shadow(0 6px 10px rgba(0,0,0,.18))}
.kmz .news .stk-news img{width:100%;height:auto;animation:km-spin360 18s linear infinite}
@media(max-width:860px){.kmz .news .stk-news{width:130px;top:-40px}}
</style>
<section class="news" id="km-newsletter">{%- if sticker_patch != blank -%}<div class="stk-news"><img src="{{ sticker_patch | image_url: width: 400 }}" alt="" loading="lazy"></div>{%- endif -%}<div class="wrap"><div class="grid">
<div>
<div class="kicker" style="color:#fff"><svg class="kstar" aria-hidden="true"><use href="#km-star" fill="url(#km-ch)"/></svg>Email newsletter</div>
<h2 style="margin-top:14px"><span class="sent">A little inspiration,</span><span class="sent i">never too much.</span></h2>
<p class="nsub">New drops, pop-up dates and creator picks.</p>
</div>
<div>
{%- form 'customer', id: 'km-news-form', novalidate: 'novalidate' -%}
<input type="hidden" name="contact[tags]" value="newsletter">
<input type="email" name="contact[email]" id="km-news-email" placeholder="your@email.com" autocomplete="email" aria-label="Email address" required value="{{ form.email }}">
<button type="submit">Subscribe</button>
{%- if form.posted_successfully? -%}<p class="ok serif" role="status" style="grid-column:1/-1">You're in. Keep an eye on your inbox.</p>{%- endif -%}
{%- endform -%}
<p class="fine">By subscribing, you agree to our terms &amp; conditions.</p>
<p class="hand"><span>Fair warning: our emails come with surprises.</span><span>Gifts, giveaways, first dibs on events.</span><span>Don't say we didn't warn you ☺</span></p>
{%- if form.errors -%}<p class="err" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
</div>
</div></div></section>