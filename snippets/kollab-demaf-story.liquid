h84M8 67h84" stroke="#E3001B" stroke-width="3" stroke-linecap="round"/>{%- when 5 -%}<circle cx="50" cy="56" r="30" fill="url(#kd-lav)" stroke="#0A0A0A" stroke-width="2.5"/><path d="M50 12c8 11 13 18 13 25a13 13 0 0 1-26 0c0-7 5-14 13-25z" fill="#fff" stroke="#0A0A0A" stroke-width="2.5"/><path d="M36 60a14 14 0 0 0 14 14" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"/>{%- endcase -%}</svg></div><div class="tx"><div class="nm">{{ nm }}</div></div></div>{%- endif -%}{%- endfor -%}</div>
</section></div>
