{%- if s.pola_2 != blank -%}<div class="pola b"><img src="{{ s.pola_2 | image_url: width: 700 }}" alt="{{ s.pola_2.alt | default: 'KOLLAB x De:maf workshop' | escape }}" loading="lazy"><span class="cap">{{ s.pola_2_cap }}</span></div>{%- endif -%}
</div>
</div>
</div></section>
