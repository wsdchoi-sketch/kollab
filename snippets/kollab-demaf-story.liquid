t="26" rx="3"/><rect x="367" y="182" width="62" height="26" rx="3"/><rect x="4" y="212" width="62" height="26" rx="3"/><rect x="70" y="212" width="62" height="26" rx="3"/><rect x="136" y="212" width="62" height="26" rx="3"/><rect x="202" y="212" width="62" height="26" rx="3"/><rect x="268" y="212" width="62" height="26" rx="3"/><rect x="334" y="212" width="62" height="26" rx="3"/><rect x="400" y="212" width="62" height="26" rx="3"/><rect x="-29" y="242" width="62" height="26" rx="3"/><rect x="37" y="242" width="62" height="26" rx="3"/><rect x="103" y="242" width="62" height="26" rx="3"/><rect x="169" y="242" width="62" height="26" rx="3"/><rect x="235" y="242" width="62" height="26" rx="3"/><rect x="301" y="242" width="62" height="26" rx="3"/><rect x="367" y="242" width="62" height="26" rx="3"/><rect x="4" y="272" width="62" height="26" rx="3"/><rect x="70" y="272" width="62" height="26" rx="3"/><rect x="136" y="272" width="62" height="26" rx="3"/><rect x="202" y="272" width="62" height="26" rx="3"/><rect x="268" y="272" width="62" height="26" rx="3"/><rect x="334" y="272" width="62" height="26" rx="3"/><rect x="400" y="272" width="62" height="26" rx="3"/><rect x="-29" y="302" width="62" height="26" rx="3"/><rect x="37" y="302" width="62" height="26" rx="3"/><rect x="103" y="302" width="62" height="26" rx="3"/><rect x="169" y="302" width="62" height="26" rx="3"/><rect x="235" y="302" width="62" height="26" rx="3"/><rect x="301" y="302" width="62" height="26" rx="3"/><rect x="367" y="302" width="62" height="26" rx="3"/></g><g id="kd-cracks" fill="none" stroke="#0A0A0A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M70 152 l10 18 -8 14 12 20"/><path d="M188 182 l-6 16 10 12 -4 18"/><path d="M300 210 l12 14 -10 18 8 16"/><path d="M120 242 l-8 14 12 16"/><path d="M250 272 l10 12 -6 14"/><path d="M340 152 l-10 16 8 14"/></g></g><g id="kd-steam"></g></g><rect x="0" y="318" width="400" height="82" fill="#E9C4B0" opacity=".18"/><text x="200" y="337" text-anchor="middle" font-family="Enkel,Arial" font-size="11" font-weight="700" letter-spacing="2" fill="rgba(255,255,255,.55)" id="kd-wlbl">WATER ESCAPING THROUGH THE CRACKS</text></svg><span class="tag2">Barrier strength</span><span class="pct" id="kd-wpct">0%</span><span class="tapme" id="kd-wtap">Tap to add a drop</span></div>
