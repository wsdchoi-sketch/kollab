<div class="wrap">
<section class="sec" id="km-demo">
  <div class="kicker"><svg class="kstar" aria-hidden="true"><use href="#km-star" fill="#E3001B"/></svg>{{ steps_kicker }}</div>
  <h2 class="big serif">{{ steps_title }} <span class="i">{{ steps_title_i }}</span></h2>
  <p class="lead lead2"><span class="sent">{{ steps_line_1 }}</span><span class="sent">{{ steps_line_2 }}</span></p>
  <div class="rule"></div>
  <div class="demo">
    <div class="tank" id="km-tank">
      <svg class="scene" viewBox="0 0 400 500" aria-hidden="true">
  <g id="km-gFinger">
    <path d="M128 520V215C128 140 272 140 272 215V520Z" fill="#E9C4B0"/>
    <defs><linearGradient id="natg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FBF1EE"/><stop offset=".32" stop-color="#F6D6D1"/><stop offset="1" stop-color="#F3CBC6"/></linearGradient></defs>
    <path id="km-nat" d="M150 335V172C150 128 250 128 250 172V335Q200 352 150 335Z" fill="url(#natg)" stroke="#D9A49C" stroke-width="2"/>
    <g id="km-res"><ellipse cx="178" cy="240" rx="14" ry="8" fill="#9a8c86" opacity=".6"/><ellipse cx="216" cy="282" rx="11" ry="6" fill="#9a8c86" opacity=".6"/><ellipse cx="226" cy="222" rx="8" ry="5" fill="#9a8c86" opacity=".6"/></g>
    <g id="km-fit" opacity="0"><path d="M155 335V215C155 170 245 170 245 215V335" fill="none" stroke="#E3001B" stroke-width="2.5" stroke-dasharray="6 5"/></g>
  </g>
  <g id="km-pad" opacity="0"><rect x="-58" y="-34" width="116" height="68" rx="14" fill="#fff" stroke="#0A0A0A" stroke-width="2"/><rect x="-40" y="-16" width="80" height="32" rx="6" fill="none" stroke="#bbb" stroke-dasharray="3 3"/><circle cx="34" cy="-18" r="5" fill="#E3001B"/></g>
  <g id="km-file" opacity="0"><rect x="-90" y="-11" width="180" height="22" rx="7" fill="#8f8f8f" stroke="#0A0A0A" stroke-width="2"/><path d="M-70 0h140" stroke="#c9c9c9" stroke-width="2" stroke-dasharray="2 4"/></g>
  <g id="km-dust" opacity="0"><circle cx="150" cy="130" r="2.5" fill="#fff"/><circle cx="250" cy="126" r="2" fill="#fff"/><circle cx="135" cy="112" r="1.6" fill="#fff"/><circle cx="268" cy="108" r="2.2" fill="#fff"/></g>
  <g id="km-sizes" opacity="0"></g>
  <text id="km-lbl" x="200" y="150" text-anchor="middle" fill="#fff" font-family="Enkel,Arial,sans-serif" font-size="13" font-weight="700" letter-spacing="1.5" opacity="0"></text>
  <g id="km-tip" opacity="0"><use href="#km-tipA" x="148" y="164" width="104" height="146"/><path d="M14 126 V66 C14 28 36 4 50 4 C64 4 86 28 86 66 V126 Q50 142 14 126 Z" transform="translate(148 164) scale(1.04 1.043)" fill="none" stroke="#0A0A0A" stroke-width="1.6"/>
    <g id="km-film" style="transform-origin:200px 310px"><path d="M14 126 V66 C14 28 36 4 50 4 C64 4 86 28 86 66 V126 Q50 142 14 126 Z" transform="translate(148 164) scale(1.04 1.043)" fill="rgba(255,255,255,.55)" stroke="#fff" stroke-width="2"/><rect x="184" y="304" width="32" height="20" rx="4" fill="#fff" stroke="#0A0A0A" stroke-width="1.5"/><path d="M190 314h20" stroke="#E3001B" stroke-width="2"/></g>
  </g>
  <g id="km-hand5" opacity="0" style="transform-origin:200px 300px">
    <use href="#km-nailA" x="40" y="214" width="56" height="94"/><use href="#km-nailA" x="106" y="178" width="62" height="104"/><use href="#km-nailA" x="174" y="160" width="66" height="110"/><use href="#km-nailA" x="246" y="178" width="62" height="104"/><use href="#km-nailA" x="312" y="214" width="56" height="94"/>
    <g fill="url(#km-ch)"><use href="#km-star" x="60" y="120" width="26" height="26"/><use href="#km-star" x="300" y="100" width="34" height="34"/><use href="#km-star" x="330" y="330" width="22" height="22"/><use href="#km-star" x="40" y="340" width="18" height="18"/></g>
  </g>
</svg>
      <div class="num" id="km-num">3</div>
      <div class="cap" id="km-cap">Step 1 · <i>wipe</i></div>
      <div class="holdhint">Hold to play</div>
      <div class="bar2"><i id="km-bar2"></i></div>
    </div>
    <div>
      <div class="steps" id="km-steps">
        <div class="step on" data-i="0"><div class="n">1</div><div><h4>Wipe off any residue</h4><p>Use the alcohol pad from the box to clean oil and moisture off every nail. This is what keeps a tip from lifting.</p><div class="pb"><i></i></div></div><div class="d">4s</div></div>
        <div class="step dim" data-i="1"><div class="n">2</div><div><h4>Trim to length</h4><p>File your natural nail so nothing peeks out past the tip and the surface sits flat.</p><div class="pb"><i></i></div></div><div class="d">4s</div></div>
        <div class="step dim" data-i="2"><div class="n">3</div><div><h4>Find your MUZMAK size</h4><p>Lay the tips over each nail and pick the one slightly smaller than the nail. Toenails take the exact size.</p><div class="pb"><i></i></div></div><div class="d">4s</div></div>
        <div class="step dim" data-i="3"><div class="n">4</div><div><h4>Peel the film and press</h4><p>Pull the tab toward your cuticle, place the tip and press firmly for three seconds.</p><div class="pb"><i></i></div></div><div class="d">5s</div></div>
        <div class="step dim" data-i="4"><div class="n">5</div><div><h4>Show them off</h4><p>One hand takes about a minute. No lamp, no drying time.</p><div class="pb"><i></i></div></div><div class="d">3s</div></div>
      </div>
      <button class="play" id="km-play" type="button"><span>Hold to play</span><span>●</span></button>
      <p class="hint" id="km-hint">Each step runs three to five seconds while you hold.</p>
    </div>
  </div>
</section>
</div>