<!doctype html>
<html
	class="no-js"
	data-scheme="{{ settings.color_scheme }}"
	lang="{{ request.locale.iso_code }}"
	dir="{% render 'direction' %}"
>
	<head>
		<meta charset="utf-8">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width,initial-scale=1">
		<meta name="theme-color" content="">
		<link rel="canonical" href="{{ canonical_url }}">
		<link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

		{% style %}
		  html, body {
			scrollbar-gutter: stable;
		  }

		  body {
			margin: 0;
		  }

		  .content-for-layout {
			width: 100%;
		  }

		  #MainContent > .shopify-section:last-child,
		  #MainContent > .shopify-section.kollab-last-main-section {
			margin-bottom: 0 !important;
			padding-bottom: 0 !important;
		  }

		  #MainContent > .shopify-section:last-child [class*="section-"][class*="-padding"],
		  #MainContent > .shopify-section.kollab-last-main-section [class*="section-"][class*="-padding"] {
			padding-bottom: 1.2rem !important;
		  }

		  #MainContent > .shopify-section.contact-section:last-child,
		  #MainContent > .shopify-section.contact-section.kollab-last-main-section,
		  #MainContent > .shopify-section:last-child .contact-section,
		  #MainContent > .shopify-section.kollab-last-main-section .contact-section {
			padding-bottom: 4rem !important;
		  }

		  @media screen and (min-width: 990px) {
			#MainContent > .shopify-section.contact-section:last-child,
			#MainContent > .shopify-section.contact-section.kollab-last-main-section,
			#MainContent > .shopify-section:last-child .contact-section,
			#MainContent > .shopify-section.kollab-last-main-section .contact-section {
			  padding-bottom: 5.2rem !important;
			}
		  }

		  @media screen and (min-width: 1150px) {
			#MainContent > .shopify-section.contact-section:last-child,
			#MainContent > .shopify-section.contact-section.kollab-last-main-section,
			#MainContent > .shopify-section:last-child .contact-section,
			#MainContent > .shopify-section.kollab-last-main-section .contact-section {
			  padding-bottom: 6.4rem !important;
			}
		  }
		{% endstyle %}

		{%- if settings.favicon != blank -%}
			<link
				rel="icon"
				type="image/png"
				href="{{ settings.favicon | img_url: '32x32' }}"
			>
		{%- endif -%}

		{%- unless settings.type_header_font.system? -%}
			<link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
		{%- endunless -%}

		<title>{{ page_title }}</title>

		{% if page_description %}
			<meta name="description" content="{{ page_description | escape }}">
		{% endif %}

		{% render 'meta-tags' %}

		{%- if request.page_type == 'index' -%}
			<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "Organization",
				"name": {{ shop.name | json }},
				"url": {{ shop.url | json }},
				{%- if settings.logo != blank -%}
					"logo": {{ settings.logo | image_url: width: 600 | prepend: "https:" | json }},
				{%- endif -%}
				{%- if settings.social_instagram_link != blank or settings.social_facebook_link != blank or settings.social_tiktok_link != blank or settings.social_twitter_link != blank -%}
					"sameAs": [
						{%- assign social_links = '' -%}
						{%- if settings.social_instagram_link != blank -%}{%- assign social_links = social_links | append: settings.social_instagram_link | append: '||' -%}{%- endif -%}
						{%- if settings.social_facebook_link != blank -%}{%- assign social_links = social_links | append: settings.social_facebook_link | append: '||' -%}{%- endif -%}
						{%- if settings.social_tiktok_link != blank -%}{%- assign social_links = social_links | append: settings.social_tiktok_link | append: '||' -%}{%- endif -%}
						{%- if settings.social_twitter_link != blank -%}{%- assign social_links = social_links | append: settings.social_twitter_link | append: '||' -%}{%- endif -%}
						{%- assign social_link_list = social_links | split: '||' -%}
						{%- for social_link in social_link_list -%}
							{{ social_link | strip | json }}{%- unless forloop.last -%},{%- endunless -%}
						{%- endfor -%}
					],
				{%- endif -%}
				"description": {{ shop.description | default: shop.name | json }}
			}
			</script>
		{%- endif -%}

		<script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
		<script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
		<script src="{{ 'global.js' | asset_url }}" defer="defer"></script>

		<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
		<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

		{{ content_for_header }}

		{% render 'vars' %}

		{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
		{{ 'base.css' | asset_url | stylesheet_tag }}
		{%- if request.page_type != 'cart' and settings.cart_type == 'drawer' -%}
			{{ 'component-cart-drawer.css' | asset_url | stylesheet_tag }}
		{%- endif -%}

		{%- if settings.predictive_search_enabled -%}
			<link
				rel="stylesheet"
				href="{{ 'component-predictive-search.css' | asset_url }}"
				media="print"
				onload="this.media='all'"
			>
		{%- endif -%}

		{%- unless settings.type_body_font.system? -%}
			<link
				rel="preload"
				as="font"
				href="{{ settings.type_body_font | font_url }}"
				type="font/woff2"
				crossorigin
			>
		{%- endunless -%}
		{%- unless settings.type_header_font.system? -%}
			<link
				rel="preload"
				as="font"
				href="{{ settings.type_header_font | font_url }}"
				type="font/woff2"
				crossorigin
			>
		{%- endunless -%}

		<script>
			document.documentElement.className =
				document.documentElement.className.replace('no-js', 'js');
			if (Shopify.designMode) {
				document.documentElement.classList.add('shopify-design-mode');
			}
		</script>

		<script src="{{ 'jquery-3.6.0.js' | asset_url }}" defer="defer"></script>
		<script
			src="{{ 'swiper-bundle.min.js' | asset_url }}"
			defer="defer"
		></script>

		<script src="{{ 'jquery-marquee.js' | asset_url }}" defer="defer"></script>
		<script src="{{ 'gsap.min.js' | asset_url }}" defer="defer"></script>
		<script src="{{ 'parallax.js' | asset_url }}" defer="defer"></script>
		{% comment %}<script src="{{ 'hammer.js' | asset_url }}" defer="defer"></script>{% endcomment %}
		<script src="{{ 'observer.min.js' | asset_url }}" defer="defer"></script>
		<script
			src="{{ 'ScrollTrigger.min.js' | asset_url }}"
			defer="defer"
		></script>
		{%- if request.page_type != 'search' and settings.enable_search_modal -%}
			<script src="{{ 'search-modal.js' | asset_url }}" defer="defer"></script>
		{%- endif -%}
		<script src="{{ 'popup.js' | asset_url }}" defer="defer"></script>
		{% if settings.show_back_to_top %}
