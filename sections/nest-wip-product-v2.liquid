{%- comment -%}
  NEST WIP PDP v2.2 — draft template, not linked to live product.json
  Changes from v2.1:
  - Uses theme's own 'price' snippet (exact sale-price styling, no more
    hand-rolled gray strikethrough)
  - Uses theme's own 'section-header' snippet for Product Detail heading,
    for typographic parity with native sections
  - Sticky bottom add-to-cart bar (thumb + title + price + qty + ATC),
    appears once the main ATC scrolls out of view, with a simple free-
    shipping progress gauge fed by /cart.js
  - Bigger shipping-note text
  - Fixed image swap bug: image_tag's auto-generated srcset was overriding
    the swapped src on some viewports. Now clears srcset/sizes on swap.
  - Mobile (<=900px): swipeable scroll-snap gallery replaces the
    click-to-swap thumbnail grid
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign ship_threshold = section.settings.free_shipping_threshold | default: 50 -%}

{%- assign clean_title = product.title -%}
{%- if clean_title contains ']' -%}
  {%- assign clean_title = clean_title | split: ']' | last | strip -%}
{%- endif -%}

{%- assign mf = product.metafields.custom -%}

<style>
  .nwip{ --ink:#16181A; --ink60:#5C6266; --ink30:#A8AEB1; --line:#E3E5E1;
    --surface:#F4F5F3;
    font-family:var(--font-body-family, 'Inter', sans-serif); color:var(--ink); }
  .nwip *{ box-sizing:border-box; }
  .nwip img{ max-width:100%; display:block; }

  .nwip-grid{ display:grid; grid-template-columns:1fr 1fr; }
  .nwip-gallery{ background:var(--surface); padding:28px; }
  .nwip-shot{ background:#fff; }
  .nwip-thumbs{ display:grid; grid-template-columns:repeat(5,1fr); gap:7px; margin-top:10px; }
  .nwip-thumbs button{ background:#fff; border:1px solid transparent; padding:0; cursor:pointer; }
  .nwip-thumbs button.on{ border-color:var(--ink); }
  .nwip-gallery-mobile{ display:none; overflow-x:auto; scroll-snap-type:x mandatory; gap:8px; }
  .nwip-buy{ padding:44px 40px; }

  .nwip-eyebrow{ font-size:11px; letter-spacing:.22em; text-transform:uppercase;
    color:var(--ink60); margin-bottom:12px; }
  .nwip-title{ font-family:var(--font-heading-family, Georgia, serif);
    font-size:38px; line-height:1.12; font-weight:400; margin:0; }
  .nwip-desc{ font-size:13px; color:var(--ink60); margin-top:7px; }
  .nwip-hero{ font-size:17px; line-height:1.5; font-weight:300; margin:22px 0 0; }
  .nwip-price-row{ margin-top:24px; }
  .nwip-price-row .price-item--sale,
  .nwip-price-row .price__regular .price-item--regular{ font-size:28px; font-weight:500; color:var(--ink); }
  .nwip-price-row .price__compare .price-item--regular{ font-size:19px; font-weight:400;
    color:#C0392B; text-decoration:line-through; margin-left:4px; }

  .nwip-sizes{ display:flex; gap:8px; flex-wrap:wrap; margin-top:20px; }
  .nwip-size{ border:1px solid var(--line); background:#fff; padding:11px 17px;
    font-size:13px; border-radius:2px; cursor:pointer; transition:.15s; color:var(--ink); }
  .nwip-size[aria-pressed="true"]{ border-color:var(--ink); background:var(--ink); color:#fff; }
  .nwip-size .sub{ display:block; font-size:10.5px; opacity:.55; margin-top:2px; }
  .nwip-size[disabled]{ opacity:.4; cursor:not-allowed; }

  .nwip-qty-row{ display:flex; gap:12px; margin-top:22px; }
  .nwip-qty{ display:flex; align-items:center; border:1px solid var(--line); border-radius:999px;
    overflow:hidden; flex-shrink:0; }
  .nwip-qty button{ width:38px; height:44px; border:none; background:#fff; cursor:pointer;
    font-size:16px; color:var(--ink); }
  .nwip-qty button:hover{ background:var(--surface); }
  .nwip-qty input{ width:34px; text-align:center; border:none; font-size:14px;
    -moz-appearance:textfield; }
  .nwip-qty input::-webkit-outer-spin-button,
  .nwip-qty input::-webkit-inner-spin-button{ -webkit-appearance:none; margin:0; }

  .nwip-atc{ flex:1; background:var(--ink); color:#fff; border:none; padding:0 16px;
    font-size:14px; font-weight:500; letter-spacing:.02em;
    border-radius:999px; cursor:pointer; transition:.15s; }
  .nwip-atc:hover{ background:#000; }
  .nwip-atc[disabled]{ background:var(--surface); color:var(--ink60);
    border:1px solid var(--line); cursor:not-allowed; }

  .nwip-dynamic-checkout{ margin-top:12px; display:flex; gap:10px; align-items:stretch; }
  .nwip-dynamic-checkout > div{ flex:1; min-width:0; }
  .nwip-dynamic-checkout .shopify-payment-button{ height:100%; }
  .nwip-dynamic-checkout .shopify-payment-button__button{ border-radius:999px !important; height:44px !important; }
  .nwip-more-payment{ flex:1; height:44px; border-radius:999px; border:1px solid var(--line);
    background:#fff; color:var(--ink); font-size:13px; font-weight:500; cursor:pointer;
    white-space:nowrap; }
  .nwip-more-payment:hover{ background:var(--surface); }

  .nwip-policies{ margin-top:22px; display:flex; flex-direction:column; gap:11px; }
  .nwip-policy-row{ display:flex; align-items:flex-start; gap:9px; font-size:15px;
    color:var(--ink60); line-height:1.5; font-weight:500; }
  .nwip-policy-row svg{ width:20px; height:20px; flex-shrink:0; margin-top:1px; color:var(--ink60); }
  .nwip-policy-row a{ color:var(--ink); text-decoration:underline; text-underline-offset:2px;
    font-weight:400; }

  .nwip-app-zone{ margin-top:28px; }

  .nwip-acc{ border-top:1px solid var(--ink); margin-top:32px; }
  .nwip-acc details{ border-bottom:1px solid var(--line); }
  .nwip-acc summary{ padding:19px 0; cursor:pointer; list-style:none;
    display:flex; justify-content:space-between; align-items:center; gap:14px; }
  .nwip-acc summary::-webkit-details-marker{ display:none; }
  .nwip-acc summary .t{ font-size:13px; letter-spacing:.12em; text-transform:uppercase; font-weight:500; }
  .nwip-acc summary .ic{ width:11px; height:11px; position:relative; flex-shrink:0; }
  .nwip-acc summary .ic:before,.nwip-acc summary .ic:after{ content:''; position:absolute;
    background:var(--ink); transition:transform .22s; }
  .nwip-acc summary .ic:before{ top:5px; left:0; width:11px; height:1px; }
  .nwip-acc summary .ic:after{ left:5px; top:0; width:1px; height:11px; }
  .nwip-acc details[open] summary .ic:after{ transform:scaleY(0); }
  .nwip-acc .bd{ padding:0 0 24px; font-size:14px; line-height:1.75; }
  .nwip-acc h4{ font-size:11.5px; letter-spacing:.1em; text-transform:uppercase;
    color:var(--ink60); margin:22px 0 9px; font-weight:500; }
  .nwip-bullets{ list-style:none; padding:0; margin:0; }
  .nwip-bullets li{ padding-left:17px; position:relative; margin-bottom:8px; }
  .nwip-bullets li:before{ content:''; position:absolute; left:0; top:11px;
    width:5px; height:1px; background:var(--ink); }
  .nwip-inci{ font-family:ui-monospace,monospace; font-size:11px; line-height:1.85;
    color:var(--ink60); word-break:break-word; }
  .nwip-pending{ border:1px dashed var(--ink30); border-radius:4px; padding:18px;
    background:repeating-linear-gradient(-45deg,#FAFBF9,#FAFBF9 9px,#F2F4F0 9px,#F2F4F0 18px);
    font-size:12.5px; color:var(--ink60); }

  .nwip-faq{ margin-top:30px; }
  .nwip-faq details{ border-bottom:1px solid var(--line); }
  .nwip-faq summary{ padding:16px 0; font-size:14px; cursor:pointer; list-style:none;
    display:flex; justify-content:space-between; gap:14px; }
  .nwip-faq summary::-webkit-details-marker{ display:none; }
  .nwip-faq summary:after{ content:'+'; font-size:17px; color:var(--ink30); line-height:1; }
  .nwip-faq details[open] summary:after{ content:'\2013'; }
  .nwip-faq .a{ padding:0 0 18px; font-size:13.5px; color:var(--ink60);
    line-height:1.7; max-width:62ch; }

  .nwip-detail{ background:#fff; }
  .nwip-detail-wrap{ max-width:860px; margin:0 auto; padding:0 22px 64px; font-size:14px;
    line-height:1.75; color:var(--ink60); }
  .nwip-detail-wrap img{ margin:0 auto 20px; }

  .nwip-wipbar{ background:#FBD5C4; color:#8A2B12; font-size:11.5px; font-weight:600;
    letter-spacing:.06em; text-align:center; padding:7px 12px; text-transform:uppercase; }

  {%- comment -%} ---- Sticky add-to-cart bar ---- {%- endcomment -%}
  .nwip-sticky-atc{ --ink:#16181A; --ink60:#5C6266; --ink30:#A8AEB1; --line:#E3E5E1; --surface:#F4F5F3;
    position:fixed; left:50%; bottom:18px; transform:translate(-50%,140%);
    z-index:40; width:min(680px, calc(100% - 32px)); background:#fff; border-radius:16px;
    box-shadow:0 10px 40px rgba(0,0,0,.16); padding:14px 16px; transition:transform .28s ease; }
  .nwip-sticky-atc.show{ transform:translate(-50%,0); }
  .nwip-sticky-inner{ display:flex; align-items:center; gap:12px; }
  .nwip-sticky-thumb{ width:46px; height:46px; border-radius:8px; object-fit:cover;
    background:var(--surface); flex-shrink:0; }
  .nwip-sticky-info{ flex:1; min-width:0; }
  .nwip-sticky-title{ font-size:13px; line-height:1.3;
    overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .nwip-sticky-price{ font-size:13px; color:var(--ink60); margin-top:2px; }
  .nwip-sticky-qty{ display:none; }
  .nwip-sticky-btn{ height:44px; white-space:nowrap; padding:0 20px; flex-shrink:0; }
  .nwip-ship-gauge{ margin-top:11px; }
  .nwip-ship-gauge-track{ height:4px; background:var(--surface); border-radius:99px;
    overflow:hidden; }
  .nwip-ship-gauge-fill{ height:100%; width:0%; background:var(--ink);
    transition:width .3s ease; }
  .nwip-ship-gauge-label{ font-size:11px; color:var(--ink60); margin-top:6px; text-align:center; }

  @media (max-width:900px){
    .nwip-grid{ grid-template-columns:1fr; }
    .nwip-buy{ padding:28px 22px; }
    .nwip-title{ font-size:30px; }
    .nwip-gallery-desktop{ display:none; }
    .nwip-gallery-mobile{ display:flex; }
    .nwip-sticky-qty{ display:none; }
  }
  @media (min-width:901px){
    .nwip-gallery{ position:sticky; top:20px; align-self:start; }
  }
</style>

<div class="nwip">
  {%- if section.settings.show_wip_banner -%}
    <div class="nwip-wipbar">WIP Template v2.2 &mdash; Nest draft, not the live PDP</div>
  {%- endif -%}

  <div class="nwip-grid">

    {%- comment -%} ============ GALLERY ============ {%- endcomment -%}
    <div class="nwip-gallery">
      {%- if product.images.size > 0 -%}
        {%- assign hero_img = product.images.first -%}
        {%- assign hero_alt = hero_img.alt | default: clean_title | escape -%}

        {%- comment -%} ---- Desktop: click-to-swap ---- {%- endcomment -%}
        <div class="nwip-gallery-desktop">
          <div class="nwip-shot" id="nwipMain">
            {{ hero_img | image_url: width: 1200 | image_tag: id: 'nwipMainImg', class: 'nwip-main-img', alt: hero_alt, loading: 'eager', width: 1200 }}
          </div>
          <div class="nwip-thumbs">
            {%- for image in product.images limit: 5 -%}
              {%- assign t_alt = image.alt | default: clean_title | escape -%}
              {%- assign t_full = image | image_url: width: 1200 -%}
              <button type="button"
                class="{% if forloop.first %}on{% endif %}"
                data-full="{{ t_full }}"
                onclick="nwipSwap(this)">
                {{ image | image_url: width: 200 | image_tag: alt: t_alt, loading: 'lazy', width: 200 }}
              </button>
            {%- endfor -%}
          </div>
        </div>

        {%- comment -%} ---- Mobile: swipeable scroll-snap ---- {%- endcomment -%}
        <div class="nwip-gallery-mobile">
          {%- for image in product.images -%}
            {%- assign m_alt = image.alt | default: clean_title | escape -%}
            <div style="flex:0 0 100%; scroll-snap-align:center;">
              {{ image | image_url: width: 1200 | image_tag: alt: m_alt, loading: 'lazy', width: 1200 }}
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="nwip-pending">No product images.</div>
      {%- endif -%}
    </div>

    {%- comment -%} ============ BUY BOX ============ {%- endcomment -%}
    <div class="nwip-buy">
      <div class="nwip-eyebrow">{{ product.vendor }}</div>
      <h1 class="nwip-title">{{ clean_title }}</h1>

      {%- if mf.descriptor != blank -%}
        <div class="nwip-desc">{{ mf.descriptor }}</div>
      {%- endif -%}

      {%- if mf.hero_line != blank -%}
        <p class="nwip-hero">{{ mf.hero_line }}</p>
      {%- endif -%}

      <div class="nwip-price-row" id="nwipPriceBox">
        {%- render 'price', product: product, use_variant: true, show_badges: true -%}
      </div>

      {%- form 'product', product, id: 'nwip-form' -%}
        <input type="hidden" name="id" id="nwipVariantId" value="{{ current_variant.id }}">

        {%- if product.variants.size > 1 -%}
          <div class="nwip-sizes">
            {%- for variant in product.variants -%}
              {%- assign v_price = variant.price | money -%}
              {%- assign v_compare = '' -%}
              {%- if variant.compare_at_price > variant.price -%}{%- assign v_compare = variant.compare_at_price | money -%}{%- endif -%}
              <button type="button" class="nwip-size"
                aria-pressed="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}"
                data-variant-id="{{ variant.id }}"
                data-price="{{ v_price }}"
                data-compare="{{ v_compare }}"
                data-available="{{ variant.available }}"
                onclick="nwipSelect(this)"
                {% unless variant.available %}disabled{% endunless %}>
                {{ variant.title }}
                {%- unless variant.available -%}<span class="sub">Sold out</span>{%- endunless -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="nwip-qty-row">
          <div class="nwip-qty">
            <button type="button" onclick="nwipQty(-1)" aria-label="Decrease quantity">&minus;</button>
            <input type="number" name="quantity" id="nwipQtyInput" value="1" min="1" inputmode="numeric">
            <button type="button" onclick="nwipQty(1)" aria-label="Increase quantity">+</button>
          </div>

          {%- if current_variant.available -%}
            <button type="submit" name="add" class="nwip-atc" id="nwipAtc">
              Add to cart &middot; <span id="nwipAtcPrice">{{ current_variant.price | money }}</span>
            </button>
          {%- else -%}
            <button type="button" class="nwip-atc" id="nwipAtc" disabled>Sold out</button>
          {%- endif -%}
        </div>

        <div class="nwip-dynamic-checkout">
          <div>{{ form | payment_button }}</div>
          <button type="submit" name="checkout" class="nwip-more-payment">More Payment Options</button>
        </div>
      {%- endform -%}

      <div class="nwip-policies">
        <div class="nwip-policy-row">
          {%- render 'icon-shipping' -%}
          <span>
            {%- if section.settings.shipping_note != blank -%}{{ section.settings.shipping_note }}. {% endif -%}
            {%- if shop.shipping_policy.url != blank -%}
              <a href="{{ shop.shipping_policy.url }}">View shipping policy</a>
            {%- endif -%}
          </span>
        </div>
        <div class="nwip-policy-row">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="1.4">
            <path d="M20 11a8 8 0 1 0-2.6 5.9M20 11V6m0 5h-5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>
            {%- if section.settings.returns_note != blank -%}{{ section.settings.returns_note }}. {%- endif -%}
            {%- if shop.refund_policy.url != blank -%}
              <a href="{{ shop.refund_policy.url }}">View return policy</a>
            {%- endif -%}
          </span>
        </div>
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="nwip-app-zone">
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }}>{% render block %}</div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="nwip-acc">
        <details open>
          <summary><span class="t">What it does</span><span class="ic"></span></summary>
          <div class="bd">
            {%- if mf.key_benefits != blank -%}
              <ul class="nwip-bullets">
                {%- for b in mf.key_benefits.value -%}<li>{{ b }}</li>{%- endfor -%}
              </ul>
            {%- elsif product.metafields.custom.benefits != blank -%}
              <ul class="nwip-bullets">
                {%- for b in product.metafields.custom.benefits.value -%}<li>{{ b }}</li>{%- endfor -%}
              </ul>
            {%- else -%}
              <div class="nwip-pending">Please see product images for detail.</div>
            {%- endif -%}
            {%- if mf.hero_ingredients != blank -%}
              <h4>Key ingredients</h4>
              <div>{{ mf.hero_ingredients | newline_to_br }}</div>
            {%- endif -%}
          </div>
        </details>

        <details>
          <summary><span class="t">How to use</span><span class="ic"></span></summary>
          <div class="bd">
            {%- if mf.how_to_use != blank -%}
              <div>{{ mf.how_to_use | newline_to_br }}</div>
              {%- if mf.am_pm != blank -%}<h4>When</h4><div>{{ mf.am_pm }}</div>{%- endif -%}
            {%- else -%}
              <div class="nwip-pending">Please see product images for detail.</div>
            {%- endif -%}
          </div>
        </details>

        <details>
          <summary><span class="t">Ingredients</span><span class="ic"></span></summary>
          <div class="bd">
            {%- if mf.inci_list != blank -%}
              <p class="nwip-inci">{{ mf.inci_list | newline_to_br }}</p>
            {%- else -%}
              <div class="nwip-pending">Please see product images for detail.</div>
            {%- endif -%}
          </div>
        </details>
      </div>

      {%- if mf.faq != blank -%}
        <div class="nwip-faq">
          {%- assign faq_pairs = mf.faq | strip | split: ';;' -%}
          {%- for pair in faq_pairs -%}
            {%- assign qa = pair | split: '|' -%}
            {%- if qa.size >= 2 -%}
              <details {% if forloop.first %}open{% endif %}>
                <summary>{{ qa[0] | strip }}</summary>
                <div class="a">{{ qa[1] | strip }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ============ PRODUCT DETAIL — uses theme's own section-header for exact style match ============ {%- endcomment -%}
  {%- if product.description != blank -%}
    <div class="nwip-detail">
      {%- render 'section-header',
        show_arrows: false,
        section: section
      -%}
      <div class="nwip-detail-wrap">
        {{ product.description }}
      </div>
    </div>
  {%- endif -%}
</div>

{%- comment -%} ============ STICKY ADD TO CART ============ {%- endcomment -%}
<div class="nwip-sticky-atc" id="nwipStickyAtc">
  <div class="nwip-sticky-inner">
    {%- if product.featured_image -%}
      <img class="nwip-sticky-thumb" src="{{ product.featured_image | image_url: width: 100 }}" alt="">
    {%- endif -%}
    <div class="nwip-sticky-info">
      <div class="nwip-sticky-title">{{ clean_title }}</div>
      <div class="nwip-sticky-price" id="nwipStickyPrice">{{ current_variant.price | money }}</div>
    </div>
    {%- if current_variant.available -%}
      <button type="button" class="nwip-atc nwip-sticky-btn" id="nwipStickyBtn" onclick="nwipStickyAdd()">
        Add to Cart &middot; <span id="nwipStickyAtcPrice">{{ current_variant.price | money }}</span>
      </button>
    {%- else -%}
      <button type="button" class="nwip-atc nwip-sticky-btn" disabled>Sold out</button>
    {%- endif -%}
  </div>
  <div class="nwip-ship-gauge">
    <div class="nwip-ship-gauge-track"><div class="nwip-ship-gauge-fill" id="nwipShipFill"></div></div>
    <div class="nwip-ship-gauge-label" id="nwipShipLabel"></div>
  </div>
</div>

<script>
  window.nwipShipThreshold = {{ ship_threshold | times: 100 }};
  window.nwipCurrentVariantId = {{ current_variant.id | json }};

  function nwipSwap(btn){
    var main = document.getElementById('nwipMainImg');
    if (main && btn.dataset.full) {
      main.removeAttribute('srcset');
      main.removeAttribute('sizes');
      main.src = btn.dataset.full;
    }
    document.querySelectorAll('.nwip-thumbs button').forEach(function(b){ b.classList.remove('on'); });
    btn.classList.add('on');
  }

  function nwipRenderPrice(price, compare){
    var box = document.getElementById('nwipPriceBox');
    if (!box) return;
    if (compare) {
      box.innerHTML =
        '<div class="price price--on-sale"><dl>' +
        '<div class="price__sale"><dd><span class="price-item price-item--sale">' + price + '</span></dd>' +
        '<dd class="price__compare"><span class="price-item price-item--regular">' + compare + '</span></dd></div>' +
        '</dl></div>';
    } else {
      box.innerHTML =
        '<div class="price"><dl><div class="price__regular"><dd><span class="price-item price-item--regular">' + price + '</span></dd></div></dl></div>';
    }
  }

  function nwipSelect(btn){
    if (btn.disabled) return;
    document.querySelectorAll('.nwip-size').forEach(function(b){ b.setAttribute('aria-pressed','false'); });
    btn.setAttribute('aria-pressed','true');
    document.getElementById('nwipVariantId').value = btn.dataset.variantId;
    window.nwipCurrentVariantId = btn.dataset.variantId;
    if (btn.dataset.price) {
      nwipRenderPrice(btn.dataset.price, btn.dataset.compare);
      var atcPriceEl = document.getElementById('nwipAtcPrice');
      var stickyPriceEl = document.getElementById('nwipStickyPrice');
      var stickyAtcPriceEl = document.getElementById('nwipStickyAtcPrice');
      if (atcPriceEl) atcPriceEl.textContent = btn.dataset.price;
      if (stickyPriceEl) stickyPriceEl.textContent = btn.dataset.price;
      if (stickyAtcPriceEl) stickyAtcPriceEl.textContent = btn.dataset.price;
    }
    var atc = document.getElementById('nwipAtc');
    var stickyBtn = document.getElementById('nwipStickyBtn');
    var available = btn.dataset.available === 'true';
    if (atc) atc.disabled = !available;
    if (stickyBtn) stickyBtn.disabled = !available;
  }

  function nwipQty(delta){
    var input = document.getElementById('nwipQtyInput');
    if (!input) return;
    var val = parseInt(input.value, 10) || 1;
    val = Math.max(1, val + delta);
    input.value = val;
  }

  function nwipStickyAdd(){
    var btn = document.getElementById('nwipStickyBtn');
    var qtyInput = document.getElementById('nwipQtyInput');
    var qty = qtyInput ? (parseInt(qtyInput.value, 10) || 1) : 1;
    if (!btn || btn.disabled) return;
    btn.disabled = true;
    var originalText = btn.innerHTML;
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: window.nwipCurrentVariantId, quantity: qty })
    })
      .then(function(r){ return r.json(); })
      .then(function(){
        btn.innerHTML = 'Added &#10003;';
        nwipRefreshShipGauge();
        setTimeout(function(){ btn.innerHTML = originalText; btn.disabled = false; }, 1600);
      })
      .catch(function(){
        btn.innerHTML = originalText;
        btn.disabled = false;
      });
  }

  function nwipRefreshShipGauge(){
    fetch('/cart.js')
      .then(function(r){ return r.json(); })
      .then(function(cart){
        var fill = document.getElementById('nwipShipFill');
        var label = document.getElementById('nwipShipLabel');
        if (!fill || !label) return;
        var threshold = window.nwipShipThreshold || 5000;
        var pct = Math.min(100, (cart.total_price / threshold) * 100);
        fill.style.width = pct + '%';
        if (cart.total_price >= threshold) {
          label.textContent = "You've unlocked free shipping!";
        } else {
          var remaining = ((threshold - cart.total_price) / 100).toFixed(2);
          label.textContent = '$' + remaining + ' away from free shipping';
        }
      })
      .catch(function(){});
  }

  function nwipInitStickyBar(){
    var stickyBar = document.getElementById('nwipStickyAtc');
    var mainAtc = document.getElementById('nwipAtc');
    if (!stickyBar || !mainAtc) return;

    // Reparent to <body> so position:fixed is always relative to the
    // viewport, not a transformed ancestor (a common cause of "fixed"
    // elements getting trapped inside a section wrapper).
    if (stickyBar.parentElement !== document.body) {
      document.body.appendChild(stickyBar);
    }

    function checkVisibility(){
      var rect = mainAtc.getBoundingClientRect();
      var isVisible = rect.bottom > 0 && rect.top < (window.innerHeight || document.documentElement.clientHeight);
      if (isVisible) {
        stickyBar.classList.remove('show');
      } else {
        stickyBar.classList.add('show');
      }
    }

    if ('IntersectionObserver' in window) {
      var obs = new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          if (entry.isIntersecting) {
            stickyBar.classList.remove('show');
          } else {
            stickyBar.classList.add('show');
          }
        });
      }, { threshold: 0 });
      obs.observe(mainAtc);
    } else {
      window.addEventListener('scroll', checkVisibility, { passive: true });
      window.addEventListener('resize', checkVisibility);
    }
    checkVisibility();
  }

  (function(){
    nwipRefreshShipGauge();
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', nwipInitStickyBar);
    } else {
      nwipInitStickyBar();
    }
  })();
</script>

