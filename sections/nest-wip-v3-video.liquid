{%- comment -%}
  NEST WIP v3 — video/reels header. Wraps the ReelUp shoppable-video app
  block (added via @app block below) with the red "Watch it, then shop it"
  heading treatment from the mockup. Add the ReelUp product-slider app
  block to this section in the theme editor, same as it's added to
  nest-wip-product-v2 today.
{%- endcomment -%}

{{ 'nest-wip-v3.css' | asset_url | stylesheet_tag }}

<div class="nwip3 nwip3-video nwip3-section">
  <div class="nwip3-section-head center" style="margin-left:auto; margin-right:auto;">
    <div class="nwip3-eyebrow-lbl">{{ section.settings.eyebrow | default: 'In use' }}</div>
    <h2 class="nwip3-h2 serif">{{ section.settings.heading | default: 'Watch it, then shop it.' }}</h2>
    {%- if section.blocks.size == 0 -%}
      <p class="nwip3-video-note">Add the ReelUp shoppable-video block to this section to show the reel carousel here.</p>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div style="margin-top:20px;">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>{% render block %}</div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "NEST WIP v3 Video/Reels",
  "tag": "section",
  "blocks": [
    { "type": "@app" }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In use" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Watch it, then shop it." }
  ],
  "presets": [{ "name": "NEST WIP v3 Video/Reels" }]
}
{% endschema %}
