{% style %}
	{% render 'section-margin' %}
	@import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap');

	#shopify-section-{{ section.id }} .kollab-events {
		padding: 70px 0 78px;
		background: #ffffff;
		color: #000000;
		overflow: hidden;
	}

	#shopify-section-{{ section.id }} .kollab-events__inner {
		width: min(100% - 32px, 1200px);
		margin: 0 auto;
	}

	#shopify-section-{{ section.id }} .kollab-events__heading {
		margin: 0 0 28px;
		color: #F12C18;
		font-family: "Instrument Serif", Georgia, serif;
		font-size: clamp(42px, 6vw, 64px);
		font-weight: 400;
		line-height: 0.95;
		letter-spacing: 0;
		text-align: center;
	}

	#shopify-section-{{ section.id }} .kollab-events__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 24px;
		align-items: stretch;
	}

	#shopify-section-{{ section.id }} .kollab-event-card {
		display: flex;
		flex-direction: column;
		min-width: 0;
		height: 470px;
		background: #ffffff;
		border: 2px solid #1b1b1b;
		color: #000000;
		overflow: hidden;
	}

	#shopify-section-{{ section.id }} .kollab-event-card__body {
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		min-height: 0;
		padding: 19px 15px 0;
	}

	#shopify-section-{{ section.id }} .kollab-event-card__title {
		margin: 0 0 22px;
		color: #F12C18;
		font-size: 29px;
		font-weight: 900;
		line-height: 0.92;
		letter-spacing: 0;
	}

	#shopify-section-{{ section.id }} .kollab-event-card__title a {
		color: inherit;
		text-decoration: none;
	}

	#shopify-section-{{ section.id }} .kollab-event-card__excerpt {
		margin: 0 0 22px;
		color: #000000;
		font-size: 13px;
		font-weight: 600;
		line-height: 1.25;
	}

	#shopify-section-{{ section.id }} .kollab-event-card__meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-top: auto;
		margin-bottom: 22px;
	}

	#shopify-section-{{ section.id }} .kollab-event-card__badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 31px;
		padding: 8px 13px;
		background: #000000;
		color: #ffffff;
		font-family: Georgia, serif;
		font-size: 13px;
		font-weight: 700;
		line-height: 1;
		white-space: nowrap;
	}

	#shopify-section-{{ section.id }} .kollab-event-card__date {
		color: #F12C18;
		font-size: 26px;
		font-weight: 900;
		line-height: 1;
		letter-spacing: 0;
		text-transform: uppercase;
		white-space: nowrap;
	}

	#shopify-section-{{ section.id }} .kollab-event-card__media {
		display: block;
		width: 100%;
		height: 194px;
		background: #f3f0e8;
		overflow: hidden;
	}

	#shopify-section-{{ section.id }} .kollab-event-card__media img,
	#shopify-section-{{ section.id }} .kollab-event-card__placeholder {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	#shopify-section-{{ section.id }} .kollab-event-card__placeholder {
		background: #f3f0e8;
	}

	#shopify-section-{{ section.id }} .kollab-event-card__button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		min-height: 41px;
		padding: 11px 14px;
		background: #F12C18;
		color: #ffffff;
		border: 0;
		font-size: 17px;
		font-weight: 900;
		line-height: 1;
		text-align: center;
		text-decoration: none;
	}

	#shopify-section-{{ section.id }} .kollab-event-card__button:hover {
		background: #000000;
		color: #ffffff;
	}

	#shopify-section-{{ section.id }} .kollab-events__empty {
		margin: 26px 0 0;
		color: #000000;
		font-size: 15px;
		font-weight: 800;
		text-align: center;
	}

	#shopify-section-{{ section.id }} .kollab-events__past {
		display: flex;
		justify-content: center;
		margin-top: 28px;
	}

	#shopify-section-{{ section.id }} .kollab-events__past a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 42px;
		padding: 12px 22px;
		background: #000000;
		color: #ffffff;
		border-radius: 999px;
		font-size: 12px;
		font-weight: 900;
		line-height: 1;
		text-decoration: none;
		text-transform: uppercase;
	}

	@media screen and (max-width: 989px) {
		#shopify-section-{{ section.id }} .kollab-events__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media screen and (max-width: 560px) {
		#shopify-section-{{ section.id }} .kollab-events {
			padding: 48px 0 56px;
		}

		#shopify-section-{{ section.id }} .kollab-events__grid {
			grid-template-columns: 1fr;
		}

		#shopify-section-{{ section.id }} .kollab-event-card {
			height: auto;
			min-height: 470px;
		}
	}
{% endstyle %}

{% liquid
	assign events_blog = section.settings.blog
	assign event_tag = section.settings.event_tag | default: 'event' | strip
	assign event_tag_downcase = event_tag | downcase
	assign max_articles = section.settings.max_articles
	assign rendered_events = 0
	assign rsvp_tag_downcase = section.settings.rsvp_tag | downcase
%}

<section class="kollab-events">
	<div class="kollab-events__inner">
		<h2 class="kollab-events__heading">{{ section.settings.heading }}</h2>

		{% if events_blog != blank %}
			<div class="kollab-events__grid">
				{% for article in events_blog.articles %}
					{% assign article_tags_downcase = article.tags | join: ',' | downcase %}
					{% if rendered_events < max_articles and article_tags_downcase contains event_tag_downcase %}
						{% assign rendered_events = rendered_events | plus: 1 %}
						{% assign article_image_alt = article.image.alt | default: article.title %}
						{% assign article_month = article.published_at | date: '%B' | upcase %}
						{% assign article_day = article.published_at | date: '%-d' %}
						{% assign badge_text = section.settings.default_badge %}
						{% if article_tags_downcase contains rsvp_tag_downcase %}
							{% assign badge_text = section.settings.rsvp_label %}
						{% endif %}

						<article class="kollab-event-card">
							<div class="kollab-event-card__body">
								<h3 class="kollab-event-card__title">
									<a href="{{ article.url }}">{{ article.title }}</a>
								</h3>
								<p class="kollab-event-card__excerpt">
									{% if article.excerpt_or_content != blank %}
										{{ article.excerpt_or_content | strip_html | truncate: 95 }}
									{% else %}
										Event short description, event short description, event short description
									{% endif %}
								</p>
								<div class="kollab-event-card__meta">
									<span class="kollab-event-card__badge">{{ badge_text }}</span>
									<span class="kollab-event-card__date">{{ article_month }} {{ article_day }}</span>
								</div>
							</div>
							<a class="kollab-event-card__media" href="{{ article.url }}">
								{% if article.image != blank %}
									{{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 100vw', alt: article_image_alt }}
								{% else %}
									<span class="kollab-event-card__placeholder" aria-hidden="true"></span>
								{% endif %}
							</a>
							<a class="kollab-event-card__button" href="{{ article.url }}">Join Event &rarr;</a>
						</article>
					{% endif %}
				{% endfor %}
			</div>

			{% if rendered_events == 0 %}
				<p class="kollab-events__empty">No upcoming events found. Add the "{{ event_tag }}" tag to blog articles.</p>
			{% endif %}
		{% else %}
			<p class="kollab-events__empty">Select a blog for this events section.</p>
		{% endif %}

		{% if section.settings.show_past_events and section.settings.past_events_link != blank %}
			<div class="kollab-events__past">
				<a href="{{ section.settings.past_events_link }}">See Past Events</a>
			</div>
		{% endif %}
	</div>
</section>

{% schema %}
{
	"name": "Kollab events",
	"tag": "section",
	"class": "spaced-section section-kollab-events",
	"enabled_on": {
		"templates": ["*"]
	},
	"settings": [
		{
			"type": "inline_richtext",
			"id": "heading",
			"default": "Upcoming Events",
			"label": "Heading"
		},
		{
			"type": "blog",
			"id": "blog",
			"label": "Blog source"
		},
		{
			"type": "text",
			"id": "event_tag",
			"default": "event",
			"label": "Event tag",
			"info": "Only articles with this tag are shown."
		},
		{
			"type": "range",
			"id": "max_articles",
			"min": 1,
			"max": 12,
			"step": 1,
			"default": 4,
			"label": "Maximum events"
		},
		{
			"type": "text",
			"id": "default_badge",
			"default": "FREE ENTRY",
			"label": "Default badge"
		},
		{
			"type": "text",
			"id": "rsvp_tag",
			"default": "rsvp",
			"label": "RSVP tag"
		},
		{
			"type": "text",
			"id": "rsvp_label",
			"default": "RSVP required",
			"label": "RSVP badge label"
		},
		{
			"type": "checkbox",
			"id": "show_past_events",
			"default": true,
			"label": "Show past events button"
		},
		{
			"type": "url",
			"id": "past_events_link",
			"label": "Past events link"
		},
		{
			"type": "header",
			"content": "t:sections.all.section-margin.header.content"
		},
		{
			"type": "select",
			"id": "margin_top",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-margin.options__5.label"
				}
			],
			"default": "no-indent",
			"label": "t:sections.all.section-margin.margin_top.label"
		},
		{
			"type": "select",
			"id": "margin_bottom",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-margin.options__5.label"
				}
			],
			"default": "l",
			"label": "t:sections.all.section-margin.margin_bottom.label"
		}
	],
	"presets": [
		{
			"name": "Kollab events"
		}
	]
}
{% endschema %}
