{% comment %}
  K-Beauty Workshops custom blog article
  File: sections/k-beauty-workshops-article.liquid
{% endcomment %}

{% assign community_video_1 = section.settings.community_video_1_url
  | default: 'https://cdn.shopify.com/videos/c/o/v/20265625886145829229f6793b68aaa0.mp4'
%}

{% assign community_video_2 = section.settings.community_video_2_url
  | default: 'https://cdn.shopify.com/videos/c/o/v/ed936422249f4a36b7b51ca84a5d7891.mp4'
%}

{% assign community_video_3 = section.settings.community_video_3_url
  | default: 'https://cdn.shopify.com/videos/c/o/v/aca7042906ee4fa9b8ea81058e36c026.mp4'
%}

<section
  id="KBeautyWorkshops-{{ section.id }}"
  class="kbw-article"
  style="
    --kbw-background: {{ section.settings.background_color }};
    --kbw-heading-color: {{ section.settings.heading_color }};
    --kbw-text-color: {{ section.settings.text_color }};
    --kbw-padding-top: {{ section.settings.padding_top }}px;
    --kbw-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {% unless section.settings.show_article_details %}
    <h1 class="kbw-visually-hidden">
      {{ article.title | escape }}
    </h1>
  {% endunless %}

  {% if section.settings.show_article_details %}
    <header class="kbw-article-header">
      <div class="kbw-article-header-inner">
        {% if blog.title != blank %}
          <p class="kbw-blog-name">
            {{ blog.title | escape }}
          </p>
        {% endif %}

        <h1 class="kbw-article-title">
          {{ article.title | escape }}
        </h1>

        {% if section.settings.show_author or section.settings.show_date %}
          <div class="kbw-article-meta">
            {% if section.settings.show_author and article.author != blank %}
              <span>{{ article.author | escape }}</span>
            {% endif %}

            {% if section.settings.show_date and article.published_at != blank %}
              <span>
                {{ article.published_at | date: "%B %d, %Y" }}
              </span>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </header>
  {% endif %}

  <!-- =========================================
       SECTION 1: LEARNING BEYOND THE PRODUCT
  ========================================== -->

  <div class="kbw-main-section">
    <div class="kbw-container kbw-main-grid">

      <div class="kbw-main-content">
        <h2 class="kbw-heading kbw-main-heading">
          {% if section.settings.heading_line_1 != blank %}
            <span>{{ section.settings.heading_line_1 | escape }}</span>
          {% endif %}

          {% if section.settings.heading_line_2 != blank %}
            <span>{{ section.settings.heading_line_2 | escape }}</span>
          {% endif %}
        </h2>

        <div class="kbw-copy">
          {% if section.settings.paragraph_1 != blank %}
            {{ section.settings.paragraph_1 }}
          {% endif %}

          {% if section.settings.paragraph_2 != blank %}
            {{ section.settings.paragraph_2 }}
          {% endif %}

          {% if section.settings.paragraph_3 != blank %}
            {{ section.settings.paragraph_3 }}
          {% endif %}
        </div>
      </div>

      <div class="kbw-main-image-wrapper">
        {% if section.settings.workshops_image != blank %}
          {{
            section.settings.workshops_image
            | image_url: width: 1600
            | image_tag:
              class: 'kbw-main-image',
              loading: 'eager',
              widths: '500, 700, 900, 1200, 1600',
              sizes: '(max-width: 749px) calc(100vw - 40px), 540px',
              alt: section.settings.workshops_image_alt
          }}
        {% else %}
          <img
            src="https://cdn.shopify.com/s/files/1/0588/2088/6577/files/ABOUT_US_13.png?v=1782278123"
            alt="{{ section.settings.workshops_image_alt | escape }}"
            class="kbw-main-image"
            width="1200"
            height="1100"
            loading="eager"
          >
        {% endif %}
      </div>

    </div>
  </div>

  <!-- =========================================
       SECTION 2: BUILDING COMMUNITY
  ========================================== -->

  <div class="kbw-community-section">
    <div class="kbw-container">

      <div class="kbw-community-content">
        <h2 class="kbw-heading kbw-community-heading">
          {{ section.settings.community_heading | escape }}
        </h2>

        <div class="kbw-community-copy">
          {% if section.settings.community_text_1 != blank %}
            {{ section.settings.community_text_1 }}
          {% endif %}

          {% if section.settings.community_text_2 != blank %}
            {{ section.settings.community_text_2 }}
          {% endif %}

          {% if section.settings.community_cta != blank %}
            <div class="kbw-community-cta">
              {{ section.settings.community_cta }}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="kbw-video-grid">

        <!-- Video 1 -->
        <div class="kbw-video-card">
          <video
            class="kbw-community-video"
            controls
            playsinline
            preload="metadata"
            aria-label="{{ section.settings.community_video_1_alt | escape }}"
            {% if section.settings.community_video_loop %}
              loop
            {% endif %}
            {% if section.settings.community_video_1_poster != blank %}
              poster="{{ section.settings.community_video_1_poster | image_url: width: 900 }}"
            {% endif %}
          >
            <source
              src="{{ community_video_1 | escape }}"
              type="video/mp4"
            >
            Your browser does not support the video tag.
          </video>
        </div>

        <!-- Video 2 -->
        <div class="kbw-video-card">
          <video
            class="kbw-community-video"
            controls
            playsinline
            preload="metadata"
            aria-label="{{ section.settings.community_video_2_alt | escape }}"
            {% if section.settings.community_video_loop %}
              loop
            {% endif %}
            {% if section.settings.community_video_2_poster != blank %}
              poster="{{ section.settings.community_video_2_poster | image_url: width: 900 }}"
            {% endif %}
          >
            <source
              src="{{ community_video_2 | escape }}"
              type="video/mp4"
            >
            Your browser does not support the video tag.
          </video>
        </div>

        <!-- Video 3 -->
        <div class="kbw-video-card">
          <video
            class="kbw-community-video"
            controls
            playsinline
            preload="metadata"
            aria-label="{{ section.settings.community_video_3_alt | escape }}"
            {% if section.settings.community_video_loop %}
              loop
            {% endif %}
            {% if section.settings.community_video_3_poster != blank %}
              poster="{{ section.settings.community_video_3_poster | image_url: width: 900 }}"
            {% endif %}
          >
            <source
              src="{{ community_video_3 | escape }}"
              type="video/mp4"
            >
            Your browser does not support the video tag.
          </video>
        </div>

      </div>
    </div>
  </div>

  <!-- =========================================
       OPTIONAL SHOPIFY ARTICLE CONTENT
  ========================================== -->

  {% if section.settings.show_article_content and article.content != blank %}
    <div class="kbw-editor-content">
      <div class="kbw-editor-content-inner rte">
        {{ article.content }}
      </div>
    </div>
  {% endif %}

</section>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap");

  /* =========================================
     GENERAL
  ========================================== */

  #KBeautyWorkshops-{{ section.id }},
  #KBeautyWorkshops-{{ section.id }} * {
    box-sizing: border-box;
  }

  #KBeautyWorkshops-{{ section.id }} {
    position: relative;
    left: 50%;
    width: 100vw;
    max-width: 100vw;
    margin-right: -50vw;
    margin-left: -50vw;
    color: var(--kbw-text-color);
    background-color: var(--kbw-background);
    overflow: hidden;
  }

  #KBeautyWorkshops-{{ section.id }} h1,
  #KBeautyWorkshops-{{ section.id }} h2,
  #KBeautyWorkshops-{{ section.id }} h3,
  #KBeautyWorkshops-{{ section.id }} p,
  #KBeautyWorkshops-{{ section.id }} span,
  #KBeautyWorkshops-{{ section.id }} div,
  #KBeautyWorkshops-{{ section.id }} strong {
    writing-mode: horizontal-tb !important;
    word-break: normal !important;
    overflow-wrap: normal !important;
    hyphens: none !important;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-container {
    width: calc(100% - 80px);
    max-width: 1220px;
    margin: 0 auto;
  }

  /* =========================================
     OPTIONAL ARTICLE HEADER
  ========================================== */

  #KBeautyWorkshops-{{ section.id }} .kbw-article-header {
    width: 100%;
    padding: 55px 40px 15px;
    text-align: center;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-article-header-inner {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-blog-name {
    margin: 0 0 12px;
    color: var(--kbw-text-color);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-article-title {
    margin: 0;
    color: var(--kbw-heading-color);
    font-family: "Instrument Serif", Georgia, serif;
    font-size: clamp(48px, 6vw, 82px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -1px;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-article-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 20px;
    margin-top: 18px;
    color: var(--kbw-text-color);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 14px;
    line-height: 1.4;
  }

  /* =========================================
     SHARED TYPOGRAPHY
  ========================================== */

  #KBeautyWorkshops-{{ section.id }} .kbw-heading {
    margin: 0;
    padding: 0;
    color: var(--kbw-heading-color);
    font-family: "Instrument Serif", Georgia, serif !important;
    font-style: normal;
    font-weight: 400;
    line-height: 1.03;
    letter-spacing: -0.8px;
    text-transform: none;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-copy {
    width: 100%;
    color: var(--kbw-text-color);
    font-family: Arial, Helvetica, sans-serif !important;
    font-size: 19px;
    font-weight: 400;
    line-height: 1.36;
    letter-spacing: 0;
    text-align: left;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-copy p {
    display: block;
    width: 100%;
    margin: 0 0 27px;
    padding: 0;
    color: inherit;
    font: inherit;
    line-height: inherit;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-copy p:last-child {
    margin-bottom: 0;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-copy strong {
    font-weight: 700;
  }

  /* =========================================
     SECTION 1: MAIN WORKSHOP
  ========================================== */

  #KBeautyWorkshops-{{ section.id }} .kbw-main-section {
    width: 100%;
    padding-top: var(--kbw-padding-top);
    padding-bottom: var(--kbw-padding-bottom);
    background-color: var(--kbw-background);
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-main-grid {
    display: grid !important;
    grid-template-columns: minmax(0, 1.08fr) minmax(440px, 0.92fr);
    align-items: center;
    gap: clamp(60px, 7vw, 105px);
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-main-content {
    width: 100%;
    max-width: 620px;
    min-width: 0;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-main-heading {
    margin-bottom: 27px;
    font-size: clamp(44px, 3.7vw, 56px);
    text-align: left;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-main-heading span {
    display: block;
    color: inherit;
    font: inherit;
    line-height: inherit;
    letter-spacing: inherit;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-main-image-wrapper {
    display: flex;
    width: 100%;
    min-width: 0;
    align-items: center;
    justify-content: flex-end;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-main-image {
    display: block !important;
    width: 100% !important;
    max-width: 540px !important;
    height: auto !important;
    max-height: none !important;
    margin: 0 !important;
    border: 0;
    object-fit: contain !important;
    object-position: center !important;
  }

  /* =========================================
     SECTION 2: COMMUNITY
  ========================================== */

  #KBeautyWorkshops-{{ section.id }} .kbw-community-section {
    width: 100%;
    padding: 55px 0 75px;
    background-color: var(--kbw-background);
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-community-content {
    width: 100%;
    max-width: 1030px;
    margin: 0 auto 28px;
    text-align: center;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-community-heading {
    margin-bottom: 23px;
    font-size: clamp(42px, 3.7vw, 54px);
    text-align: center;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-community-copy {
    width: 100%;
    color: var(--kbw-text-color);
    font-family: Arial, Helvetica, sans-serif !important;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.38;
    letter-spacing: 0;
    text-align: center;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-community-copy p {
    width: 100%;
    margin: 0 0 17px;
    padding: 0;
    color: inherit;
    font: inherit;
    line-height: inherit;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-community-copy p:last-child {
    margin-bottom: 0;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-community-copy strong {
    font-weight: 700;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-community-cta {
    margin-top: 20px;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-community-cta p {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.35;
    text-transform: uppercase;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-video-grid {
    display: grid !important;
    width: 100%;
    max-width: 930px;
    margin: 0 auto;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 8px;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-video-card {
    position: relative;
    width: 100%;
    min-width: 0;
    overflow: hidden;
    background-color: #eeeeee;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-community-video {
    display: block !important;
    width: 100% !important;
    height: auto !important;
    aspect-ratio: 9 / 16;
    margin: 0 !important;
    padding: 0 !important;
    background-color: #eeeeee;
    border: 0;
    object-fit: cover;
    object-position: center;
  }

  /* =========================================
     OPTIONAL BLOG EDITOR CONTENT
  ========================================== */

  #KBeautyWorkshops-{{ section.id }} .kbw-editor-content {
    width: 100%;
    padding: 10px 40px 70px;
    background-color: var(--kbw-background);
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-editor-content-inner {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    color: var(--kbw-text-color);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 18px;
    line-height: 1.65;
  }

  #KBeautyWorkshops-{{ section.id }} .kbw-editor-content-inner img {
    display: block;
    max-width: 100%;
    height: auto;
    margin-right: auto;
    margin-left: auto;
  }

  /* =========================================
     TABLET
  ========================================== */

  @media screen and (max-width: 1050px) {
    #KBeautyWorkshops-{{ section.id }} .kbw-container {
      width: calc(100% - 56px);
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-main-grid {
      grid-template-columns: minmax(0, 1fr) minmax(370px, 0.9fr);
      gap: 45px;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-main-heading {
      font-size: 44px;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-copy {
      font-size: 17px;
      line-height: 1.43;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-main-image {
      max-width: 480px !important;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-community-heading {
      font-size: 44px;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-community-copy {
      font-size: 15px;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-video-grid {
      max-width: 810px;
    }
  }

  /* =========================================
     MOBILE
  ========================================== */

  @media screen and (max-width: 749px) {
    #KBeautyWorkshops-{{ section.id }} {
      left: 50%;
      width: 100vw;
      max-width: 100vw;
      margin-right: -50vw;
      margin-left: -50vw;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-container {
      width: calc(100% - 40px);
      max-width: 600px;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-article-header {
      padding: 42px 20px 5px;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-article-title {
      font-size: clamp(42px, 13vw, 62px);
    }

    /* Main workshop mobile */

    #KBeautyWorkshops-{{ section.id }} .kbw-main-section {
      padding-top: 40px;
      padding-bottom: 50px;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-main-grid {
      display: flex !important;
      flex-direction: column;
      align-items: stretch;
      gap: 38px;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-main-content {
      max-width: none;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-main-heading {
      margin-bottom: 27px;
      font-size: clamp(38px, 10vw, 48px);
      line-height: 1.04;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-copy {
      max-width: none;
      font-size: 17px;
      line-height: 1.47;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-copy p {
      margin-bottom: 23px;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-main-image-wrapper {
      justify-content: center;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-main-image {
      width: 100% !important;
      max-width: 550px !important;
    }

    /* Community mobile */

    #KBeautyWorkshops-{{ section.id }} .kbw-community-section {
      padding: 40px 0 50px;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-community-content {
      margin-bottom: 28px;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-community-heading {
      margin-bottom: 22px;
      font-size: clamp(38px, 10vw, 48px);
      line-height: 1.04;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-community-copy {
      font-size: 16px;
      line-height: 1.45;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-community-cta p {
      font-size: 14px;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-video-grid {
      grid-template-columns: 1fr;
      max-width: 380px;
      gap: 18px;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-community-video {
      aspect-ratio: 9 / 16;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-editor-content {
      padding: 10px 20px 50px;
    }
  }

  /* =========================================
     SMALL MOBILE
  ========================================== */

  @media screen and (max-width: 420px) {
    #KBeautyWorkshops-{{ section.id }} .kbw-container {
      width: calc(100% - 32px);
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-main-heading,
    #KBeautyWorkshops-{{ section.id }} .kbw-community-heading {
      font-size: 38px;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-copy,
    #KBeautyWorkshops-{{ section.id }} .kbw-community-copy {
      font-size: 16px;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-main-section {
      padding-top: 34px;
      padding-bottom: 42px;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-community-section {
      padding-top: 34px;
      padding-bottom: 42px;
    }

    #KBeautyWorkshops-{{ section.id }} .kbw-video-grid {
      max-width: 340px;
    }
  }
</style>

{% schema %}
{
  "name": "K-Beauty Workshops",
  "tag": "section",
  "class": "k-beauty-workshops-section",
  "settings": [
    {
      "type": "header",
      "content": "Article information"
    },
    {
      "type": "checkbox",
      "id": "show_article_details",
      "label": "Show blog title and article title",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show publication date",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_article_content",
      "label": "Show content from blog post editor",
      "default": false
    },
    {
      "type": "header",
      "content": "Workshop introduction"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading first line",
      "default": "Learning Beyond the Product:"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading second line",
      "default": "Why We Host K-Beauty Workshops"
    },
    {
      "type": "richtext",
      "id": "paragraph_1",
      "label": "Paragraph one",
      "default": "<p>At KOLLAB, we believe the best way to discover a brand is to experience it firsthand.</p>"
    },
    {
      "type": "richtext",
      "id": "paragraph_2",
      "label": "Paragraph two",
      "default": "<p>That's why workshops and masterclasses have become such an important part of what we do. Beyond introducing products, these events create opportunities for deeper learning, meaningful conversations, and genuine connections between brands and consumers.</p>"
    },
    {
      "type": "richtext",
      "id": "paragraph_3",
      "label": "Paragraph three",
      "default": "<p>As K-beauty continues to grow globally, we want to create spaces where people can learn directly from industry experts, explore the techniques behind Korean beauty trends, and gain hands-on experience with products in a way that goes beyond traditional retail.</p>"
    },
    {
      "type": "image_picker",
      "id": "workshops_image",
      "label": "Workshop image"
    },
    {
