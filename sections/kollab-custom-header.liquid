{% liquid
	assign kollab_categories = 'Moisturizers|Cleansers & Exfoliators|Serums & Essence|Masks & Treatments|Eye Care|Primer & Makeup|Lip Care|SPF|Body Care|Blotting Papers & Tools' | split: '|'
	assign kollab_shop_collection = collections.all

	assign kollab_cat_blocks = section.blocks | where: 'type', 'category'
	assign kollab_brand_blocks = section.blocks | where: 'type', 'brand'
%}
{%- capture kollab_media_flags -%}
	{%- for kollab_block in section.blocks -%}
		{%- assign kollab_probe = kollab_block.settings.image -%}
		{%- if kollab_probe == blank and kollab_block.settings.link contains '/collections/' -%}
			{%- assign kollab_handle = kollab_block.settings.link | split: '/collections/' | last | split: '?' | first | split: '/' | first -%}
			{%- assign kollab_probe = collections[kollab_handle].image -%}
		{%- endif -%}
		{%- if kollab_probe != blank -%}1{%- endif -%}
	{%- endfor -%}
{%- endcapture -%}
{%- assign kollab_mega_media = kollab_media_flags | strip | size -%}

<style>
	.kollab-header {
		position: relative;
		z-index: 50;
		background: #ffffff;
		border-bottom: 1px solid rgba(0, 0, 0, 0.26);
		color: #111111;
		font-family: Arial, Helvetica, sans-serif;
	}

	.kollab-header,
	.kollab-header * {
		box-sizing: border-box;
	}

	.kollab-header__inner {
		min-height: 50px;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 34px;
		padding: 0 44px;
	}

	.kollab-header__logo {
		display: inline-flex;
		align-items: center;
		color: #000000;
		font-size: 25px;
		font-weight: 900;
		line-height: 1;
		letter-spacing: -0.02em;
		text-decoration: none;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.kollab-header__logo img {
		width: auto;
		max-width: {{ section.settings.logo_width }}px;
		max-height: 32px;
		display: block;
		object-fit: contain;
	}

	.kollab-header__nav {
		display: flex;
		align-items: center;
		gap: 30px;
		min-width: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.kollab-header__menu-toggle {
		display: none;
		width: 38px;
		height: 38px;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		padding: 0;
		background: transparent;
		border: 0;
		color: #f12c18;
		cursor: pointer;
	}

	.kollab-header__menu-toggle span,
	.kollab-header__menu-toggle::before,
	.kollab-header__menu-toggle::after {
		content: "";
		display: block;
		width: 24px;
		height: 2px;
		background: currentColor;
		transition: transform 180ms ease, opacity 180ms ease;
	}

	.kollab-header__menu-toggle span {
		margin: 5px 0;
	}

	.kollab-header.is-menu-open .kollab-header__menu-toggle::before {
		transform: translateY(7px) rotate(45deg);
	}

	.kollab-header.is-menu-open .kollab-header__menu-toggle span {
		opacity: 0;
	}

	.kollab-header.is-menu-open .kollab-header__menu-toggle::after {
		transform: translateY(-7px) rotate(-45deg);
	}

	.kollab-header__item {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 50px;
	}

	.kollab-header__link {
		display: inline-flex;
		align-items: center;
		min-height: 50px;
		color: #f12c18;
		font-size: 22px;
		font-weight: 400;
		line-height: 1;
		letter-spacing: 0;
		text-decoration: none;
		white-space: nowrap;
	}

	.kollab-header__item:hover > .kollab-header__link,
	.kollab-header__item:focus-within > .kollab-header__link,
	.kollab-header__link:hover,
	.kollab-header__link:focus-visible {
		color: #4a4a4a;
		outline: 0;
	}

	.kollab-header__actions {
		display: inline-flex;
		align-items: center;
		justify-content: flex-end;
		gap: 22px;
	}

	.kollab-header__icon {
		position: relative;
		width: 22px;
		height: 22px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: #f12c18;
		text-decoration: none;
	}

	.kollab-header__icon svg {
		width: 21px;
		height: 21px;
		display: block;
		stroke: currentColor;
	}

	.kollab-header__cart-count {
		position: absolute;
		top: -9px;
		right: -11px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 17px;
		height: 17px;
		padding: 0 5px;
		background: #f12c18;
		color: #ffffff;
		border-radius: 999px;
		font-size: 10px;
		font-weight: 700;
		line-height: 1;
	}

	.kollab-header__cart-count[hidden] {
		display: none;
	}

	.kollab-header__dropdown,
	.kollab-header__mega {
		position: absolute;
		top: 100%;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transform: translateY(0);
		transition: opacity 160ms ease, visibility 160ms ease;
	}

	.kollab-header__item:hover .kollab-header__dropdown,
	.kollab-header__item:focus-within .kollab-header__dropdown,
	.kollab-header__item:hover .kollab-header__mega,
	.kollab-header__item:focus-within .kollab-header__mega {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
	}

	.kollab-header__dropdown {
		left: 0;
		width: 320px;
		padding: 32px 36px 34px;
		background: #f7f6f2;
		border-top: 1px solid rgba(0, 0, 0, 0.08);
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
	}

	.kollab-header__dropdown-list,
	.kollab-header__mega-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.kollab-header__dropdown-list {
		display: grid;
		gap: 18px;
	}

	.kollab-header__dropdown-link {
		display: inline-flex;
		width: max-content;
		max-width: 100%;
		color: #2a2a2a;
		font-family: "ENKEL", "Enkel", Georgia, serif !important;
		font-size: 22px;
		font-weight: 400;
		line-height: 1.12;
		text-decoration: none;
		letter-spacing: 0;
		white-space: nowrap;
		transition: color 160ms ease, transform 160ms ease;
	}

	.kollab-header__dropdown-link:hover,
	.kollab-header__dropdown-link:focus-visible {
		color: #f12c18;
		transform: translateX(4px);
		outline: 0;
	}

	.kollab-header__mega {
		left: 0;
		width: min(760px, calc(100vw - 48px));
		padding: 38px 44px 42px;
		background: #f7f6f2;
		border-top: 1px solid rgba(0, 0, 0, 0.08);
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
		transform: none;
	}

	.kollab-header__mega-inner {
		display: grid;
		grid-template-columns: minmax(260px, 1.2fr) minmax(210px, 0.8fr);
		gap: 76px;
		align-items: start;
	}

	.kollab-header__mega-title {
		margin: 0 0 22px;
		color: #222222;
		font-family: "ENKEL", "Enkel", Georgia, serif !important;
		font-size: 22px;
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: 0;
	}

	.kollab-header__mega-list {
		display: grid;
		gap: 18px;
	}

	.kollab-header__mega-link {
		display: inline-flex;
		width: max-content;
		max-width: 100%;
		color: #2a2a2a;
		font-family: "ENKEL", "Enkel", Georgia, serif !important;
		font-size: 22px;
		font-weight: 400;
		line-height: 1.12;
		text-decoration: none;
		letter-spacing: 0;
		transition: color 160ms ease, transform 160ms ease;
	}

	.kollab-header__mega-link:hover,
	.kollab-header__mega-link:focus-visible {
		color: #f12c18;
		transform: translateX(4px);
		outline: 0;
	}

	.kollab-header__mega-link.is-cycling {
		color: #f12c18;
	}

	.kollab-header__submenu-toggle,
	.kollab-header__mega-tabs,
	.kollab-header__mega-all {
		display: none;
	}

	.kollab-header__mega.has-media {
		width: min(1120px, calc(100vw - 48px));
	}

	.kollab-header__mega.has-media .kollab-header__mega-inner {
		grid-template-columns: minmax(210px, 1fr) minmax(180px, 0.82fr) minmax(250px, 1.05fr);
		gap: 48px;
	}

	.kollab-header__mega-media {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: #111111;
	}

	.kollab-header__mega-media-item {
		position: absolute;
		inset: 0;
		opacity: 0;
		transform: scale(1.045);
		transition: opacity 400ms ease, transform 620ms ease;
		pointer-events: none;
	}

	.kollab-header__mega-media-item.is-active {
		opacity: 1;
		transform: scale(1);
	}

	.kollab-header__mega-media-item img {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: {{ section.settings.preview_fit }};
	}

	.kollab-header__mega-media[data-fit="contain"] {
		background: #f7f6f2;
	}

	.kollab-header__mega-media::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0) 55%, rgba(0, 0, 0, 0.42) 100%);
		pointer-events: none;
		z-index: 2;
	}

	.kollab-header__mega-media-caption {
		position: absolute;
		left: 16px;
		bottom: 14px;
		z-index: 3;
		color: #ffffff;
		font-family: "ENKEL", "Enkel", Georgia, serif;
		font-size: 15px;
		line-height: 1.2;
		text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
		opacity: 0;
		transition: opacity 260ms ease;
	}

	.kollab-header__mega-media-caption.is-visible {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.kollab-header__mega-media-item {
			transition: opacity 120ms ease;
			transform: none;
		}
	}

	.kollab-cart-drawer {
		position: fixed;
		inset: 0;
		z-index: 200;
		display: none;
		width: 100vw;
		height: 100vh;
		pointer-events: none;
	}

	.kollab-cart-drawer.is-open {
		display: block;
		pointer-events: auto;
	}

	.kollab-cart-drawer__overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.46);
		opacity: 0;
		transition: opacity 180ms ease;
	}

	.kollab-cart-drawer.is-open .kollab-cart-drawer__overlay {
		opacity: 1;
	}

	.kollab-cart-drawer__panel {
		position: fixed;
		top: 0;
		right: 0;
		display: flex;
		flex-direction: column;
		width: min(430px, 100vw);
		height: 100vh;
		max-height: 100vh;
		background: #ffffff !important;
		color: #111111 !important;
		box-shadow: -18px 0 46px rgba(0, 0, 0, 0.18);
		transform: translateX(100%);
		transition: transform 220ms ease;
		overflow: hidden;
	}

	.kollab-cart-drawer.is-open .kollab-cart-drawer__panel {
		transform: translateX(0);
	}

	.kollab-cart-drawer__header,
	.kollab-cart-drawer__footer {
		flex: 0 0 auto;
		padding: 22px 24px;
	}

	.kollab-cart-drawer__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		border-bottom: 1px solid rgba(0, 0, 0, 0.14);
	}

	.kollab-cart-drawer__title {
		margin: 0;
		color: #111111;
		font-size: 20px;
		font-weight: 800;
		line-height: 1.1;
	}

	.kollab-cart-drawer__close {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		padding: 0;
		background: #111111;
		color: #ffffff;
		border: 0;
		border-radius: 50%;
		font-size: 22px;
		line-height: 1;
		cursor: pointer;
	}

	.kollab-cart-drawer__body {
		flex: 1 1 auto;
		min-height: 0;
		overflow-y: auto;
		padding: 0 24px;
		background: #ffffff;
	}

	.kollab-cart-drawer__empty,
	.kollab-cart-drawer__loading {
		margin: 28px 0;
		color: #111111;
		font-size: 14px;
		line-height: 1.45;
	}

	.kollab-cart-drawer__items {
		display: grid;
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.kollab-cart-drawer__item {
		display: grid;
		grid-template-columns: 82px minmax(0, 1fr);
		gap: 14px;
		padding: 18px 0;
		border-bottom: 1px solid rgba(0, 0, 0, 0.12);
	}

	.kollab-cart-drawer__image {
		width: 82px;
		aspect-ratio: 1;
		background: #f4f4f4;
		object-fit: cover;
	}

	.kollab-cart-drawer__item-title {
		margin: 0 0 7px;
		color: #111111;
		font-size: 14px;
		font-weight: 800;
		line-height: 1.25;
	}

	.kollab-cart-drawer__meta,
	.kollab-cart-drawer__qty {
		margin: 0;
		color: rgba(0, 0, 0, 0.66);
		font-size: 12px;
		line-height: 1.35;
	}

	.kollab-cart-drawer__line {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-top: 10px;
	}

	.kollab-cart-drawer__price {
		color: #111111;
		font-size: 14px;
		font-weight: 700;
	}

	.kollab-cart-drawer__remove {
		padding: 0;
		background: transparent;
		color: #f12c18;
		border: 0;
		font-size: 12px;
		text-decoration: underline;
		cursor: pointer;
	}

	.kollab-cart-drawer__footer {
		border-top: 1px solid rgba(0, 0, 0, 0.14);
	}

	.kollab-cart-drawer__subtotal {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 14px;
		margin-bottom: 16px;
		color: #111111;
		font-size: 16px;
		font-weight: 800;
	}

	.kollab-cart-drawer__checkout,
	.kollab-cart-drawer__view-cart {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		min-height: 44px;
		text-decoration: none;
	}

	.kollab-cart-drawer__checkout {
		background: #111111;
		color: #ffffff;
		border: 1px solid #111111;
		font-size: 13px;
		font-weight: 800;
		text-transform: uppercase;
	}

	.kollab-cart-drawer__view-cart {
		margin-top: 10px;
		background: #ffffff;
		color: #111111;
		border: 1px solid rgba(0, 0, 0, 0.28);
		font-size: 13px;
		font-weight: 700;
	}

	@media screen and (max-width: 900px) {
		.kollab-header {
			position: sticky;
			top: 0;
			z-index: 80;
		}

		.kollab-header__menu-toggle {
			display: none;
		}

		.kollab-header__inner {
			position: static;
			grid-template-columns: auto minmax(0, 1fr);
			align-items: center;
			gap: 12px;
			min-height: 52px;
			padding: 0 16px;
		}

		.kollab-header__logo {
			order: 1;
			justify-self: start;
		}

		.kollab-header__actions {
			order: 2;
			justify-self: end;
			gap: 16px;
		}

		.kollab-header__nav-wrap {
			position: static;
			display: block;
			max-height: none;
			overflow: visible;
			background: #ffffff;
			border-top: 1px solid rgba(0, 0, 0, 0.12);
			border-bottom: 0;
			box-shadow: none;
		}

		.kollab-header__nav {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 0;
			padding: 0;
		}

		.kollab-header__item {
			position: static;
			display: flex;
			align-items: center;
			justify-content: center;
			min-height: 46px;
			border-bottom: 0;
		}

		.kollab-header__link {
			width: auto;
			min-height: 46px;
			padding: 0 2px;
			align-items: center;
			justify-content: center;
			font-size: 15px;
			border-bottom: 2px solid transparent;
		}

		.kollab-header__item.is-expanded > .kollab-header__link {
			color: #111111;
			border-bottom-color: #f12c18;
		}

		.kollab-header__submenu-toggle {
			position: static;
			width: 18px;
			height: 46px;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			padding: 0;
			background: transparent;
			border: 0;
			border-bottom: 2px solid transparent;
			color: #f12c18;
			cursor: pointer;
		}

		.kollab-header__item.is-expanded .kollab-header__submenu-toggle {
			border-bottom-color: #f12c18;
		}

		.kollab-header__submenu-toggle::after {
			content: "";
			width: 6px;
			height: 6px;
			border-right: 2px solid currentColor;
			border-bottom: 2px solid currentColor;
			transform: translateY(-2px) rotate(45deg);
			transition: transform 180ms ease;
		}

		.kollab-header__item.is-expanded .kollab-header__submenu-toggle::after {
			transform: translateY(1px) rotate(-135deg);
		}

		.kollab-header__dropdown,
		.kollab-header__mega {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			width: 100%;
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
			transform: none;
		}

		.kollab-header__dropdown {
			display: none;
			padding: 16px;
			background: #ffffff;
		}

		.kollab-header__mega,
		.kollab-header__mega.has-media {
			display: none;
			width: 100%;
			max-height: calc(100vh - 104px);
			overflow-y: auto;
			padding: 16px 16px 24px;
			background: #ffffff;
			border-top: 1px solid rgba(0, 0, 0, 0.12);
			box-shadow: 0 18px 34px rgba(0, 0, 0, 0.14);
		}

		.kollab-header__item.is-expanded > .kollab-header__mega {
			display: block;
		}

		.kollab-header__mega-inner,
		.kollab-header__mega.has-media .kollab-header__mega-inner {
			width: 100%;
			display: flex;
			flex-direction: column;
			gap: 0;
		}

		.kollab-header__mega-tabs {
			order: 1;
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 10px;
			margin: 0 0 18px;
		}

		.kollab-header__mega-tab {
			min-height: 52px;
			padding: 14px 8px;
			background: #ffffff;
			border: 1px solid rgba(0, 0, 0, 0.2);
			color: #111111;
			font-family: inherit;
			font-size: 13px;
			font-weight: 600;
			letter-spacing: 0.1em;
			line-height: 1.2;
			text-transform: uppercase;
			cursor: pointer;
			transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
		}

		.kollab-header__mega-tab.is-active {
			background: #f12c18;
			border-color: #f12c18;
			color: #ffffff;
			font-weight: 700;
		}

		.kollab-header__mega-title {
			display: none;
		}

		.kollab-header__mega-col {
			order: 2;
			display: none;
		}

		.kollab-header__mega-col.is-active {
			display: block;
		}

		.kollab-header__mega-media {
			order: 0;
			display: block;
			aspect-ratio: 16 / 9;
			margin: 0 0 14px;
		}

		.kollab-header__mega-all {
			display: block;
			padding-bottom: 12px;
			margin-bottom: 4px;
			border-bottom: 1px solid rgba(0, 0, 0, 0.1);
		}

		.kollab-header__mega-all .kollab-header__mega-link {
			font-weight: 700;
		}

		.kollab-header__dropdown-list {
			gap: 12px;
		}

		.kollab-header__mega-list {
			gap: 14px;
		}

		.kollab-header__dropdown-link,
		.kollab-header__mega-link {
			color: #2a2a2a;
			font-size: 17px;
		}
	}
</style>

<header class="kollab-header">
	<div class="kollab-header__inner">
		<button class="kollab-header__menu-toggle" type="button" aria-label="Open menu" aria-controls="KollabMobileMenu" aria-expanded="false">
			<span aria-hidden="true"></span>
		</button>

		<a class="kollab-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
			{%- if section.settings.logo != blank -%}
				{{ section.settings.logo | image_url: width: 320 | image_tag: loading: 'eager', alt: shop.name }}
			{%- else -%}
				Kollab
			{%- endif -%}
		</a>

		<nav class="kollab-header__nav-wrap" id="KollabMobileMenu" aria-label="Main navigation">
			<ul class="kollab-header__nav">
				<li class="kollab-header__item">
					<a class="kollab-header__link" href="{{ routes.all_products_collection_url }}" aria-haspopup="true">Shop</a>
					<button class="kollab-header__submenu-toggle" type="button" aria-label="Show Shop menu" aria-expanded="false" data-kollab-submenu-toggle></button>
					<div class="kollab-header__mega{% if kollab_mega_media > 0 %} has-media{% endif %}" aria-label="Shop submenu" data-kollab-mega>
						<div class="kollab-header__mega-inner">
							<div class="kollab-header__mega-tabs" role="tablist">
								<button class="kollab-header__mega-tab is-active" type="button" role="tab" aria-selected="true" data-mega-tab="category">{{ section.settings.category_heading | default: 'Category' }}</button>
								<button class="kollab-header__mega-tab" type="button" role="tab" aria-selected="false" data-mega-tab="brand">{{ section.settings.brand_heading | default: 'Brands' }}</button>
							</div>

							<div class="kollab-header__mega-col is-active" data-mega-col="category">
								<h2 class="kollab-header__mega-title">{{ section.settings.category_heading | default: 'Category' }}</h2>
								<ul class="kollab-header__mega-list">
									<li class="kollab-header__mega-all">
										<a class="kollab-header__mega-link" href="{{ routes.all_products_collection_url }}">All products</a>
									</li>
									{%- if kollab_cat_blocks.size > 0 -%}
										{%- for block in kollab_cat_blocks -%}
											<li {{ block.shopify_attributes }}>
												<a class="kollab-header__mega-link" href="{{ block.settings.link | default: routes.all_products_collection_url }}" data-mega-key="{{ block.id }}">{{ block.settings.label }}</a>
											</li>
										{%- endfor -%}
									{%- else -%}
										{%- for category in kollab_categories -%}
											<li>
												<a class="kollab-header__mega-link" href="{{ routes.all_products_collection_url }}/{{ category | handleize }}">{{ category }}</a>
											</li>
										{%- endfor -%}
									{%- endif -%}
								</ul>
							</div>

							<div class="kollab-header__mega-col" data-mega-col="brand">
								<h2 class="kollab-header__mega-title">{{ section.settings.brand_heading | default: 'Brands' }}</h2>
								<ul class="kollab-header__mega-list">
									{%- if kollab_brand_blocks.size > 0 -%}
										{%- for block in kollab_brand_blocks -%}
											<li {{ block.shopify_attributes }}>
												<a class="kollab-header__mega-link" href="{{ block.settings.link | default: routes.all_products_collection_url }}" data-mega-key="{{ block.id }}">{{ block.settings.label }}</a>
											</li>
										{%- endfor -%}
									{%- elsif kollab_shop_collection.all_vendors.size > 0 -%}
										{%- for vendor in kollab_shop_collection.all_vendors limit: 8 -%}
											<li>
												<a class="kollab-header__mega-link" href="/collections/vendors?q={{ vendor | url_encode }}">{{ vendor }}</a>
											</li>
										{%- endfor -%}
									{%- else -%}
										<li><a class="kollab-header__mega-link" href="{{ routes.all_products_collection_url }}">All Brands</a></li>
									{%- endif -%}
								</ul>
							</div>

							{%- if kollab_mega_media > 0 -%}
								<div class="kollab-header__mega-media" data-kollab-mega-media data-fit="{{ section.settings.preview_fit }}">
									{%- for block in section.blocks -%}
										{%- liquid
											assign media_src = block.settings.image
											if media_src == blank and block.settings.link contains '/collections/'
												assign media_handle = block.settings.link | split: '/collections/' | last | split: '?' | first | split: '/' | first
												assign media_src = collections[media_handle].image
											endif
											assign media_alt = block.settings.label
											if media_alt == blank
												assign media_alt = media_src.alt
											endif
											assign media_alt = media_alt | escape
										-%}
										{%- if media_src != blank -%}
											<div class="kollab-header__mega-media-item" data-media-key="{{ block.id }}" data-media-group="{{ block.type }}" data-media-label="{{ block.settings.label | escape }}">
												{{ media_src | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,700,900', sizes: '320px', alt: media_alt }}
											</div>
										{%- endif -%}
									{%- endfor -%}
									<span class="kollab-header__mega-media-caption" data-kollab-mega-caption></span>
								</div>
							{%- endif -%}
						</div>
					</div>
				</li>

				<li class="kollab-header__item">
					<a class="kollab-header__link" href="/pages/events">Events</a>
				</li>
				<li class="kollab-header__item">
					<a class="kollab-header__link" href="{{ routes.root_url }}blogs/event">Blog</a>
				</li>
				<li class="kollab-header__item">
					<a class="kollab-header__link" href="/pages/skoop-marketing" aria-haspopup="true">About</a>
				</li>
			</ul>
		</nav>

		<div class="kollab-header__actions" aria-label="Header actions">
			<a class="kollab-header__icon" href="{{ routes.search_url }}" aria-label="Search">
				<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<circle cx="10.75" cy="10.75" r="6.75" stroke-width="1.8"></circle>
					<path d="M15.75 15.75L21 21" stroke-width="1.8" stroke-linecap="round"></path>
				</svg>
			</a>
			<a class="kollab-header__icon" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="Account">
				<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<circle cx="12" cy="7.5" r="3.5" stroke-width="1.8"></circle>
					<path d="M5 21C5.7 16.8 8.25 14.75 12 14.75C15.75 14.75 18.3 16.8 19 21" stroke-width="1.8" stroke-linecap="round"></path>
				</svg>
			</a>
			<a class="kollab-header__icon kollab-header__cart" href="{{ routes.cart_url }}" id="cart-icon-bubble" aria-label="{{ 'accessibility.cart_link' | t }}" data-kollab-cart-open>
				<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="M6.5 8.25H17.5L18.35 21H5.65L6.5 8.25Z" stroke-width="1.8" stroke-linejoin="round"></path>
					<path d="M9 8.25V6C9 4.35 10.35 3 12 3C13.65 3 15 4.35 15 6V8.25" stroke-width="1.8" stroke-linecap="round"></path>
				</svg>
				<span class="kollab-header__cart-count" {% if cart.item_count == 0 %}hidden{% endif %}>
					{%- if cart.item_count < 100 -%}
						{{ cart.item_count }}
					{%- else -%}
						99+
					{%- endif -%}
				</span>
			</a>
		</div>
	</div>
</header>

<div class="kollab-cart-drawer" data-kollab-cart-drawer hidden>
	<div class="kollab-cart-drawer__overlay" data-kollab-cart-close></div>
	<aside class="kollab-cart-drawer__panel" aria-label="Cart drawer" aria-modal="true" role="dialog" tabindex="-1">
		<div class="kollab-cart-drawer__header">
			<h2 class="kollab-cart-drawer__title">Your Cart</h2>
			<button class="kollab-cart-drawer__close" type="button" aria-label="Close cart" data-kollab-cart-close>&times;</button>
		</div>
		<div class="kollab-cart-drawer__body" data-kollab-cart-body>
			{% if cart.item_count > 0 %}
				<ul class="kollab-cart-drawer__items">
					{% for item in cart.items %}
						<li class="kollab-cart-drawer__item">
							{% if item.image != blank %}
								{{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', class: 'kollab-cart-drawer__image', alt: item.product.title }}
							{% else %}
								<span class="kollab-cart-drawer__image" aria-hidden="true"></span>
							{% endif %}
							<div>
								<p class="kollab-cart-drawer__item-title">{{ item.product.title }}</p>
								{% if item.variant.title != blank and item.variant.title != 'Default Title' %}
									<p class="kollab-cart-drawer__meta">{{ item.variant.title }}</p>
								{% endif %}
								<p class="kollab-cart-drawer__qty">Qty: {{ item.quantity }}</p>
								<div class="kollab-cart-drawer__line">
									<span class="kollab-cart-drawer__price">{{ item.final_line_price | money }}</span>
									<button class="kollab-cart-drawer__remove" type="button" data-kollab-cart-remove="{{ item.key | escape }}">Remove</button>
								</div>
							</div>
						</li>
					{% endfor %}
				</ul>
			{% else %}
				<p class="kollab-cart-drawer__empty">Your cart is empty.</p>
			{% endif %}
		</div>
		<div class="kollab-cart-drawer__footer">
			<div class="kollab-cart-drawer__subtotal">
				<span>Subtotal</span>
				<span data-kollab-cart-subtotal>{{ cart.total_price | money }}</span>
			</div>
			<a class="kollab-cart-drawer__checkout" href="/checkout">Checkout</a>
			<a class="kollab-cart-drawer__view-cart" href="{{ routes.cart_url }}">View Cart</a>
		</div>
	</aside>
</div>

<script>
	(function () {
		var header = document.querySelector(".kollab-header");

		if (!header) {
			return;
		}

		var toggle = header.querySelector(".kollab-header__menu-toggle");
		var menu = header.querySelector("#KollabMobileMenu");

		if (!toggle || !menu) {
			return;
		}

		function setMenuState(isOpen) {
			header.classList.toggle("is-menu-open", isOpen);
			toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
			toggle.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
		}

		toggle.addEventListener("click", function () {
			setMenuState(!header.classList.contains("is-menu-open"));
		});

		menu.addEventListener("click", function (event) {
			if (event.target.closest("a")) {
				setMenuState(false);
			}
		});

		document.addEventListener("keydown", function (event) {
			if (event.key === "Escape") {
				setMenuState(false);
			}
		});

		document.addEventListener("click", function (event) {
			if (!header.contains(event.target)) {
				setMenuState(false);
			}
		});
	}());

	(function () {
		var drawer = document.querySelector("[data-kollab-cart-drawer]");
		var openButton = document.querySelector("[data-kollab-cart-open]");
		var body = document.querySelector("[data-kollab-cart-body]");
		var subtotal = document.querySelector("[data-kollab-cart-subtotal]");
		var countBubble = document.querySelector(".kollab-header__cart-count");
		var panel = drawer ? drawer.querySelector(".kollab-cart-drawer__panel") : null;
		var initialBodyHtml = body ? body.innerHTML : "";

		if (!drawer || !openButton || !body) {
			return;
		}

		function formatMoney(cents, currency) {
			var amount = Number(cents || 0) / 100;

			try {
				return new Intl.NumberFormat(undefined, {
					style: "currency",
					currency: currency || "{{ cart.currency.iso_code | default: shop.currency }}"
				}).format(amount);
			} catch (error) {
				return "$" + amount.toFixed(2);
			}
		}

		function escapeHtml(value) {
			return String(value || "")
				.replace(/&/g, "&amp;")
				.replace(/</g, "&lt;")
				.replace(/>/g, "&gt;")
				.replace(/"/g, "&quot;")
				.replace(/'/g, "&#039;");
		}

		function updateCount(count) {
			if (!countBubble) return;

			if (count > 0) {
				countBubble.hidden = false;
				countBubble.textContent = count < 100 ? String(count) : "99+";
			} else {
				countBubble.hidden = true;
				countBubble.textContent = "";
			}
		}

		function renderCart(cart) {
			updateCount(cart.item_count || 0);

			if (subtotal) {
				subtotal.textContent = formatMoney(cart.total_price, cart.currency);
			}

			if (!cart.items || cart.items.length === 0) {
				body.innerHTML = '<p class="kollab-cart-drawer__empty">Your cart is empty.</p>';
				return;
			}

			body.innerHTML = '<ul class="kollab-cart-drawer__items">' + cart.items.map(function (item) {
				var image = item.image
					? '<img class="kollab-cart-drawer__image" src="' + escapeHtml(item.image) + '" alt="' + escapeHtml(item.product_title) + '" loading="lazy">'
					: '<span class="kollab-cart-drawer__image" aria-hidden="true"></span>';
				var variant = item.variant_title && item.variant_title !== "Default Title"
					? '<p class="kollab-cart-drawer__meta">' + escapeHtml(item.variant_title) + '</p>'
					: "";

				return '<li class="kollab-cart-drawer__item">' +
					image +
					'<div>' +
						'<p class="kollab-cart-drawer__item-title">' + escapeHtml(item.product_title) + '</p>' +
						variant +
						'<p class="kollab-cart-drawer__qty">Qty: ' + item.quantity + '</p>' +
						'<div class="kollab-cart-drawer__line">' +
							'<span class="kollab-cart-drawer__price">' + formatMoney(item.final_line_price, cart.currency) + '</span>' +
							'<button class="kollab-cart-drawer__remove" type="button" data-kollab-cart-remove="' + escapeHtml(item.key) + '">Remove</button>' +
						'</div>' +
					'</div>' +
				'</li>';
			}).join("") + '</ul>';
		}

		function fetchCart() {
			if (!body.innerHTML.trim()) {
				body.innerHTML = '<p class="kollab-cart-drawer__loading">Loading cart...</p>';
			}

			return fetch("{{ routes.cart_url }}.js", {
				headers: { "Accept": "application/json" }
			})
				.then(function (response) {
					if (!response.ok) throw new Error("Cart request failed");
					return response.json();
				})
				.then(renderCart)
				.catch(function () {
					body.innerHTML = initialBodyHtml || '<p class="kollab-cart-drawer__empty">Cart could not load. You can still open the full cart page.</p>';
				});
		}

		function openDrawer() {
			drawer.hidden = false;
			requestAnimationFrame(function () {
				drawer.classList.add("is-open");
				if (panel) panel.focus();
			});
			document.documentElement.style.overflow = "hidden";
			fetchCart();
		}

		function closeDrawer() {
			drawer.classList.remove("is-open");
			document.documentElement.style.overflow = "";
			window.setTimeout(function () {
				if (!drawer.classList.contains("is-open")) {
					drawer.hidden = true;
				}
			}, 220);
		}

		openButton.addEventListener("click", function (event) {
			event.preventDefault();
			openDrawer();
		});

		drawer.addEventListener("click", function (event) {
			var close = event.target.closest("[data-kollab-cart-close]");
			var remove = event.target.closest("[data-kollab-cart-remove]");

			if (close) {
				closeDrawer();
				return;
			}

			if (remove) {
				remove.disabled = true;
				fetch("{{ routes.cart_url }}/change.js", {
					method: "POST",
					headers: {
						"Content-Type": "application/json",
						"Accept": "application/json"
					},
					body: JSON.stringify({
						id: remove.getAttribute("data-kollab-cart-remove"),
						quantity: 0
					})
				})
					.then(function (response) {
						if (!response.ok) throw new Error("Cart update failed");
						return response.json();
					})
					.then(renderCart)
					.catch(fetchCart);
			}
		});

		document.addEventListener("keydown", function (event) {
			if (event.key === "Escape" && drawer.classList.contains("is-open")) {
				closeDrawer();
			}
		});
	}());

	(function () {
		var mega = document.querySelector("[data-kollab-mega]");

		if (!mega) {
			return;
		}

		var media = mega.querySelector("[data-kollab-mega-media]");

		if (!media) {
			return;
		}

		var items = Array.prototype.slice.call(media.querySelectorAll("[data-media-key]"));
		var caption = media.querySelector("[data-kollab-mega-caption]");
		var links = Array.prototype.slice.call(mega.querySelectorAll("[data-mega-key]"));

		if (items.length === 0) {
			return;
		}

		var reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		var loopTimer = null;
		var loopStart = 0;
		var loopIndex = 0;

		var FAST_MS = 110;
		var SLOW_MS = 1150;
		var RAMP_FROM = 2000;
		var RAMP_TO = 3400;

		function intervalAt(elapsed) {
			if (elapsed <= RAMP_FROM) {
				return FAST_MS;
			}

			if (elapsed >= RAMP_TO) {
				return SLOW_MS;
			}

			var t = (elapsed - RAMP_FROM) / (RAMP_TO - RAMP_FROM);
			var eased = 1 - Math.pow(1 - t, 2);

			return FAST_MS + (SLOW_MS - FAST_MS) * eased;
		}

		function activate(index) {
			var current = items[index];

			if (!current) {
				return;
			}

			items.forEach(function (entry, i) {
				entry.classList.toggle("is-active", i === index);
			});

			var key = current.getAttribute("data-media-key");

			links.forEach(function (link) {
				link.classList.toggle("is-cycling", link.getAttribute("data-mega-key") === key);
			});

			if (caption) {
				caption.textContent = current.getAttribute("data-media-label") || "";
				caption.classList.add("is-visible");
			}
		}

		function indexForKey(key) {
			for (var i = 0; i < items.length; i++) {
				if (items[i].getAttribute("data-media-key") === key) {
					return i;
				}
			}

			return -1;
		}

		function stopLoop() {
			if (loopTimer) {
				window.clearTimeout(loopTimer);
				loopTimer = null;
			}
		}

		function tick() {
			activate(loopIndex % items.length);
			loopIndex++;
			loopTimer = window.setTimeout(tick, intervalAt(Date.now() - loopStart));
		}

		function startLoop() {
			stopLoop();

			if (reduceMotion || items.length < 2) {
				activate(0);
				return;
			}

			loopStart = Date.now();
			loopIndex = 0;
			tick();
		}

		activate(0);

		var shopItem = mega.closest(".kollab-header__item");
		var inner = mega.querySelector(".kollab-header__mega-inner");

		if (shopItem) {
			shopItem.addEventListener("mouseenter", startLoop);
			shopItem.addEventListener("mouseleave", stopLoop);
		}

		if (inner) {
			inner.addEventListener("mouseleave", startLoop);
		}

		links.forEach(function (link) {
			function pin() {
				var index = indexForKey(link.getAttribute("data-mega-key"));

				if (index === -1) {
					return;
				}

				stopLoop();
				activate(index);
			}

			link.addEventListener("mouseenter", pin);
			link.addEventListener("focus", pin);
		});

		window.kollabMega = {
			start: startLoop,
			stop: stopLoop,
			showGroup: function (group) {
				for (var i = 0; i < items.length; i++) {
					if (items[i].getAttribute("data-media-group") === group) {
						stopLoop();
						activate(i);
						return;
					}
				}
			}
		};
	}());

	(function () {
		var item = document.querySelector("[data-kollab-submenu-toggle]");

		if (!item) {
			return;
		}

		var parent = item.closest(".kollab-header__item");
		var mega = parent ? parent.querySelector(".kollab-header__mega") : null;

		if (!parent || !mega) {
			return;
		}

		var shopLink = parent.querySelector(".kollab-header__link");
		var narrow = window.matchMedia("(max-width: 900px)");

		function setOpen(open) {
			parent.classList.toggle("is-expanded", open);
			item.setAttribute("aria-expanded", open ? "true" : "false");
			item.setAttribute("aria-label", open ? "Hide Shop menu" : "Show Shop menu");

			if (window.kollabMega) {
				if (open) {
					window.kollabMega.start();
				} else {
					window.kollabMega.stop();
				}
			}
		}

		function toggle(event) {
			event.preventDefault();
			event.stopPropagation();
			setOpen(!parent.classList.contains("is-expanded"));
		}

		item.addEventListener("click", toggle);

		if (shopLink) {
			shopLink.addEventListener("click", function (event) {
				if (narrow.matches) {
					toggle(event);
				}
			});
		}

		mega.addEventListener("click", function (event) {
			if (event.target.closest("a")) {
				setOpen(false);
			}
		});

		document.addEventListener("click", function (event) {
			if (!parent.contains(event.target)) {
				setOpen(false);
			}
		});

		document.addEventListener("keydown", function (event) {
			if (event.key === "Escape") {
				setOpen(false);
			}
		});

		narrow.addEventListener("change", function () {
			setOpen(false);
		});

		var tabs = Array.prototype.slice.call(mega.querySelectorAll("[data-mega-tab]"));
		var cols = Array.prototype.slice.call(mega.querySelectorAll("[data-mega-col]"));

		tabs.forEach(function (tab) {
			tab.addEventListener("click", function (event) {
				event.preventDefault();
				event.stopPropagation();

				var group = tab.getAttribute("data-mega-tab");

				tabs.forEach(function (other) {
					var on = other === tab;
					other.classList.toggle("is-active", on);
					other.setAttribute("aria-selected", on ? "true" : "false");
				});

				cols.forEach(function (col) {
					col.classList.toggle("is-active", col.getAttribute("data-mega-col") === group);
				});

				if (window.kollabMega) {
					window.kollabMega.showGroup(group);
				}
			});
		});
	}());
</script>

