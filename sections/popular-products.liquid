{% style %}
	{% render 'section-margin' %}
	@import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap');
	#shopify-section-{{ section.id }} {
		--perRow: {{ section.settings.per_row }};
	}
	/* Popular Products Custom CSS - Theme colors: #F12C18, white, black */
	.popular-products {
		--kollab-red: #F12C18;
		--kollab-white: #ffffff;
		--kollab-black: #000000;
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: 82px 0 90px;
		background: var(--kollab-black);
		color: var(--kollab-white);
	}

	.popular-products::before,
	.popular-products::after {
		content: '';
		position: absolute;
		z-index: -1;
		pointer-events: none;
	}

	.popular-products::before {
		inset: 0;
		background:
			linear-gradient(135deg, rgba(241, 44, 24, 0.34), transparent 32%),
			radial-gradient(circle at 86% 16%, rgba(241, 44, 24, 0.26), transparent 26%),
			linear-gradient(180deg, rgba(255, 255, 255, 0.08), transparent 42%);
	}

	.popular-products::after {
		top: 28px;
		right: 5%;
		width: min(420px, 42vw);
		aspect-ratio: 1;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 50%;
		box-shadow:
			-120px 90px 0 -92px rgba(241, 44, 24, 0.72),
			0 0 0 18px rgba(255, 255, 255, 0.04);
	}

	.popular-products .section-header {
		position: relative;
		margin-bottom: 42px;
		padding-bottom: 28px;
	}

	.popular-products .section-header::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 96px;
		height: 4px;
		background: var(--kollab-red);
	}

	.popular-products .section-header__subtitle,
	.popular-products .subtitle {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--kollab-red) !important;
		font-size: 12px;
		font-weight: 900;
		letter-spacing: 0;
		line-height: 1;
		text-transform: uppercase;
	}

	.popular-products .section-header__subtitle::before,
	.popular-products .subtitle::before {
		content: '';
		width: 28px;
		height: 2px;
		background: currentColor;
	}

	.popular-products .section-header__title,
	.popular-products h2,
	.popular-products .title {
		max-width: 880px;
		color: var(--kollab-white) !important;
		font-weight: 900;
		line-height: 0.98;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.popular-products .section-header__description,
	.popular-products .description {
		max-width: 720px;
		color: rgba(255, 255, 255, 0.78) !important;
		line-height: 1.7;
	}

	.popular-products .swiper,
	.popular-products .products-slider,
	.popular-products .product-slider {
		overflow: visible;
	}

	.popular-products .card,
	.popular-products .product-card,
	.popular-products .card-wrapper,
	.popular-products .product-card-wrapper {
		height: 100%;
		overflow: hidden;
		background: var(--kollab-white);
		border: 2px solid var(--kollab-black);
		border-radius: 8px;
		box-shadow: 10px 10px 0 var(--kollab-red);
		transition:
			transform 0.28s ease,
			box-shadow 0.28s ease,
			border-color 0.28s ease;
	}

	.popular-products .card:hover,
	.popular-products .product-card:hover,
	.popular-products .card-wrapper:hover,
	.popular-products .product-card-wrapper:hover {
		transform: translate(-4px, -6px);
		border-color: var(--kollab-red);
		box-shadow: 16px 16px 0 var(--kollab-red);
	}

	.popular-products .card__media,
	.popular-products .product-card__image,
	.popular-products .media {
		position: relative;
		overflow: hidden;
		background: var(--kollab-white);
	}

	.popular-products .card__media::after,
	.popular-products .product-card__image::after,
	.popular-products .media::after {
		content: '';
		position: absolute;
		inset: auto 0 0;
		height: 4px;
		background: var(--kollab-red);
	}

	.popular-products img {
		transition: transform 0.45s ease, opacity 0.45s ease;
	}

	.popular-products .card:hover img,
	.popular-products .product-card:hover img,
	.popular-products .card-wrapper:hover img,
	.popular-products .product-card-wrapper:hover img {
		transform: scale(1.055);
	}

	.popular-products .card__content,
	.popular-products .product-card__content,
	.popular-products .card-information {
		padding: 22px;
		background: var(--kollab-white);
		color: var(--kollab-black);
	}

	.popular-products .card__vendor,
	.popular-products .product-card__vendor,
	.popular-products .card__collection,
	.popular-products .product-card__collection,
	.popular-products .card-information__vendor {
		display: inline-flex;
		margin-bottom: 10px;
		color: var(--kollab-red) !important;
		font-size: 11px;
		font-weight: 900;
		letter-spacing: 0;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.popular-products .card__heading,
	.popular-products .card__heading a,
	.popular-products .product-card__title,
	.popular-products .product-card__title a,
	.popular-products h3,
	.popular-products h3 a {
		color: var(--kollab-black) !important;
		font-weight: 900;
		line-height: 1.18;
		letter-spacing: 0;
		text-decoration: none;
		transition: color 0.24s ease;
	}

	.popular-products .card__heading a:hover,
	.popular-products .product-card__title a:hover,
	.popular-products h3 a:hover {
		color: var(--kollab-red) !important;
	}

	.popular-products .card__description,
	.popular-products .product-card__description,
	.popular-products .card-information__text {
		color: rgba(0, 0, 0, 0.72) !important;
		line-height: 1.58;
	}

	.popular-products .price,
	.popular-products .price__regular,
	.popular-products .price-item,
	.popular-products .price-item--regular {
		color: var(--kollab-black) !important;
		font-size: 18px;
		font-weight: 900;
	}

	.popular-products .price-item--sale {
		color: var(--kollab-red) !important;
		font-weight: 900;
	}

	.popular-products .price__compare,
	.popular-products .price-item--compare,
	.popular-products s {
		color: rgba(0, 0, 0, 0.48) !important;
	}

	.popular-products .badge,
	.popular-products .card__badge,
	.popular-products .product-card__badge {
		background: var(--kollab-red) !important;
		color: var(--kollab-white) !important;
		border: 2px solid var(--kollab-black);
		border-radius: 999px;
		font-weight: 900;
		letter-spacing: 0;
		line-height: 1;
		padding: 8px 12px;
		text-transform: uppercase;
	}

	.popular-products .button,
	.popular-products button,
	.popular-products .product-form__submit,
	.popular-products .quick-add__submit {
		min-height: 46px;
		background: var(--kollab-black) !important;
		color: var(--kollab-white) !important;
		border: 2px solid var(--kollab-black) !important;
		border-radius: 999px;
		font-weight: 900;
		letter-spacing: 0;
		text-transform: uppercase;
		box-shadow: none;
		transition:
			background 0.24s ease,
			color 0.24s ease,
			border-color 0.24s ease,
			transform 0.24s ease !important;
	}

	.popular-products .button:hover,
	.popular-products button:hover,
	.popular-products .product-form__submit:hover,
	.popular-products .quick-add__submit:hover {
		background: var(--kollab-red) !important;
		border-color: var(--kollab-red) !important;
		color: var(--kollab-white) !important;
		transform: translateY(-2px);
	}

	.popular-products .quick-add,
	.popular-products .quick-view,
	.popular-products .quick-add__submit,
	.popular-products .quick-view-button,
	.popular-products .card__quickview,
	.popular-products .product-card__quickview,
	.popular-products .card__media .quick-add__submit,
	.popular-products .product-card__image .quick-add__submit,
	.popular-products .media .quick-add__submit,
	.popular-products .card__media .button,
	.popular-products .product-card__image .button,
	.popular-products .media .button {
		left: 0 !important;
		right: 0 !important;
		margin-left: auto !important;
		margin-right: auto !important;
		transform: none !important;
	}

	.popular-products .quick-add__submit,
	.popular-products .quick-view-button,
	.popular-products .card__quickview button,
	.popular-products .product-card__quickview button,
	.popular-products .card__media .quick-add__submit,
	.popular-products .product-card__image .quick-add__submit,
	.popular-products .media .quick-add__submit,
	.popular-products .card__media .button,
	.popular-products .product-card__image .button,
		.popular-products .media .button {
		min-width: 148px;
		width: max-content;
		max-width: calc(100% - 32px);
		background: var(--kollab-red) !important;
		color: var(--kollab-white) !important;
		border-color: var(--kollab-red) !important;
		box-shadow: 0 10px 0 var(--kollab-black);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		text-align: center;
	}

	.popular-products .quick-add__submit,
	.popular-products .quick-view-button,
	.popular-products .card__quickview button,
	.popular-products .product-card__quickview button,
	.popular-products .card__media .button,
	.popular-products .product-card__image .button,
	.popular-products .media .button {
		transform: none !important;
	}

	.popular-products .quick-add__submit:hover,
	.popular-products .quick-view-button:hover,
	.popular-products .card__quickview button:hover,
	.popular-products .product-card__quickview button:hover,
	.popular-products .card__media .quick-add__submit:hover,
	.popular-products .product-card__image .quick-add__submit:hover,
	.popular-products .media .quick-add__submit:hover,
	.popular-products .card__media .button:hover,
	.popular-products .product-card__image .button:hover,
	.popular-products .media .button:hover {
		background: var(--kollab-black) !important;
		border-color: var(--kollab-black) !important;
		box-shadow: 0 10px 0 var(--kollab-red);
		transform: translateY(-2px) !important;
	}

	.popular-products .card:hover .quick-add,
	.popular-products .product-card:hover .quick-add,
	.popular-products .card-wrapper:hover .quick-add,
	.popular-products .product-card-wrapper:hover .quick-add,
	.popular-products .card:hover .quick-add__submit,
	.popular-products .product-card:hover .quick-add__submit,
	.popular-products .card-wrapper:hover .quick-add__submit,
	.popular-products .product-card-wrapper:hover .quick-add__submit,
	.popular-products .card:hover .quick-view-button,
	.popular-products .product-card:hover .quick-view-button,
	.popular-products .card-wrapper:hover .quick-view-button,
	.popular-products .product-card-wrapper:hover .quick-view-button {
		left: 0 !important;
		right: 0 !important;
		margin-left: auto !important;
		margin-right: auto !important;
		transform: none !important;
	}

	.popular-products .card:hover .quick-add__submit:hover,
	.popular-products .product-card:hover .quick-add__submit:hover,
	.popular-products .card-wrapper:hover .quick-add__submit:hover,
	.popular-products .product-card-wrapper:hover .quick-add__submit:hover,
	.popular-products .card:hover .quick-view-button:hover,
	.popular-products .product-card:hover .quick-view-button:hover,
	.popular-products .card-wrapper:hover .quick-view-button:hover,
	.popular-products .product-card-wrapper:hover .quick-view-button:hover {
		transform: translateY(-2px) !important;
	}

	.popular-products .section-header_btn {
		margin-top: 48px;
		text-align: center;
	}

	.popular-products .section-header_btn .button {
		min-width: 190px;
		background: #F12C18 !important;
		color: var(--kollab-white) !important;
		border-color: #F12C18 !important;
		padding: 15px 36px !important;
		box-shadow: 8px 8px 0 var(--kollab-white);
	}

	.popular-products .section-header_btn .button:hover {
		background: var(--kollab-white) !important;
		border-color: var(--kollab-white) !important;
		color: var(--kollab-black) !important;
		box-shadow: 8px 8px 0 var(--kollab-red);
	}

	.popular-products .swiper-button-next,
	.popular-products .swiper-button-prev,
	.popular-products .slider-button {
		width: 46px;
		height: 46px;
		background: var(--kollab-white) !important;
		color: var(--kollab-black) !important;
		border: 2px solid var(--kollab-black) !important;
		border-radius: 50%;
		box-shadow: 5px 5px 0 var(--kollab-red);
		transition:
			background 0.24s ease,
			color 0.24s ease,
			box-shadow 0.24s ease,
			transform 0.24s ease;
	}

	.popular-products .swiper-button-next:hover,
	.popular-products .swiper-button-prev:hover,
	.popular-products .slider-button:hover {
		background: var(--kollab-red) !important;
		color: var(--kollab-white) !important;
		box-shadow: 5px 5px 0 var(--kollab-white);
		transform: translateY(-2px);
	}

	.popular-products .swiper-pagination {
		position: relative;
		margin-top: 34px;
	}

	.popular-products .swiper-pagination-bullet {
		width: 10px;
		height: 10px;
		background: var(--kollab-white);
		opacity: 1;
		transition: width 0.24s ease, background 0.24s ease;
	}

	.popular-products .swiper-pagination-bullet-active {
		width: 34px;
		background: var(--kollab-red) !important;
		border-radius: 999px;
	}

	.popular-products .color-swatch,
	.popular-products .swatch,
	.popular-products .product-form__input input + label {
		border: 2px solid var(--kollab-black);
		transition: border-color 0.24s ease, box-shadow 0.24s ease;
	}

	.popular-products .color-swatch:hover,
	.popular-products .swatch:hover,
	.popular-products .product-form__input input:checked + label {
		border-color: var(--kollab-red) !important;
		box-shadow: 0 0 0 3px rgba(241, 44, 24, 0.22);
	}

	/* Product carousel layout based on reference */
	.popular-products {
		--product-cream: #f5f1e6;
		--product-card: #fbf8ee;
		--product-mint: #c9e9d7;
		--product-border: #747064;
		padding: 72px 0 58px;
		background: var(--product-cream) !important;
		color: var(--kollab-black);
	}

	.popular-products::before,
	.popular-products::after {
		display: none;
	}

	.popular-products .section-header {
		margin-bottom: 34px;
		padding-bottom: 18px;
		border-bottom: 1px solid rgba(0, 0, 0, 0.42);
	}

	.popular-products .section-header::after {
		display: none;
	}

	.popular-products .section-header__subtitle,
	.popular-products .subtitle {
		color: var(--kollab-red) !important;
	}

	.popular-products .section-header__subtitle::before,
	.popular-products .subtitle::before {
		display: none;
	}

	.popular-products .section-header__title,
	.popular-products h2,
	.popular-products .title {
		color: var(--kollab-black) !important;
	}

	.popular-products .section-header__description,
	.popular-products .description {
		color: rgba(0, 0, 0, 0.72) !important;
	}

	.popular-products .swiper-wrapper {
		align-items: center;
	}

	.popular-products .swiper-slide:first-child {
		order: 2;
		z-index: 4;
	}

	.popular-products .swiper-slide:nth-child(2) {
		order: 1;
	}

	.popular-products .swiper-slide:nth-child(3) {
		order: 3;
	}

	.popular-products .swiper-slide:first-child .card,
	.popular-products .swiper-slide:first-child .product-card,
	.popular-products .swiper-slide:first-child .card-wrapper,
	.popular-products .swiper-slide:first-child .product-card-wrapper {
		transform: none;
	}

	.popular-products .card,
	.popular-products .product-card,
	.popular-products .card-wrapper,
	.popular-products .product-card-wrapper {
		height: 100% !important;
		position: relative;
		background: var(--product-card) !important;
		border: 2px solid var(--product-border) !important;
		border-radius: 24px !important;
		box-shadow: none !important;
		overflow: hidden;
		transform: none !important;
		transition: border-color 0.28s ease;
	}

	.popular-products .card:hover,
	.popular-products .product-card:hover,
	.popular-products .card-wrapper:hover,
	.popular-products .product-card-wrapper:hover {
		border-color: var(--kollab-black) !important;
		box-shadow: none !important;
		transform: none !important;
	}

	.popular-products .swiper-slide:first-child .card:hover,
	.popular-products .swiper-slide:first-child .product-card:hover,
	.popular-products .swiper-slide:first-child .card-wrapper:hover,
	.popular-products .swiper-slide:first-child .product-card-wrapper:hover {
		transform: none !important;
	}

	.popular-products .card::before,
	.popular-products .product-card::before {
		content: "TOP RATED";
		position: absolute;
		top: 18px;
		right: 18px;
		z-index: 5;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 25px;
		padding: 6px 14px;
		background: #84cbc7;
		color: var(--kollab-black);
		border: 2px solid var(--product-border);
		border-radius: 999px;
		font-size: 10px;
		font-weight: 900;
		line-height: 1;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.popular-products .swiper-slide:first-child .card::before,
	.popular-products .swiper-slide:first-child .product-card::before {
		content: "BEST SELLER";
	}

	.popular-products .card__media,
	.popular-products .product-card__image,
	.popular-products .media {
		background: linear-gradient(135deg, rgba(255, 220, 35, 0.18), rgba(255, 255, 255, 0.5)) !important;
	}

	.popular-products .card__media::after,
	.popular-products .product-card__image::after,
	.popular-products .media::after {
		display: none;
	}

	.popular-products .card__content,
	.popular-products .product-card__content,
	.popular-products .card-information {
		background: var(--product-card) !important;
		padding: 20px 24px 24px !important;
		color: var(--kollab-black);
	}

	.popular-products .card__heading,
	.popular-products .card__heading a,
	.popular-products .product-card__title,
	.popular-products .product-card__title a,
	.popular-products h3,
	.popular-products h3 a {
		font-size: 20px;
		line-height: 1.05;
		text-transform: uppercase;
	}

	.popular-products .card__description,
	.popular-products .product-card__description,
	.popular-products .card-information__text {
		color: rgba(0, 0, 0, 0.82) !important;
		font-size: 13px;
		line-height: 1.35;
		font-weight: 700;
	}

	.popular-products .button,
	.popular-products button,
	.popular-products .product-form__submit,
	.popular-products .quick-add__submit {
		width: 100%;
		min-height: 44px;
		background: var(--product-mint) !important;
		color: var(--kollab-black) !important;
		border: 2px solid var(--product-border) !important;
		border-radius: 999px !important;
		box-shadow: none !important;
		font-size: 13px;
		font-weight: 900;
	}

	.popular-products .button:hover,
	.popular-products button:hover,
	.popular-products .product-form__submit:hover,
	.popular-products .quick-add__submit:hover {
		background: var(--kollab-black) !important;
		border-color: var(--kollab-black) !important;
		color: var(--kollab-white) !important;
		transform: none !important;
		box-shadow: none !important;
	}

	.popular-products .quick-add__submit,
	.popular-products .quick-view-button,
	.popular-products .card__quickview button,
	.popular-products .product-card__quickview button,
	.popular-products .card__media .button,
	.popular-products .product-card__image .button,
	.popular-products .media .button {
		background: var(--product-mint) !important;
		color: var(--kollab-black) !important;
		border-color: var(--product-border) !important;
		box-shadow: none !important;
	}

	.popular-products .swiper-pagination {
		margin-top: 42px;
	}

	.popular-products .swiper-pagination-bullet {
		width: 12px;
		height: 12px;
		background: transparent;
		border: 2px solid rgba(0, 0, 0, 0.42);
		opacity: 1;
	}

	.popular-products .swiper-pagination-bullet-active {
		width: 12px;
		background: var(--kollab-black) !important;
		border-color: var(--kollab-black);
		border-radius: 50%;
	}

	/* Simplified compact product UI */
	.popular-products {
		padding: 42px 0 46px !important;
		background: #ffffff !important;
	}

	.popular-products .container,
	.popular-products .page-width {
		padding-left: 16px !important;
		padding-right: 16px !important;
	}

	.popular-products .section-header {
		margin-bottom: 18px !important;
		padding-bottom: 14px !important;
	}

	.popular-products .section-header__title,
	.popular-products h2,
	.popular-products .title {
		font-size: clamp(24px, 3vw, 38px) !important;
		line-height: 1 !important;
	}

	.popular-products .section-header__subtitle,
	.popular-products .subtitle {
		font-size: 10px !important;
	}

	.popular-products .card,
	.popular-products .product-card,
	.popular-products .card-wrapper,
	.popular-products .product-card-wrapper {
		height: 100% !important;
		border-radius: 18px !important;
		background: #ffffff !important;
		transform: none !important;
	}

	.popular-products .card__media,
	.popular-products .product-card__image,
	.popular-products .media {
		background: #ffffff !important;
	}

