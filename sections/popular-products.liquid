{% assign product_list = section.settings.product_list %}
{% assign section_id = 'shopify-section-' | append: section.id %}

{% liquid
	if section.settings.show_arrows
		assign show_arrows = true
	else
		assign show_arrows = false
	endif
%}
<div class='popular-products'>
	{% render 'section-header', show_arrows: show_arrows %}
	<div class='container'>
		<div class='kollab-product-carousel' data-product-carousel>
			<button class='kollab-product-carousel__arrow kollab-product-carousel__arrow--prev' type='button' aria-label='Previous products' data-product-carousel-prev>&lsaquo;</button>
			<div class='kollab-product-carousel__viewport'>
				<div class='kollab-product-grid' data-product-carousel-track>
					{% for product in product_list limit: 5 %}
						{% assign product_image_alt = product.featured_media.alt | default: product.title %}
						{% assign first_available_variant = product.selected_or_first_available_variant %}
						{% assign image_media_count = 0 %}
						{% for media in product.media %}
							{% if media.media_type == 'image' %}
								{% assign image_media_count = image_media_count | plus: 1 %}
							{% endif %}
						{% endfor %}
						<article class='kollab-product-card'>
							<span class='kollab-product-card__badge'>
								{% if forloop.first %}Best Seller{% else %}Top Rated{% endif %}
							</span>
							<div class='kollab-product-card__media' data-product-slider>
								<div class='kollab-product-card__track{% if image_media_count > 1 %} kollab-product-card__track--has-hover{% endif %}' data-product-slider-track>
									{% if product.media.size > 0 %}
										{% assign rendered_product_images = 0 %}
										{% for media in product.media %}
											{% if media.media_type == 'image' %}
												{% if rendered_product_images < 2 %}
													{% assign rendered_product_images = rendered_product_images | plus: 1 %}
													{% assign media_alt = media.alt | default: product.title %}
													<a class='kollab-product-card__slide' href='{{ product.url }}'>
														{{ media.preview_image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 20vw, 50vw', alt: media_alt }}
													</a>
												{% endif %}
											{% endif %}
										{% endfor %}
									{% elsif product.featured_media != blank %}
										<a class='kollab-product-card__slide' href='{{ product.url }}'>
											{{ product.featured_media.preview_image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 20vw, 50vw', alt: product_image_alt }}
										</a>
									{% else %}
										<span class='kollab-product-card__placeholder' aria-hidden='true'></span>
									{% endif %}
								</div>
							</div>
							<div class='kollab-product-card__body'>
								<h3 class='kollab-product-card__title'>
									<a href='{{ product.url }}'>{{ product.title }}</a>
								</h3>
								<p class='kollab-product-card__description'>
									{% if product.description != blank %}
										{{ product.description | strip_html | truncate: 70 }}
									{% else %}
										Product description
									{% endif %}
								</p>
								{% if product.compare_at_price > product.price %}
									<div class='kollab-product-card__price kollab-product-card__price--sale'>
										<span class='kollab-product-card__compare'>{{ product.compare_at_price | money }}</span>
										<span class='kollab-product-card__sale'>{{ product.price | money }}</span>
									</div>
								{% else %}
									<div class='kollab-product-card__price kollab-product-card__price--regular'>
										<span class='kollab-product-card__regular'>{{ product.price | money }}</span>
									</div>
								{% endif %}
								<form class='kollab-product-card__form' method='post' action='/cart/add'>
									<input type='hidden' name='id' value='{{ first_available_variant.id }}'>
									<button class='kollab-product-card__quick' type='submit' {% unless first_available_variant.available %}disabled{% endunless %}>
										{% if first_available_variant.available %}Add to Cart{% else %}Sold Out{% endif %}
									</button>
								</form>
							</div>
						</article>
					{% endfor %}
				</div>
			</div>
			<button class='kollab-product-carousel__arrow kollab-product-carousel__arrow--next' type='button' aria-label='Next products' data-product-carousel-next>&rsaquo;</button>
		</div>
	</div>
	{% if section.settings.section_header_type == 'type1' %}
		<div class='section-header_btn'>
			{% if section.settings.button_label != blank %}
				{% render 'button', layout: section %}
			{% endif %}
		</div>
	{% endif %}
</div>

<script>
	(() => {
		const initProductCarousel = () => {
			document.querySelectorAll('[data-product-carousel]').forEach(carousel => {
				if (carousel.dataset.carouselInitialized === 'true') return;
				carousel.dataset.carouselInitialized = 'true';

				const track = carousel.querySelector('[data-product-carousel-track]');
				const cards = carousel.querySelectorAll('.kollab-product-card');
				const prev = carousel.querySelector('[data-product-carousel-prev]');
				const next = carousel.querySelector('[data-product-carousel-next]');
				let index = 0;

				if (!track || !cards.length) return;

				const getCardsPerView = () => {
					if (window.matchMedia('(max-width: 560px)').matches) return 1;
					if (window.matchMedia('(max-width: 768px)').matches) return 2;
					return 4;
				};

				const update = () => {
					const cardsPerView = getCardsPerView();
					const maxIndex = Math.max(0, cards.length - cardsPerView);
					index = Math.min(index, maxIndex);
					track.style.setProperty('--product-carousel-offset', `${index * -100 / cardsPerView}%`);

					if (prev) prev.disabled = index === 0;
					if (next) next.disabled = index >= maxIndex;
				};

				if (prev) {
					prev.addEventListener('click', () => {
						index = Math.max(0, index - 1);
						update();
					});
				}

				if (next) {
					next.addEventListener('click', () => {
						index += 1;
						update();
					});
				}

				window.addEventListener('resize', update);
				update();
			});
		};

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initProductCarousel);
		} else {
			initProductCarousel();
		}

		document.addEventListener('shopify:section:load', initProductCarousel);
	})();
</script>

