{% if product.description != blank or product.metafields.custom.clinically_effective_ingredients_with_description != blank or product.metafields.custom.how_to_use_in_your_routine != blank or product.metafields.custom.faq != blank or product.metafields.custom.sustainability != blank %}
    
    {%- style -%}
        {% render 'section-padding' %}
    {%- endstyle -%}

    <section class="section-{{ section.id }}-padding about-product-section" style="background-color:{{ section.settings.bg_color }};">
        <div class="product-info-section flex gap-8">
            <div class="container">
                <!-- LEFT: Accordion -->
                {% if product.description != blank or product.metafields.custom.clinically_effective_ingredients_with_description != blank or product.metafields.custom.how_to_use_in_your_routine != blank or product.metafields.custom.faq != blank or product.metafields.custom.sustainability != blank %}
                    <div class="product-accordion">

                        <h2 id="about-the-product">About <em>the Product</em></h2>

                        <!-- Details (plain product description) -->
                        {% if product.description != blank %}
                            <details>
                                <summary>Details</summary>
                                <p>{{ product.description }}</p>
                            </details>
                        {% endif %}

                        <!-- Clinically effective ingredients -->
                        {% if product.metafields.custom.clinically_effective_ingredients_with_description != blank %}
                            <details>
                                <summary>Clinically effective ingredients</summary>
                                <div class="rich-text-content">
                                    {{ product.metafields.custom.clinically_effective_ingredients_with_description | metafield_tag }}
                                </div>
                            </details>
                        {% endif %}

                        <!-- How to use in your routine -->
                        {% if product.metafields.custom.how_to_use_in_your_routine != blank %}
                            <details>
                                <summary>How to use in your routine</summary>
                                <div class="rich-text-content">
                                    {{ product.metafields.custom.how_to_use_in_your_routine | metafield_tag }}
                                </div>
                            </details>
                        {% endif %}

                        <!-- FAQ -->
                        {% if product.metafields.custom.faq != blank %}
                            <details>
                                <summary>FAQ</summary>
                                <div class="rich-text-content">
                                    {{ product.metafields.custom.faq | metafield_tag }}
                                </div>
                            </details>
                        {% endif %}

                        <!-- Sustainability -->
                        {% if product.metafields.custom.sustainability != blank %}
                            <details>
                                <summary>Sustainability</summary>
                                <div class="rich-text-content">
                                    {{ product.metafields.custom.sustainability | metafield_tag }}
                                </div>
                            </details>
                        {% endif %}
                    </div>
                {% endif %}

                <!-- RIGHT: Image + Tabs -->
                {% if product.metafields.custom.real_results_image != blank or product.metafields.custom.real_results != blank %}
                    <div class="product-result">
                        <h2>Real <em>Results</em></h2>    
                        <!-- Real Results Image -->
                        {% if product.metafields.custom.real_results_image != blank %}
                            <img src="{{ product.metafields.custom.real_results_image | img_url: '500x' }}" width="100%" height="auto" alt="Real Results"/>
                        {% endif %}

                        <!-- Tabs -->
                        {% if product.metafields.custom.real_results != blank %}
                            <!-- Container for raw rich text -->
                            <div id="real-results-raw" style="display:none;">
                                {{ product.metafields.custom.real_results | metafield_tag }}
                            </div>
                        {% endif %}

                    </div>
                {% endif %}
            </div>    
        </div>

        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const btn = document.getElementById("view-details");
                const target = document.getElementById("about-the-product");

                if (btn && target) {
                    btn.addEventListener("click", (e) => {
                    e.preventDefault();
                    target.scrollIntoView({ behavior: "smooth", block: "start" });
                    });
                }
            });
            document.addEventListener("DOMContentLoaded", () => {
                const container = document.getElementById("real-results-raw");
                if (!container) return;

                const headings = container.querySelectorAll("h4");
                if (!headings.length) return;

                const tabContainer = document.createElement("div");
                tabContainer.className = "h4-tabs-container";

                const tabButtons = document.createElement("div");
                tabButtons.className = "tab-buttons";

                const tabContents = document.createElement("div");
                tabContents.className = "tab-contents";

                headings.forEach((h4, index) => {
                    // Create tab button
                    const button = document.createElement("button");
                    button.className = "tab-btn" + (index === 0 ? " active" : "");
                    button.dataset.tab = "tab-" + (index + 1);
                    button.innerText = h4.innerText;
                    tabButtons.appendChild(button);

                    // Create tab content container
                    const contentDiv = document.createElement("div");
                    contentDiv.className = "tab-content" + (index === 0 ? " active" : "");
                    contentDiv.id = "tab-" + (index + 1);

                    // Collect all siblings until next h4
                    let sibling = h4.nextElementSibling;
                    while (sibling && sibling.tagName !== "H4") {
                    contentDiv.appendChild(sibling.cloneNode(true));
                    sibling = sibling.nextElementSibling;
                    }

                    tabContents.appendChild(contentDiv);
                });

                // Replace raw container with tabs
                container.innerHTML = "";
                tabContainer.appendChild(tabButtons);
                tabContainer.appendChild(tabContents);
                container.appendChild(tabContainer);

                // Tab click functionality
                const buttons = tabContainer.querySelectorAll(".tab-btn");
                const contents = tabContainer.querySelectorAll(".tab-content");

                buttons.forEach(btn => {
                    btn.addEventListener("click", () => {
                    buttons.forEach(b => b.classList.remove("active"));
                    contents.forEach(c => c.classList.remove("active"));

                    btn.classList.add("active");
                    tabContainer.querySelector(`#${btn.dataset.tab}`).classList.add("active");
                    });
                });

                container.style.display = "block";
            });
        </script>

    </section>
{% endif %}

{% schema %}
{
  "name": "About Product",
  "enabled_on": {
		"templates": ["product"]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5f5f5"
    },
    {
        "type": "header",
        "content": "t:sections.all.section-padding.header.content"
    },
    {
        "type": "select",
        "id": "padding_top",
        "options": [
            {
                "value": "no-indent",
                "label": "t:sections.all.section-padding.options__1.label"
            },
            {
                "value": "xs",
                "label": "t:sections.all.section-padding.options__2.label"
            },
            {
                "value": "s",
                "label": "t:sections.all.section-padding.options__3.label"
            },
            {
                "value": "m",
                "label": "t:sections.all.section-padding.options__4.label"
            },
            {
                "value": "l",
                "label": "t:sections.all.section-padding.options__5.label"
            }
        ],
        "default": "s",
        "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
        "type": "select",
        "id": "padding_bottom",
        "options": [
            {
                "value": "no-indent",
                "label": "t:sections.all.section-padding.options__1.label"
            },
            {
                "value": "xs",
                "label": "t:sections.all.section-padding.options__2.label"
            },
            {
                "value": "s",
                "label": "t:sections.all.section-padding.options__3.label"
            },
            {
                "value": "m",
                "label": "t:sections.all.section-padding.options__4.label"
            },
            {
                "value": "l",
                "label": "t:sections.all.section-padding.options__5.label"
            }
        ],
        "default": "s",
        "label": "t:sections.all.section-padding.padding_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "About Product"
    }
  ]
}
{% endschema %}