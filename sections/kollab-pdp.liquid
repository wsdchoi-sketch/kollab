{%- liquid
assign cv = product.selected_or_first_available_variant
assign clean_title = product.title
if clean_title contains ']'
assign clean_title = clean_title | split: ']' | last | strip
endif
assign mf = product.metafields.custom
assign sub_1 = section.settings.sub_1
if sub_1 == blank
assign sub_1 = mf.hero_line
endif
assign has_compare = false
if cv.compare_at_price > cv.price
assign has_compare = true
endif
assign rating = product.metafields.reviews.rating.value
assign rating_count = product.metafields.reviews.rating_count.value
assign tags_list = section.settings.hashtags | newline_to_br | split: '<br />'
-%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap">
{{ 'kollab-pdp.css' | asset_url | stylesheet_tag }}
<div class="kpdp" id="kpdp-{{ section.id }}">
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs><linearGradient id="kp-ch" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff"/><stop offset=".45" stop-color="#b9b9b9"/><stop offset=".55" stop-color="#fff"/><stop offset="1" stop-color="#8f8f8f"/></linearGradient><symbol id="kp-star" viewBox="0 0 48 48"><path d="M24 2 28 20 46 24 28 28 24 46 20 28 2 24 20 20Z"/></symbol></defs></svg>

<div class="wrap">
<section class="hero">
<div class="gallery">
<div class="gal-top"><svg width="30" height="30" aria-hidden="true"><use href="#kp-star" fill="url(#kp-ch)" stroke="#777" stroke-width=".6"/></svg></div>
<div style="position:relative">
{%- if section.settings.sticker_patch != blank -%}<div class="stk stk-k"><img src="{{ section.settings.sticker_patch | image_url: width: 400 }}" alt="" loading="lazy"></div>{%- endif -%}
<div class="main-img" id="kp-main">
{%- for image in product.images limit: 5 -%}
<img class="slide{% if forloop.first %} on{% endif %}" src="{{ image | image_url: width: 1200 }}" alt="{{ image.alt | default: clean_title | escape }}"{% unless forloop.first %} loading="lazy"{% endunless %}>
{%- endfor -%}
</div>
</div>
<div class="thumbs" id="kp-thumbs">
{%- for image in product.images limit: 5 -%}
<button type="button" class="{% if forloop.first %}on{% endif %}" aria-label="Image {{ forloop.index }}"><img src="{{ image | image_url: width: 300 }}" alt="" loading="lazy"></button>
{%- endfor -%}
</div>
</div>

<div class="info">
<a class="brand" href="{{ product.vendor | url_for_vendor }}"><svg class="kstar" aria-hidden="true"><use href="#kp-star" fill="#fff"/></svg>{{ product.vendor }}</a>
<h1 class="title serif">{{ clean_title }}<br><span class="i">{{ section.settings.tagline }}</span></h1>
<p class="sub">{%- if sub_1 != blank -%}<span class="sent">{{ sub_1 }}</span>{%- endif -%}{%- if section.settings.sub_2 != blank -%}<span class="sent">{{ section.settings.sub_2 }}</span>{%- endif -%}</p>
{%- if rating != blank and rating_count != blank -%}
<div class="rating"><span class="s">★★★★★</span> {{ rating.rating | round: 1 }} <span>·</span> <a href="#judgeme_product_reviews">{{ rating_count }} review{% if rating_count != 1 %}s{% endif %}</a></div>
{%- endif -%}
<div class="price"><span class="p">{{ cv.price | money_without_trailing_zeros }}</span>{%- if has_compare -%}<s class="was">{{ cv.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}<small>{{ section.settings.size_label }}</small></div>

<product-form class="buy-wrap" data-hide-errors="false">
{%- form 'product', product, id: 'kp-form', class: 'buy' -%}
<input type="hidden" name="id" value="{{ cv.id }}">
<div class="qty">
<button type="button" class="up" id="kp-up" aria-label="Increase quantity"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="23" fill="#E3001B"/><path d="M24 12 11.5 24.5l4 4L21 23v13h6V23l5.5 5.5 4-4z" fill="#fff"/></svg></button>
<input class="q" type="number" name="quantity" id="kp-q" value="1" min="1" inputmode="numeric" aria-label="Quantity">
<button type="button" id="kp-down" aria-label="Decrease quantity"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="23" fill="#0A0A0A"/><path d="M24 36 36.5 23.5l-4-4L27 25V12h-6v13l-5.5-5.5-4 4z" fill="#fff"/></svg></button>
</div>
{%- if cv.available -%}
<button type="submit" name="add" class="cta" id="kp-atc"><span>Add to bag</span><span class="dot">·</span><span>{{ cv.price | money_without_trailing_zeros }}</span></button>
<button type="button" class="cta2" id="kp-buy" data-variant="{{ cv.id }}">Buy it now</button>
{%- else -%}
<button type="submit" class="cta" disabled><span>Sold out</span></button>
<button type="button" class="cta2" disabled>Buy it now</button>
{%- endif -%}
<div class="product-form__error-message-wrapper" role="alert" hidden><span class="product-form__error-message"></span></div>
{%- endform -%}
</product-form>

<div class="chips">{%- for t in tags_list -%}{%- assign t2 = t | strip -%}{%- if t2 != blank -%}<span class="chip">{{ t2 }}</span>{%- endif -%}{%- endfor -%}</div>
<div class="proof"><div><b>30%</b><span>Visible results</span></div><div><b>4</b><span>Clinical benefits</span></div><div><b>20s</b><span>Per use</span></div><div><b>19</b><span>Years expertise</span></div></div>

<details open><summary>What it does</summary>
<p>A toner and a mask in one pump. Built around PIXALIA™, a botanical sebum-control complex, with centella and plant soothers for skin that gets oily, congested or reactive.</p>
<ul><li>Clinically shown to improve sebum control, pore appearance, soothing and hydration, with up to around 30% visible results</li><li>Foam reaches into pores and lifts residue without rubbing</li><li>Leaves skin smoother, clearer and more balanced, not stripped</li><li>Created by Skinstar, a Korean aesthetic brand with 19 years in professional skincare</li></ul>
</details>
<details><summary>How to use</summary><p>Pump the foam onto your palm and spread over cleansed skin. Leave for twenty seconds, then rinse. Follow with Blooming Capsule Ampoule and Calming Cream.</p></details>
<details><summary>Key ingredients</summary><p>PIXALIA™ (botanical sebum-control complex), niacinamide, centella asiatica extract, houttuynia cordata extract, panthenol, polyglutamic acid.</p></details>
<details><summary>Shipping and returns</summary><p>Free shipping on orders over $60.{%- if shop.shipping_policy.url != blank %} See our <a href="{{ shop.shipping_policy.url }}" style="text-decoration:underline">shipping</a>{%- endif -%}{%- if shop.refund_policy.url != blank %} and <a href="{{ shop.refund_policy.url }}" style="text-decoration:underline">return</a> policies.{%- endif -%}</p></details>
</div>
</section>
</div>

<section class="banner">
<div class="sky"></div>
{%- if section.settings.banner_image != blank -%}<img src="{{ section.settings.banner_image | image_url: width: 2000 }}" alt="" loading="lazy">{%- endif -%}
<div class="grad"></div>
<div class="wrap in">
<svg class="bst" aria-hidden="true"><use href="#kp-star" fill="url(#kp-ch)" stroke="#555" stroke-width=".5"/></svg>
<h2><span class="shine">A soft starlight glow,</span><br><span class="i shine">on your skin.</span></h2>
<p>Ciel étoilé is the signature aesthetic line from Skinstar, built on nineteen years of professional skin care and trusted by Korea's top celebrities.</p>
<span class="by">Ciel étoilé by Skinstar · Seoul</span>
</div>
</section>

<div class="wrap">
<section class="sec" id="demo">
<div class="kicker"><svg class="kstar" aria-hidden="true"><use href="#kp-star" fill="#E3001B"/></svg>The twenty-second ritual</div>
<h2 class="big serif">Press play. <span class="i">Count with it.</span></h2>
<p class="lead"><span class="sent">Twenty seconds is all it asks of you.</span><span class="sent">Press play and we'll keep time while the foam does the work.</span></p>
<div class="rule"></div>
<div class="demo">
<div class="tank" id="tank">
{%- if section.settings.vimeo_id != blank -%}<iframe src="https://player.vimeo.com/video/{{ section.settings.vimeo_id }}?background=1&autoplay=1&loop=1&muted=1" loading="lazy" allow="autoplay; fullscreen" title="Bubble Mask Toner video"></iframe>{%- endif -%}
<div class="num" id="num">20</div>
<div class="cap" id="cap">Ready · <i>press play</i></div>
</div>
<div>
<div class="steps" id="steps">
<div class="step"><div class="n">1</div><div><h4>Pump onto your palm</h4><p>Two pumps covers the whole face. It arrives as a gel and turns to foam the moment it touches skin.</p></div></div>
<div class="step dim"><div class="n">2</div><div><h4>Spread over cleansed skin</h4><p>Avoid the eye area. The bubbles lift residue, oil and leftover makeup out of pores.</p></div></div>
<div class="step dim"><div class="n">3</div><div><h4>Wait twenty seconds</h4><p>PIXALIA™ and centella work while it foams. No tingling, no tightness.</p></div></div>
<div class="step dim"><div class="n">4</div><div><h4>Rinse and move on</h4><p>Skin feels clean but not stripped. Go straight to your ampoule.</p></div></div>
</div>
<button type="button" class="play" id="play"><span>Start 20 seconds</span><span>▶</span></button>
</div>
</div>
</section>
</div>

{%- render 'kollab-pdp-skin', sticker_bubble: section.settings.sticker_bubble -%}

<div class="wrap">
<section class="sec" id="ingredients">
<div class="kicker"><svg class="kstar" aria-hidden="true"><use href="#kp-star" fill="#E3001B"/></svg>Inside the bottle</div>
<h2 class="big serif">Six ingredients <span class="i">that earn their place.</span></h2>
<p class="lead">Hover over any one to see what it actually does on your face.</p>
<div style="height:40px"></div>
{%- render 'kollab-pdp-ingredients' -%}
</section>

{%- assign has_app = false -%}
{%- for block in section.blocks -%}{%- if block.type == '@app' -%}{%- assign has_app = true -%}{%- endif -%}{%- endfor -%}
{%- if has_app -%}
<section class="sec" id="video" style="padding-top:0;position:relative">
<div class="kicker"><svg class="kstar" aria-hidden="true"><use href="#kp-star" fill="#E3001B"/></svg>Shop the video</div>
<h2 class="big serif">Watch it foam <span class="i">on real faces.</span>{%- if section.settings.sticker_patch != blank -%}<img class="stk-inl" src="{{ section.settings.sticker_patch | image_url: width: 300 }}" alt="">{%- endif -%}</h2>
<div style="height:40px"></div>
{%- for block in section.blocks -%}{%- if block.type == '@app' -%}<div {{ block.shopify_attributes }}>{% render block %}</div>{%- endif -%}{%- endfor -%}
</section>
{%- endif -%}

{%- render 'kollab-pdp-ritual', product: product, bow_image: section.settings.bow_image -%}
</div>

{%- render 'kollab-pdp-events', blocks: section.blocks, events_url: section.settings.events_url -%}

<div class="sticky"><span class="p">{{ cv.price | money_without_trailing_zeros }}</span><button type="button" class="cta" id="kp-sticky"{% unless cv.available %} disabled{% endunless %}><span>{% if cv.available %}Add to bag{% else %}Sold out{% endif %}</span></button></div>
</div>
<script src="{{ 'kollab-pdp.js' | asset_url }}" defer></script>

{% schema %}
{"name":"KOLLAB PDP","tag":"section","class":"kollab-pdp-section","blocks":[{"type":"@app"},{"type":"event","name":"Event ticket","settings":[{"type":"text","id":"date_label","label":"Date (top bar)","default":"Oct 13–17 · 2026"},{"type":"text","id":"from_code","label":"From","default":"LA"},{"type":"text","id":"to_code","label":"To","default":"KCCLA"},{"type":"textarea","id":"title","label":"Title (Enter = new line)"},{"type":"textarea","id":"description","label":"Description"},{"type":"image_picker","id":"poster","label":"Poster image"},{"type":"text","id":"poster_url","label":"Poster URL (fallback)"},{"type":"text","id":"info_1_label","label":"Info 1 label","default":"Gate"},{"type":"text","id":"info_1_value","label":"Info 1 value"},{"type":"text","id":"info_2_label","label":"Info 2 label","default":"Time"},{"type":"text","id":"info_2_value","label":"Info 2 value"},{"type":"text","id":"info_3_label","label":"Info 3 label","default":"Fare"},{"type":"text","id":"info_3_value","label":"Info 3 value"},{"type":"text","id":"button_label","label":"Button text","default":"Let's go"},{"type":"url","id":"link","label":"Button link"},{"type":"select","id":"style","label":"Top bar color","default":"black","options":[{"value":"black","label":"Black"},{"value":"red","label":"Red"}]}]}],"max_blocks":16,"settings":[{"type":"header","content":"Brand stickers (upload your PNGs)"},{"type":"image_picker","id":"sticker_patch","label":"KOLLAB flower patch"},{"type":"image_picker","id":"sticker_bubble","label":"Speech bubble patch"},{"type":"image_picker","id":"bow_image","label":"Gift ribbon corner bow"},{"type":"header","content":"Hero"},{"type":"text","id":"tagline","label":"Headline (second line)","default":"twenty seconds, done."},{"type":"text","id":"sub_1","label":"Subtext line 1","default":"A professional bubble toner that works as a mask."},{"type":"text","id":"sub_2","label":"Subtext line 2","default":"Foams on contact, clears pores and calms skin in twenty seconds."},{"type":"text","id":"size_label","label":"Size label","default":"190ml · 6.42 fl oz"},{"type":"textarea","id":"hashtags","label":"Hashtags (one per line)","default":"#bestforoilyskin\n#porecare\n#clinicallytested\n#madebyaesthetician"},{"type":"header","content":"Brand banner"},{"type":"image_picker","id":"banner_image","label":"Banner image"},{"type":"header","content":"20-second video"},{"type":"text","id":"vimeo_id","label":"Vimeo video ID","default":"1227912331"},{"type":"header","content":"Events"},{"type":"url","id":"events_url","label":"All events link"}]}
{% endschema %}