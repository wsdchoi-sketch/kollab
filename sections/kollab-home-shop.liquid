{%- render 'kollab-home-head' -%}
{%- assign s = section.settings -%}
<div class="cats" aria-label="Shop by category"><div class="row" data-dup>
{%- if s.cats_menu != blank -%}
{%- for l in s.cats_menu.links -%}<a class="cat foil" href="{{ l.url }}"><svg viewBox="0 0 24 24"><use href="#kh-star" fill="#E3001B"/></svg>{{ l.title | escape }}</a>{%- endfor -%}
{%- else -%}
{%- assign cats = s.cats | newline_to_br | split: '<br />' -%}
{%- for c in cats -%}{%- assign c2 = c | strip -%}{%- if c2 != blank -%}<a class="cat foil" href="{{ routes.all_products_collection_url }}"><svg viewBox="0 0 24 24"><use href="#kh-star" fill="#E3001B"/></svg>{{ c2 | escape }}</a>{%- endif -%}{%- endfor -%}
{%- endif -%}
</div></div>
<section class="sec" id="shop">
<div class="wrap">
<div class="shop-head rv"><div class="sh-l">
<div class="kicker"><svg><use href="#kh-star" fill="#E3001B"/></svg>Shop</div>
<h2 class="h2"><span class="ln">{{ s.h1 | escape }}</span><span class="ln i"><span class="hl">{{ s.h2 | escape }}</span></span></h2>
<p class="lead"><span class="s">{{ s.lead1 | escape }}</span><span class="s">{{ s.lead2 | escape }}</span></p>
</div></div>
<div class="ttabs rv d1" role="tablist" aria-label="Product groups">
<button type="button" class="ttab" role="tab" aria-selected="true" data-tab="best"><span class="eyebrow"><svg><use href="#kh-star" fill="currentColor"/></svg>Most loved</span><span class="tt"><span>Best</span><span class="i">Sellers</span></span><span class="under"></span></button>
<button type="button" class="ttab" role="tab" aria-selected="false" data-tab="new"><span class="eyebrow"><svg><use href="#kh-star" fill="currentColor"/></svg>Just landed</span><span class="tt"><span>New</span><span class="i">This Week</span></span><span class="under"></span></button>
<button type="button" class="ttab" role="tab" aria-selected="false" data-tab="promo"><span class="eyebrow"><svg><use href="#kh-star" fill="currentColor"/></svg>Limited time</span><span class="tt"><span>On</span><span class="i">Promotion</span></span><span class="under"></span></button>
<button type="button" class="ttab" role="tab" aria-selected="false" data-tab="sets"><span class="eyebrow"><svg><use href="#kh-star" fill="currentColor"/></svg>Better together</span><span class="tt"><span>Bundles</span><span class="i">&amp; Gift Sets</span></span><span class="under"></span></button>
</div>
{%- assign keys = 'best,new,promo,sets' | split: ',' -%}
{%- for k in keys -%}
<div class="panel{% if forloop.first %} on{% endif %}" id="p-{{ k }}" role="tabpanel"><div class="grid4">
{%- for product in s[k] limit: 8 -%}
{%- assign sticker = '' -%}
{%- if k == 'best' -%}{%- if forloop.first or forloop.last -%}{%- assign sticker = s.sticker_best -%}{%- endif -%}{%- endif -%}
{%- if k == 'new' and forloop.first -%}{%- assign sticker = s.sticker_new -%}{%- endif -%}
{%- render 'kollab-home-card', product: product, tab: k, sticker: sticker -%}
{%- else -%}
{%- if request.design_mode -%}<p class="lead">왼쪽 설정에서 이 탭에 보여줄 상품을 골라주세요.</p>{%- endif -%}
{%- endfor -%}
</div></div>
{%- endfor -%}
</div>
</section>
{% schema %}
{"name":"KOLLAB Home · Shop","tag":"div","class":"khome","settings":[
{"type":"link_list","id":"cats_menu","label":"카테고리 띠 메뉴 (선택)","info":"메뉴를 고르면 각 카테고리가 그 링크로 연결됩니다."},
{"type":"textarea","id":"cats","label":"카테고리 띠 글자 (메뉴 미선택 시)","default":"Moisturizers\nCleansers & Exfoliators\nSerums & Essence\nMasks & Treatments\nEye Care\nPrimer & Makeup\nLip Care\nSPF\nBody Care\nBlotting Papers & Tools"},
{"type":"text","id":"h1","label":"제목 1줄","default":"Curated in Seoul."},
{"type":"text","id":"h2","label":"제목 2줄 (형광펜)","default":"Loved in LA."},
{"type":"text","id":"lead1","label":"설명 1","default":"Every product on the shelf has been tested by our team and our community first."},
{"type":"text","id":"lead2","label":"설명 2","default":"Prices update live from the store."},
{"type":"product_list","id":"best","label":"Best Sellers 상품","limit":8},
{"type":"product_list","id":"new","label":"New This Week 상품","limit":8},
{"type":"product_list","id":"promo","label":"On Promotion 상품","limit":8},
{"type":"product_list","id":"sets","label":"Bundles & Gift Sets 상품","limit":8},
{"type":"text","id":"sticker_best","label":"Best 스티커 (첫·마지막 상품)","default":"staff pick ✓"},
{"type":"text","id":"sticker_new","label":"New 스티커 (첫 상품)","default":"just in!"}
],"presets":[{"name":"KOLLAB Home · Shop"}]}
{% endschema %}
