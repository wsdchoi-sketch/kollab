{%- comment -%}
  NEST WIP — Recently Viewed
  Uses the theme's own 'section-header' snippet (same one "You may also
  like" uses) for exact typographic/rule parity, and mirrors the theme's
  'price' snippet class structure (price / price--on-sale / price-item--sale
  / price-item--regular) so sale pricing looks identical too.
  No app, no server calls — localStorage only.
{%- endcomment -%}

{%- render 'section-header',
  show_arrows: false,
  section: section
-%}

<div class="nwip-rv" id="nwipRecentlyViewed" hidden
  data-current-handle="{{ product.handle }}"
  data-current-vendor="{{ product.vendor | escape }}"
  data-current-title="{{ product.title | escape }}"
  data-current-url="{{ product.url }}"
  data-current-image="{{ product.featured_image | image_url: width: 600 }}"
  data-current-price="{{ product.selected_or_first_available_variant.price | money }}"
  data-current-compare="{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}{{ product.selected_or_first_available_variant.compare_at_price | money }}{% endif %}">
  <div class="nwip-rv-grid" id="nwipRecentlyViewedGrid"></div>
</div>

<style>
  .nwip-rv{ padding:0 22px 56px; }
  .nwip-rv-grid{ max-width:1100px; margin:0 auto; display:grid;
    grid-template-columns:repeat(4,1fr); gap:24px; }
  .nwip-rv-card{ text-decoration:none; color:inherit; display:block; }
  .nwip-rv-card img{ width:100%; aspect-ratio:1/1; object-fit:cover; background:#F4F5F3; }
  .nwip-rv-card .vd{ font-size:11px; letter-spacing:.06em; text-transform:uppercase;
    color:#5C6266; margin-top:14px; }
  .nwip-rv-card .nm{ font-size:14px; margin-top:4px; line-height:1.4; color:#16181A; }
  .nwip-rv-card .price{ margin-top:4px; }
  @media (max-width:700px){
    .nwip-rv-grid{ grid-template-columns:repeat(2,1fr); gap:16px; }
  }
</style>

<script>
  (function(){
    var KEY = 'nwip_recently_viewed';
    var MAX = 8;
    var root = document.getElementById('nwipRecentlyViewed');
    if (!root) return;

    var current = {
      handle: root.dataset.currentHandle,
      vendor: root.dataset.currentVendor,
      title: root.dataset.currentTitle,
      url: root.dataset.currentUrl,
      image: root.dataset.currentImage,
      price: root.dataset.currentPrice,
      compare: root.dataset.currentCompare
    };

    var list = [];
    try { list = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { list = []; }

    list = list.filter(function(p){ return p.handle !== current.handle; });
    if (current.handle) list.unshift(current);
    list = list.slice(0, MAX);
    try { localStorage.setItem(KEY, JSON.stringify(list)); } catch (e) {}

    var others = list.filter(function(p){ return p.handle !== current.handle; });
    if (others.length === 0) return;

    var grid = document.getElementById('nwipRecentlyViewedGrid');
    others.forEach(function(p){
      var a = document.createElement('a');
      a.className = 'nwip-rv-card';
      a.href = p.url;

      var priceHtml;
      if (p.compare) {
        priceHtml =
          '<div class="price price--on-sale"><dl>' +
          '<div class="price__sale"><dd><span class="price-item price-item--sale">' + p.price + '</span></dd>' +
          '<dd class="price__compare"><span class="price-item price-item--regular">' + p.compare + '</span></dd></div>' +
          '</dl></div>';
      } else {
        priceHtml =
          '<div class="price"><dl><div class="price__regular"><dd><span class="price-item price-item--regular">' + p.price + '</span></dd></div></dl></div>';
      }

      a.innerHTML =
        '<img src="' + p.image + '" alt="' + (p.title || '').replace(/"/g, '&quot;') + '" loading="lazy">' +
        '<div class="vd">' + (p.vendor || '') + '</div>' +
        '<div class="nm">' + p.title + '</div>' +
        priceHtml;
      grid.appendChild(a);
    });

    root.hidden = false;
  })();
</script>

{% schema %}
{
  "name": "NEST WIP Recently Viewed",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently viewed"
    },
    {
      "type": "select",
      "id": "section_header_type",
      "label": "Header layout",
      "default": "type1",
      "options": [
        { "value": "type1", "label": "Centered" },
        { "value": "type2", "label": "Left aligned" }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_border_top",
      "label": "Show divider",
      "default": true
    }
  ]
}
{% endschema %}
