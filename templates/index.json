}\n\n\/* CONTENT *\/\n\n.events-content{\n    display:none;\n    animation:fade 0.4s ease;\n}\n\n.events-content.active{\n    display:block;\n}\n\n@keyframes fade{\n    from{\n        opacity:0;\n        transform:translateY(10px);\n    }\n    to{\n        opacity:1;\n        transform:translateY(0);\n    }\n}\n\n\/* EVENT GRID *\/\n\n.events-grid{\n    display:grid;\n    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));\n    gap:22px;\n}\n\n\/* EVENT CARD *\/\n\n.event-card{\n    background:#fff;\n    border:1px solid #d8d8d8;\n    border-radius:18px;\n    overflow:hidden;\n    box-shadow:none;\n    transition:0.4s ease;\n    position:relative;\n    display:flex;\n    flex-direction:column;\n}\n\n.event-card:hover{\n    transform:translateY(-6px);\n}\n\n.event-image{\n    position:relative;\n    overflow:hidden;\n    height:210px;\n}\n\n.event-image img{\n    width:100%;\n    height:100%;\n    object-fit:cover;\n    transition:0.6s ease;\n}\n\n.event-card:hover img{\n    transform:scale(1.08);\n}\n\n.event-badge{\n    position:absolute;\n    top:14px;\n    left:14px;\n    background:#F12C18;\n    color:#fff;\n    padding:8px 12px;\n    border-radius:100px;\n    font-size:11px;\n    font-weight:700;\n    backdrop-filter:blur(10px);\n}\n\n.event-badge.workshop{\n    background:#000;\n}\n\n.event-body{\n    display:grid;\n    grid-template-columns:minmax(110px,30%) minmax(0,1fr);\n    gap:18px;\n    padding:20px;\n    align-items:start;\n    flex:1;\n}\n\n.event-meta-column{\n    display:flex;\n    flex-direction:column;\n    align-items:flex-start;\n    gap:12px;\n}\n\n.event-date-box{\n    width:64px;\n    height:64px;\n    border-radius:16px;\n    background:#000;\n    color:#fff;\n    display:flex;\n    flex-direction:column;\n    justify-content:center;\n    align-items:center;\n    font-weight:800;\n}\n\n.event-date-box span{\n    font-size:24px;\n    line-height:1;\n}\n\n.event-date-box small{\n    font-size:10px;\n    letter-spacing:0;\n}\n\n.event-det