s.\n        <\/p>\n\n        <div class=\"hero-buttons\">\n            <a href=\"#\">Explore Community<\/a>\n            <a href=\"#\">Join The Movement<\/a>\n        <\/div>\n\n    <\/div>\n\n    <div class=\"scroll-text\">\n        SCROLL DOWN &bull; SCROLL DOWN &bull; SCROLL DOWN\n    <\/div>\n\n<\/section>\n\n<link rel=\"preconnect\" href=\"https:\/\/fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https:\/\/fonts.gstatic.com\" crossorigin>\n<link href=\"https:\/\/fonts.googleapis.com\/css2?family=Bodoni+Moda:opsz,wght@6..96,700&family=Libre+Bodoni:wght@700&display=swap\" rel=\"stylesheet\">\n\n<style>\n\n*{\n    margin:0;\n    padding:0;\n    box-sizing:border-box;\n}\n\n.kollab-hero{\n    position:relative;\n    width:100%;\n    min-height:100vh;\n    overflow:hidden;\n    background:#000;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    padding:120px 5%;\n    isolation:isolate;\n}\n\n\/* DARK CENTER OVERLAY *\/\n\n.kollab-hero::before{\n    content:\"\";\n    position:absolute;\n    inset:0;\n\n    background:\n    radial-gradient(\n        circle at center,\n        rgba(0,0,0,.88) 0%,\n        rgba(0,0,0,.68) 35%,\n        rgba(0,0,0,.28) 60%,\n        transparent 80%\n    );\n\n    z-index:2;\n}\n\n\/* BACKGROUND *\/\n\n.gradient-bg{\n    position:absolute;\n    inset:0;\n\n    background:\n    radial-gradient(circle at top left, rgba(241,44,24,.28), transparent 35%),\n    radial-gradient(circle at bottom right, rgba(255,255,255,.12), transparent 35%),\n    radial-gradient(circle at center, rgba(241,44,24,.08), transparent 40%);\n\n    z-index:-3;\n}\n\n.noise{\n    position:absolute;\n    inset:0;\n\n    background-image:url(\"https:\/\/grainy-gradients.vercel.app\/noise.svg\");\n\n    opacity:.08;\n\n    z-index:-2;\n}\n\n\/* FLOATING IMAGES *\/\n\n.floating-images{\n    position:absolute;\n    inset:0;\n    z-index:1;\n}\n\n.float-card{\n    position:absolute;\n    overflow:hidden;\n\n    border-radius:42px;\n\n    background:#000;\n\n    box-shadow:\n    0 30px 80px rgba(0,0,0,.5),\n    inset 0 0 0 2px rgba(241,44,24,.45);\n\n    transition:transform .15s linear;\n\n    will-change:transform;\n}\n\n.float-card::after{\n    content:\"\";\n    position:absolute;\n    inset:0;\n\n    background:\n    linear-gradient(\n        to top,\n        rgba(0,0,0,.45),\n        rgba(0,0,0,.05)\n    );\n}\n\n.float-card img{\n    width:100%;\n    height:100%;\n    object-fit:cover;\n\n    transform:scale(1.12);\n\n    transition:transform .5s ease;\n}\n\n.float-card:hover img{\n    transform:scale(1.18);\n}\n\n\/* BIGGER IMAGE POSITIONS (+30%) *\/\n\n.card-1{\n    width:325px;\n    height:455px;\n\n    top:4%;\n    left:2%;\n\n    transform:rotate(-10deg);\n}\n\n.card-2{\n    width:416px;\n    height:312px;\n\n    top:3%;\n    right:4%;\n\n    transform:rotate(8deg);\n}\n\n.card-3{\n    width:312px;\n    height:390px;\n\n    bottom:4%;\n    left:6%;\n\n    transform:rotate(8deg);\n}\n\n.card-4{\n    width:416px;\n    height:286px;\n\n    bottom:4%;\n    right:5%;\n\n    transform:rotate(-7deg);\n}\n\n.card-5{\n    width:312px;\n    height:364px;\n\n    top:50%;\n    left:50%;\n\n    transform:translate(-50%,-50%) rotate(-2deg);\n\n    z-index:3;\n}\n\n\/* CONTENT *\/\n\n.hero-content{\n    position:relative;\n    z-index:5;\n\n    width:min(820px,100%);\n\n    text-align:center;\n}\n\n.mini-tag{\n    display:inline-flex;\n\n    padding:12px 22px;\n\n    border-radius:100px;\n\n    background:rgba(255,255,255,.08);\n\n    backdrop-filter:blur(20px);\n\n    border:1px solid rgba(241,44,24,.55);\n\n    color:#fff;\n\n    letter-spacing:0;\n\n    font-size:11px;\n\n    margin-bottom:30px;\n}\n\n\/* TITLE *\/\n\n.kollab-hero .hero-content h1{\n    font-size:clamp(75px, 13vw, 180px);\n\n    line-height:.9;\n\n    font-family:'Libre Bodoni', 'Bodoni Moda', Didot, 'Bodoni 72', 'Times New Roman', serif !important;\n\n    font-weight:700;\n\n    color:#fff;\n\n    letter-spacing:.01em;\n\n    margin-bottom:28px;\n\n    text-transform:uppercase;\n\n    text-shadow:\n    0 10px 40px rgba(0,0,0,.35);\n}\n\n.kollab-hero .hero-content h1 span{\n    font-family:'Libre Bodoni', 'Bodoni Moda', Didot, 'Bodoni 72', 'Times New Roman', serif !important;\n    font-weight:700;\n\n    background:\n    linear-gradient(\n        90deg,\n        #ffffff,\n        #F12C18,\n        #ffffff\n    );\n\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n}\n\n\/* DESCRIPTION *\/\n\n.hero-content p{\n    width:min(700px,100%);\n\n    margin:auto;\n\n    color:rgba(255,255,255,.86);\n\n    font-size:clamp(16px, 1.15vw, 20px);\n\n    line-height:1.9;\n\n    font-weight:300;\n\n    letter-spacing:0;\n\n    text-shadow:\n    0 2px 25px rgba(0,0,0,.55);\n\n    position:relative;\n\n    padding:0 10px;\n\n    backdrop-filter:blur(2px);\n\n    animation:textFloat 5s ease-in-out infinite;\n}\n\n\/* BUTTONS *\/\n\n.hero-buttons{\n    margin-top:45px;\n\n    display:flex;\n\n    justify-content:center;\n\n    gap:18px;\n\n    flex-wrap:wrap;\n}\n\n.hero-buttons a{\n    text-decoration:none;\n\n    padding:18px 34px;\n\n    border-radius:100px;\n\n    font-size:14px;\n\n    letter-spacing:0;\n\n    transition:.35s ease;\n\n    backdrop-filter:blur(20px);\n}\n\n.hero-buttons a:first-child{\n    background:#F12C18;\n\n    color:#fff;\n\n    font-weight:700;\n\n    box-shadow:\n    0 10px 30px rgba(241,44,24,.35);\n}\n\n.hero-buttons a:last-child{\n    color:#fff;\n\n    border:1px solid #F12C18;\n\n    background:rgba(0,0,0,.65);\n}\n\n.hero-buttons a:hover{\n    transform:translateY(-6px);\n    box-shadow:0 14px 36px rgba(241,44,24,.38);\n}\n\n\/* SCROLL TEXT *\/\n\n.scroll-text{\n    position:absolute;\n\n    bottom:28px;\n    left:50%;\n\n    transform:translateX(-50%);\n\n    color:rgba(255,255,255,.42);\n\n    letter-spacing:0;\n\n    font-size:11px;\n\n    white-space:nowrap;\n\n    animation:floatText 4s ease-in-out infinite;\n\n    z-index:10;\n}\n\n\/* ANIMATIONS *\/\n\n@keyframes floatText{\n\n    0%{\n        transform:translateX(-50%) translateY(0px);\n    }\n\n    50%{\n        transform:translateX(-50%) translateY(-6px);\n    }\n\n    100%{\n        transform:translateX(-50%) translateY(0px);\n    }\n\n}\n\n@keyframes textFloat{\n\n    0%{\n        transform:translateY(0px);\n    }\n\n    50%{\n        transform:translateY(-6px);\n    }\n\n    100%{\n        transform:translateY(0px);\n    }\n\n}\n\n\/* MOBILE *\/\n\n@media(max-width:768px){\n\n    .kollab-hero{\n        padding:120px 20px;\n    }\n\n    .float-card{\n        opacity:.45;\n    }\n\n    .card-1{\n        width:180px;\n        height:240px;\n    }\n\n    .card-2{\n        width:220px;\n        height:160px;\n    }\n\n    .card-3{\n        width:180px;\n        height:230px;\n    }\n\n    .card-4{\n        width:220px;\n        height:160px;\n    }\n\n    .card-5{\n        width:190px;\n        height:230px;\n    }\n\n    .hero-content h1{\n        letter-spacing:0;\n    }\n\n    .hero-content p{\n        line-height:1.7;\n        font-size:15px;\n    }\n\n    .hero-buttons{\n        gap:12px;\n    }\n\n    .hero-buttons a{\n        width:100%;\n        text-align:center;\n    }\n\n}\n\n<\/style>\n\n<script>\n\nconst cards = document.querySelectorAll('.float-card');\n\nwindow.addEventListener('mousemove', (e) => {\n\n    const x = (window.innerWidth \/ 2 - e.clientX);\n    const y = (window.innerHeight \/ 2 - e.clientY);\n\n    cards.forEach(card => {\n\n        const speed = card.getAttribute('data-speed');\n\n        const moveX = (x * speed) \/ 250;\n        const moveY = (y * speed) \/ 250;\n\n        card.style.transform = `\n            translate(${moveX}px, ${moveY}px)\n            scale(1.03)\n        `;\n\n    });\n\n});\n\n\/* FLOATING CARD ANIMATION *\/\n\ncards.forEach((card, index) => {\n\n    card.animate([\n\n        {\n            transform:'translateY(0px)'\n        },\n\n        {\n            transform:'translateY(-20px)'\n        },\n\n        {\n            transform:'translateY(0px)'\n        }\n\n    ],{\n\n        duration:4500 + (index * 900),\n\n        iterations:Infinity\n\n    });\n\n});\n\n<\/script>"}},"custom_liquid_eWHRwW":{"type":"custom-liquid","disabled":true,"name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<section class=\"events-section\">\n\n    <div class=\"events-header\">\n        <p class=\"events-subtitle\">WHAT'S HAPPENING<\/p>\n        <h2>Upcoming <span>Events<\/span><\/h2>\n\n    <\/div>\n\n    <div class=\"events-content active\" id=\"cards\">\n\n        <div class=\"events-grid\">\n\n            <!-- EVENT 1 -->\n            <div class=\"event-card\">\n\n                <div class=\"event-image\">\n                    <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0588\/2088\/6577\/files\/1773540096487-e286cd20.webp?v=1773976809\" alt=\"\">\n\n                    <div class=\"event-badge\">\n                        Featured\n                    <\/div>\n                <\/div>\n\n                <div class=\"event-body\">\n\n                    <div class=\"event-meta-column\">\n                        <div class=\"event-date-box\">\n                            <span>27<\/span>\n                            <small>MAR<\/small>\n                        <\/div>\n                        <div class=\"event-meta\">\n                            <span>10:00 AM<\/span>\n                            <span>Event Location<\/span>\n                            <span>FREE<\/span>\n                        <\/div>\n                    <\/div>\n\n                    <div class=\"event-details\">\n\n                        <h3>KOLLAB Grand Opening<\/h3>\n\n                        <p>\n                            Celebrate the official launch of KOLLAB with an immersive\n                            experience featuring lifestyle products, activities,\n                            exclusive freebies, and networking opportunities.\n                        <\/p