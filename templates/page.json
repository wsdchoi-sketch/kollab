}\n\n    .kollab-roots__image img {\n      height: 320px;\n      min-height: 320px;\n    }\n\n    .kollab-roots__content {\n      padding: 42px 20px 50px;\n    }\n\n    .kollab-roots .kollab-roots__heading {\n      font-size: clamp(38px, 11vw, 48px) !important;\n    }\n  }\n<\/style>\n\n<section class=\"kollab-roots\">\n  <div class=\"kollab-roots__wrapper\">\n\n    <div class=\"kollab-roots__image\">\n      <img\n        src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0588\/2088\/6577\/files\/KOLLAB_SEOUL_STORE.png?v=1781769544\"\n        alt=\"KOLLAB Korea store in Seongsu, Seoul\"\n        loading=\"lazy\"\n        width=\"1200\"\n        height=\"900\"\n      >\n    <\/div>\n\n    <div class=\"kollab-roots__content\">\n      <div class=\"kollab-roots__content-inner\">\n\n        <h2 class=\"kollab-roots__heading\">\n          Our Roots in Seoul\n        <\/h2>\n\n        <div class=\"kollab-roots__divider\"><\/div>\n\n        <div class=\"kollab-roots__text\">\n          <p>\n            Inspired by KOLLAB Korea in Seongsu, Seoul—one of Korea’s most\n            vibrant creative districts—KOLLAB LA carries forward a spirit of\n            innovation, culture, and community.\n          <\/p>\n\n          <p>\n            Building on the foundation established in Seoul, KOLLAB LA bridges\n            Korean brands and experiences with the U.S. market, creating\n            meaningful connections between two globally influential cities.\n          <\/p>\n        <\/div>\n\n      <\/div>\n    <\/div>\n\n  <\/div>\n<\/section>"}},"custom_liquid_FP9B4Q":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n  @import url(\"https:\/\/fonts.googleapis.com\/css2?family=Instrument+Serif:ital@0;1&display=swap\");\n\n  .kollab-marquee,\n  .kollab-marquee * {\n    box-sizing: border-box;\n  }\n\n  .kollab-marquee {\n    --kollab-marquee-bg: #ed1c24;\n    --kollab-marquee-color: #ffffff;\n    --kollab-marquee-speed: 24s;\n\n