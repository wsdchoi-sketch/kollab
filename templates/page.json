 position: relative;\n    z-index: 2;\n\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: clamp(25px, 4vw, 70px);\n  }\n\n  .kollab-seoul-la__card {\n    position: relative;\n    width: 100%;\n    height: clamp(280px, 25vw, 440px);\n    margin: 0;\n    overflow: hidden;\n    background: #222222;\n  }\n\n  .kollab-seoul-la__card img {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n\n    transition:\n      transform 0.65s ease,\n      filter 0.65s ease;\n  }\n\n  .kollab-seoul-la__card:nth-child(1) img {\n    object-position: center;\n  }\n\n  .kollab-seoul-la__card:nth-child(2) img {\n    object-position: center;\n  }\n\n  .kollab-seoul-la__card:nth-child(3) img {\n    object-position: 50% 40%;\n  }\n\n  .kollab-seoul-la__card::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n\n    background: linear-gradient(\n      180deg,\n      transparent 55%,\n      rgba(0, 0, 0, 0.12) 100%\n    );\n  }\n\n  .kollab-seoul-la__card:hover img {\n    transform: scale(1.045);\n    filter: brightness(1.04);\n  }\n\n  \/* ========================================\n     LARGE TABLET\n  ======================================== *\/\n\n  @media screen and (max-width: 1200px) {\n    .kollab-seoul-la__top {\n      grid-template-columns: minmax(0, 1fr) minmax(400px, 0.9fr);\n      gap: 42px;\n    }\n\n    .kollab-seoul-la .kollab-seoul-la__heading {\n      font-size: clamp(39px, 4vw, 55px) !important;\n    }\n  }\n\n  \/* ========================================\n     TABLET\n  ======================================== *\/\n\n  @media screen and (max-width: 1000px) {\n    .kollab-seoul-la__container {\n      width: min(calc(100% - 40px), 1500px);\n    }\n\n    .kollab-seoul-la__top {\n      grid-template-columns: 1fr;\n      gap: 40px;\n    }\n\n    .kollab-seoul-la__media {\n      min-height: 500px;\n    }\n\n    .kollab-seoul-la__content {\n      max-width: 780px;\n    }\n\n    .kollab-seoul-la .kollab-seoul-la__heading {\n      font-size: clamp(44px, 7vw, 68px) !important;\n    }\n\n    .kollab-seoul-la__cards {\n      gap: 28px;\n    }\n\n    .kollab-seoul-la__card {\n      height: 330px;\n    }\n  }\n\n  \/* ========================================\n     MOBILE\n  ======================================== *\/\n\n  @media screen and (max-width: 767px) {\n    .kollab-seoul-la {\n      padding: 35px 0 45px;\n      background-position: center top;\n    }\n\n    .kollab-seoul-la__container {\n      width: min(calc(100% - 28px), 1500px);\n    }\n\n    .kollab-seoul-la__top {\n      gap: 34px;\n    }\n\n    .kollab-seoul-la__media {\n      min-height: 360px;\n    }\n\n    .kollab-seoul-la__video {\n      object-position: center;\n    }\n\n    .kollab-seoul-la .kollab-seoul-la__heading {\n      font-size: clamp(31px, 9vw, 48px) !important;\n      line-height: 1 !important;\n      letter-spacing: -0.02em !important;\n      white-space: nowrap !important;\n    }\n\n    .kollab-seoul-la__divider {\n      margin: 23px 0;\n    }\n\n    .kollab-seoul-la__description {\n      font-size: 16px;\n      line-height: 1.48;\n    }\n\n    .kollab-seoul-la__film {\n      margin-top: 44px;\n      padding: 28px 16px 30px;\n    }\n\n    .kollab-seoul-la__film-labels {\n      display: none;\n    }\n\n    .kollab-seoul-la__cards {\n      grid-template-columns: 1fr;\n      gap: 20px;\n    }\n\n    .kollab-seoul-la__card {\n      height: auto;\n      aspect-ratio: 1.18 \/ 1;\n    }\n\n    .kollab-seoul-la__card:nth-child(3) img {\n      object-position: 50% 38%;\n    }\n  }\n\n  \/* ========================================\n     SMALL MOBILE\n  ======================================== *\/\n\n  @media screen and (max-width: 480px) {\n    .kollab-seoul-la__media {\n      min-height: 300px;\n    }\n\n    .kollab-seoul-la .kollab-seoul-la__heading {\n      font-size: clamp(27px, 8.5vw, 38px) !important;\n      letter-spacing: -0.015em !important;\n    }\n  }\n\n  @media screen and (max-width: 360px) {\n    .kollab-seoul-la .kollab-seoul-la__heading {\n      font-size: 27px !important;\n    }\n  }\n\n  \/* ========================================\n     REDUCED MOTION ACCESSIBILITY\n  ======================================== *\/\n\n  @media (prefers-reduced-motion: reduce) {\n    .kollab-seoul-la__video,\n    .kollab-seoul-la__card img {\n      transition: none;\n    }\n\n    .kollab-seoul-la__media:hover .kollab-seoul-la__video,\n    .kollab-seoul-la__card:hover img {\n      transform: none;\n    }\n  }\n<\/style>\n\n<section class=\"kollab-seoul-la\">\n  <div class=\"kollab-seoul-la__container\">\n\n    <div class=\"kollab-seoul-la__top\">\n\n      <div class=\"kollab-seoul-la__media\">\n\n        <video\n          class=\"kollab-seoul-la__video\"\n          autoplay\n          muted\n          loop\n          playsinline\n          preload=\"auto\"\n          disablepictureinpicture\n          controlslist=\"nodownload noplaybackrate noremoteplayback\"\n          aria-label=\"Kollab LA brand and community video\"\n        >\n          <source\n            src=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/e7c7d691bdf0473bb3c7615ea9738bc0.mp4\"\n            type=\"video\/mp4\"\n          >\n\n          Your browser does not support HTML5 video.\n        <\/video>\n\n      <\/div>\n\n      <div class=\"kollab-seoul-la__content\">\n\n        <h2 class=\"kollab-seoul-la__heading\">\n          Where Seoul Meets LA\n        <\/h2>\n\n        <div class=\"kollab-seoul-la__divider\"><\/div>\n\n        <div class=\"kollab-seoul-la__description\">\n\n          <p>\n            <strong>KOLLAB LA<\/strong> is a cross-functional retail and event\n            platform in Downtown Los Angeles that connects Korean brands with\n            consumers, creators, and communities through curated retail\n            experiences, brand activations, and cultural events.\n          <\/p>\n\n          <p>\n            As a dynamic hub where Seoul meets LA, KOLLAB showcases the best of\n            K-beauty, K-food, wellness, fashion, and lifestyle, helping brands\n            engage with the U.S. market while creating meaningful opportunities\n            for discovery, connection, and community.\n          <\/p>\n\n        <\/div>\n\n      <\/div>\n\n    <\/div>\n\n    <div class=\"kollab-seoul-la__film\">\n\n      <div\n        class=\"kollab-seoul-la__film-labels\"\n        aria-hidden=\"true\"\n      >\n        <span>\n          <i>400TM<\/i>\n          <i>46<\/i>\n        <\/span>\n\n        <span>\n          <i>400TM<\/i>\n          <i>47<\/i>\n        <\/span>\n\n        <span>\n          <i>400TM<\/i>\n          <i>48<\/i>\n        <\/span>\n      <\/div>\n\n      <div class=\"kollab-seoul-la__cards\">\n\n        <figure class=\"kollab-seoul-la__card\">\n          <img\n            src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0588\/2088\/6577\/files\/Untitled-2.png?v=1781612887\"\n            alt=\"Kollab branded retail products\"\n            loading=\"lazy\"\n            width=\"440\"\n            height=\"376\"\n          >\n        <\/figure>\n\n        <figure class=\"kollab-seoul-la__card\">\n          <img\n            src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0588\/2088\/6577\/files\/Untitled-1.png?v=1781612886\"\n            alt=\"Kollab community gathering\"\n            loading=\"lazy\"\n            width=\"440\"\n            height=\"375\"\n          >\n        <\/figure>\n\n        <figure class=\"kollab-seoul-la__card\">\n          <img\n            src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0588\/2088\/6577\/files\/De_maf_workshop_3.jpg?v=1781612889\"\n            alt=\"Kollab beauty and skincare workshop\"\n            loading=\"lazy\"\n            width=\"1857\"\n            height=\"2600\"\n          >\n        <\/figure>\n\n      <\/div>\n\n    <\/div>\n\n  <\/div>\n<\/section>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const videos = document.querySelectorAll(\".kollab-seoul-la__video\");\n\n    videos.forEach(function (video) {\n      video.muted = true;\n      video.defaultMuted = true;\n\n      const playVideo = function () {\n        const playPromise = video.play();\n\n        if (playPromise !== undefined) {\n          playPromise.catch(function () {\n            video.muted = true;\n            video.play().catch(function () {\n              \/* Autoplay remains blocked by the browser. *\/\n            });\n          });\n        }\n      };\n\n      if (video.readyState >= 2) {\n        playVideo();\n      } else {\n        video.addEventListener(\"canplay\", playVideo, { once: true });\n      }\n\n      document.addEventListener(\"visibilitychange\", function () {\n        if (!document.hidden && video.paused) {\n          playVideo();\n        }\n      });\n    });\n  });\n<\/script>"}},"custom_liquid_RW4BcU":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n  @import url(\"https:\/\/fonts.googleapis.com\/css2?family=Instrument+Serif:ital@0;1&display=swap\");\n\n  .kollab-mission,\n  .kollab-mission * {\n    box-sizing: border-box;\n  }\n\n  .kollab-mission {\n    position: relative;\n    width: 100%;\n    min-height: 520px;\n    overflow: hidden;\n    isolation: isolate;\n    background:\n      radial-gradient(\n        circle at 92% 55%,\n        rgba(255, 71, 40, 0.98) 0%,\n        rgba(255, 29, 22, 0.96) 24%,\n        rgba(191, 0, 12, 0.94) 47%,\n        rgba(78, 0, 7, 0.98) 73%,\n        #160707 100%\n      );\n  }\n\n  .kollab-mission::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    z-index: -2;\n    pointer-events: none;\n    background:\n      linear-gradient(\n        90deg,\n        rgba(0, 0, 0, 0.5) 0%,\n        rgba(0, 0, 0, 0.18) 44%,\n        rgba(255, 0, 0, 0.02) 72%,\n        rgba(255, 76, 40, 0.2) 100%\n      );\n  }\n\n  .kollab-mission::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    z-index: -1;\n    pointer-events: none;\n    opacity: 0.16;\n    background-image:\n      radial-gradient(\n        circle at 20% 30%,\n        rgba(255, 255, 255, 0.22) 0 1px,\n        transparent 1.5px\n      ),\n      radial-gradient(\n        circle at 70% 65%,\n        rgba(0, 0, 0, 0.35) 0 1px,\n        transparent 1.5px\n      );\n    background-size: 13px 13px, 17px 17px;\n  }\n\n  .kollab-mission__container {\n    position: relative;\n    z-index: 2;\n    display: grid;\n    grid-template-columns: minmax(350px, 0.9fr) minmax(480px, 1.1fr);\n    align-items: center;\n    gap: clamp(30px, 5vw, 90px);\n    width: min(calc(100% - 80px), 1450px);\n    min-height: 520px;\n    margin: 0 auto;\n    padding: clamp(55px, 7vw, 100px) 0;\n  }\n\n  \/* ========================================\n     LEFT CONTENT\n  ======================================== *\/\n\n  .kollab-mission__content {\n    position: relative;\n    z-index: 5;\n    max-width: 590px;\n    color: #ffffff;\n  }\n\n  .kollab-mission__eyebrow {\n    margin: 0;\n    color: #ffffff;\n    font-family: \"Instrument Serif\", Georgia, serif;\n    font-size: clamp(43px, 4.8vw, 72px);\n    font-style: normal;\n    font-weight: 400;\n    line-height: 1;\n    letter-spacing: -0.025em;\n  }\n\n  .kollab-mission__line {\n    width: 105px;\n    height: 2px;\n    margin: 28px 0 52px;\n    background: rgba(255, 255, 255, 0.92);\n  }\n\n  .kollab-mission__title {\n    margin: 0 0 24px;\n    color: #ffffff;\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: clamp(29px, 3vw, 45px);\n    font-style: normal;\n    font-weight: 700;\n    line-height: 1.1;\n    letter-spacing: -0.025em;\n  }\n\n  .kollab-mission__description {\n    max-width: 530px;\n    margin: 0;\n    color: rgba(255, 255, 255, 0.96);\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: clamp(16px, 1.35vw, 21px);\n    font-style: normal;\n    font-weight: 600;\n    line-height: 1.45;\n  }\n\n  \/* ========================================\n     RIGHT IMAGE\n  ======================================== *\/\n\n  .kollab-mission__visual {\n    position: relative;\n    width: 100%;\n    min-height: 430px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .kollab-mission__image {\n    width: min(100%, 620px);\n    margin: 0;\n  }\n\n  .kollab-mission__image img {\n    display: block;\n    width: 100%;\n    height: auto;\n    object-fit: cover;\n  }\n\n  \/* ========================================\n     LAPTOP\n  ======================================== *\/\n\n  @media screen and (max-width: 1200px) {\n    .kollab-mission__container {\n      width: min(calc(100% - 60px), 1450px);\n      grid-template-columns: minmax(330px, 0.9fr) minmax(430px, 1.1fr);\n    }\n\n    .kollab-mission__visual {\n      min-height: 400px;\n    }\n\n    .kollab-mission__line {\n      margin-bottom: 42px;\n    }\n  }\n\n  \/* ========================================\n     TABLET\n  ======================================== *\/\n\n  @media screen and (max-width: 900px) {\n    .kollab-mission__container {\n      grid-template-columns: 1fr;\n      gap: 45px;\n      width: min(calc(100% - 40px), 760px);\n      padding: 65px 0 75px;\n    }\n\n    .kollab-mission__content {\n      max-width: 650px;\n    }\n\n    .kollab-mission__visual {\n      min-height: auto;\n    }\n  }\n\n  \/* ========================================\n     MOBILE\n  ======================================== *\/\n\n  @media screen and (max-width: 600px) {\n    .kollab-mission {\n      min-height: auto;\n    }\n\n    .kollab-mission__container {\n      width: min(calc(100% - 28px), 560px);\n      padding: 50px 0 58px;\n      gap: 40px;\n    }\n\n    .kollab-mission__eyebrow {\n      font-size: clamp(42px, 13vw, 58px);\n    }\n\n    .kollab-mission__line {\n      width: 95px;\n      margin: 24px 0 38px;\n    }\n\n    .kollab-mission__title {\n      font-size: clamp(27px, 8vw, 36px);\n      line-height: 1.16;\n    }\n\n    .kollab-mission__description {\n      font-size: 16px;\n      line-height: 1.5;\n    }\n\n    .kollab-mission__visual {\n      min-height: auto;\n    }\n\n  }\n\n  \/* ========================================\n     SMALL MOBILE\n  ======================================== *\/\n\n  @media screen and (max-width: 380px) {\n    .kollab-mission__visual {\n      min-height: auto;\n    }\n  }\n<\/style>\n\n<section class=\"kollab-mission\">\n  <div class=\"kollab-mission__container\">\n\n    <div class=\"kollab-mission__content\">\n\n      <h2 class=\"kollab-mission__eyebrow\">\n        Our Mission\n      <\/h2>\n\n      <div class=\"kollab-mission__line\"><\/div>\n\n      <h3 class=\"kollab-mission__title\">\n        Connect. Engage. Belong.\n      <\/h3>\n\n      <p class=\"kollab-mission__description\">\n        Building meaningful connections between Korean brands, creators, and\n        communities through immersive experiences that inspire discovery and\n        cultural exchange.\n      <\/p>\n\n    <\/div>\n\n    <div class=\"kollab-mission__visual\">\n\n      <figure class=\"kollab-mission__image\">\n        <img\n          src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0588\/2088\/6577\/files\/OUR_MISSION_IMAGE.png?v=1781769543\"\n          alt=\"Kollab mission\"\n          loading=\"lazy\"\n          width=\"1240\"\n          height=\"920\"\n        >\n      <\/figure>\n\n    <\/div>\n\n  <\/div>\n<\/section>"}},"custom_liquid_FkPRLB":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n  @import url(\"https:\/\/fonts.googleapis.com\/css2?family=Instrument+Serif:ital@0;1&display=swap\");\n\n  .kollab-roots,\n  .kollab-roots * {\n    box-sizing: border-box;\n  }\n\n  .kollab-roots {\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n    background: #ffffff;\n  }\n\n  .kollab-roots__wrapper {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    width: 100%;\n    min-height: clamp(480px, 43vw, 720px);\n  }\n\n  \/* ========================================\n     LEFT IMAGE\n  ======================================== *\/\n\n  .kollab-roots__image {\n    position: relative;\n    width: 100%;\n    min-width: 0;\n    overflow: hidden;\n    background: #d5003f;\n  }\n\n  .kollab-roots__image img {\n    width: 100%;\n    height: 100%;\n    min-height: clamp(480px, 43vw, 720px);\n    display: block;\n    object-fit: cover;\n    object-position: center;\n  }\n\n  \/* ========================================\n     RIGHT CONTENT\n  ======================================== *\/\n\n  .kollab-roots__content {\n    display: flex;\n    align-items: center;\n    width: 100%;\n    min-width: 0;\n    padding:\n      clamp(50px, 6vw, 100px)\n      clamp(45px, 7vw, 120px);\n\n    background: #ffffff;\n  }\n\n  .kollab-roots__content-inner {\n    width: 100%;\n    max-width: 680px;\n  }\n\n  .kollab-roots .kollab-roots__heading {\n    margin: 0 !important;\n    color: #ed1c24 !important;\n\n    font-family:\n      \"Instrument Serif\",\n      Georgia,\n      \"Times New Roman\",\n      serif !important;\n\n    font-size: clamp(48px, 4.3vw, 76px) !important;\n    font-style: normal !important;\n    font-weight: 400 !important;\n    font-synthesis: none !important;\n    line-height: 1 !important;\n    letter-spacing: -0.025em !important;\n    text-transform: none !important;\n  }\n\n  .kollab-roots__divider {\n    width: clamp(105px, 10vw, 165px);\n    height: 2px;\n    margin: clamp(26px, 3vw, 42px) 0;\n    background: #ed1c24;\n  }\n\n  .kollab-roots__text {\n    color: #111111;\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: clamp(16px, 1.35vw, 22px);\n    font-style: normal;\n    font-weight: 400;\n    line-height: 1.4;\n  }\n\n  .kollab-roots__text p {\n    margin: 0;\n  }\n\n  .kollab-roots__text p + p {\n    margin-top: clamp(24px, 3vw, 42px);\n  }\n\n  \/* ========================================\n     LARGE SCREEN\n  ==================