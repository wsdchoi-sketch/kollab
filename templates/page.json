{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"padding_top":"no-indent","padding_bottom":"no-indent"}},"custom_liquid_bhUXbc":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n  @import url(\"https:\/\/fonts.googleapis.com\/css2?family=Instrument+Serif:ital@0;1&display=swap\");\n\n  .kollab-seoul-la,\n  .kollab-seoul-la * {\n    box-sizing: border-box;\n  }\n\n  .kollab-seoul-la {\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n    padding: clamp(45px, 6vw, 90px) 0;\n\n    background-image:\n      linear-gradient(\n        180deg,\n        rgba(255, 255, 255, 0.01) 0%,\n        rgba(255, 255, 255, 0.01) 62%,\n        rgba(0, 0, 0, 0.08) 100%\n      ),\n      url(\"https:\/\/cdn.shopify.com\/s\/files\/1\/0588\/2088\/6577\/files\/image.png?v=1781613216\");\n\n    background-repeat: no-repeat;\n    background-position: center;\n    background-size: cover;\n  }\n\n  .kollab-seoul-la__container {\n    width: min(calc(100% - 64px), 1500px);\n    margin: 0 auto;\n  }\n\n  \/* ========================================\n     TOP SECTION\n  ======================================== *\/\n\n  .kollab-seoul-la__top {\n    display: grid;\n    grid-template-columns: minmax(0, 1.08fr) minmax(430px, 0.92fr);\n    align-items: center;\n    gap: clamp(45px, 6vw, 95px);\n  }\n\n  \/* ========================================\n     TOP VIDEO AREA\n  ======================================== *\/\n\n  .kollab-seoul-la__media {\n    position: relative;\n    width: 100%;\n    min-height: clamp(360px, 34vw, 570px);\n    overflow: hidden;\n    background: #161616;\n  }\n\n  .kollab-seoul-la__video {\n    position: absolute;\n    inset: 0;\n\n    width: 100%;\n    height: 100%;\n\n    display: block;\n    object-fit: cover;\n    object-position: center;\n\n    transform: scale(1.001);\n\n    transition:\n      transform 0.7s ease,\n      filter 0.7s ease;\n  }\n\n  .kollab-seoul-la__media::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    z-index: 2;\n    pointer-events: none;\n\n    background: linear-gradient(\n      180deg,\n      rgba(0, 0, 0, 0.02) 0%,\n      rgba(0, 0, 0, 0.14) 100%\n    );\n  }\n\n  .kollab-seoul-la__media:hover .kollab-seoul-la__video {\n    transform: scale(1.04);\n    filter: brightness(1.03);\n  }\n\n  \/* ========================================\n     TEXT CONTENT\n  ======================================== *\/\n\n  .kollab-seoul-la__content {\n    position: relative;\n    width: 100%;\n    min-width: 0;\n  }\n\n  .kollab-seoul-la .kollab-seoul-la__heading {\n    display: block;\n    width: max-content;\n    max-width: 100%;\n    margin: 0 !important;\n\n    color: #ed1c24 !important;\n\n    font-family: \"Instrument Serif\", Georgia, \"Times New Roman\", serif !important;\n    font-size: clamp(42px, 4.2vw, 72px) !important;\n    font-style: normal !important;\n    font-weight: 400 !important;\n    font-stretch: normal !important;\n    font-synthesis: none !important;\n    font-variation-settings: normal !important;\n\n    line-height: 0.98 !important;\n    letter-spacing: -0.025em !important;\n    text-transform: none !important;\n    text-decoration: none !important;\n\n    white-space: nowrap !important;\n  }\n\n  .kollab-seoul-la__divider {\n    width: clamp(100px, 10vw, 170px);\n    height: 2px;\n    margin: clamp(28px, 3vw, 40px) 0;\n    background: #252525;\n  }\n\n  .kollab-seoul-la__description {\n    color: #111111;\n\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: clamp(16px, 1.25vw, 21px);\n    font-style: normal;\n    font-weight: 400;\n    line-height: 1.37;\n  }\n\n  .kollab-seoul-la__description p {\n    margin: 0;\n  }\n\n  .kollab-seoul-la__description p + p {\n    margin-top: clamp(20px, 2vw, 30px);\n  }\n\n  .kollab-seoul-la__description strong {\n    font-weight: 700;\n  }\n\n  \/* ========================================\n     BOTTOM FILM SECTION\n  ======================